      },
      "stepType": "FanOut",
      "nodeName": "FanOutShipments",
      "positionX": 1760,
      "positionY": 0,
      "endpointUrl": "",
      "httpMethod": "GET",
      "urlMode": "Manual",
      "authType": "None",
      "stepConfig": {
        "$json": {
          "fanOut": {
            "arrayPath": "flowState.LatestShipmentPerOrder.shipments",
