{
  "name": "Business Central to Shopify - Order Shipment",
  "description": "Reads posted sales shipments from Business Central through the Fintegrator BC Connector extension, delta-filtered by the monotonic entry number kept in persisted state, then collapses the batch to one entry per Shopify order (quantities summed, newest tracking number wins) and fans out one child transaction per order. Each child looks up Shopify's open fulfillment orders and marks them shipped with fulfillmentCreateV2 (carrier + tracking), then flags the Business Central feed row as pushed so a replay cannot create a second fulfillment. Orders with nothing open, or shipments already flagged as pushed, are reported as skipped instead of failing.",
  "integrationId": "__INTEGRATION_ID__",
  "triggerType": "Cron",
  "cronExpression": "*/30 * * * *",
  "allowPostReplay": true,
  "nodes": [
    {
      "id": {
        "$guid": "order-shipment/ShipmentSchedule"
      },
      "stepType": "Schedule",
      "nodeName": "ShipmentSchedule",
      "positionX": 0,
      "positionY": 0,
      "endpointUrl": "",
      "httpMethod": "GET",
      "urlMode": "Manual",
      "authType": "None",
      "stepConfig": {
        "$json": {
          "schedule": {
            "mode": "Cron",
            "cronExpression": "*/30 * * * *"
          }
        }
      }
    },
    {
      "id": {
        "$guid": "order-shipment/FetchBcShipments"
      },
      "stepType": "HttpAction",
      "nodeName": "FetchBcShipments",
      "positionX": 440,
      "positionY": 0,
      "endpointUrl": "companies(companyId)/fintegratorShippedOrders",
      "httpMethod": "GET",
      "urlMode": "Connection",
      "authType": "None",
      "connectionId": "__BC_CONNECTION__",
      "urlCode": {
        "$script": "order_shipment/url_fetch_shipments.cs"
      },
      "postFlightCode": {
        "$script": "order_shipment/postflight_fetch_shipments.cs"
      },
      "stepConfig": {
        "$json": {
          "apiPacket": {
            "headersJson": "{\"Accept\":\"application/json\"}",
            "queryParamsJson": "{}",
            "contentType": "application/json",
            "requestBody": ""
          }
        }
      }
    },
    {
      "id": {
        "$guid": "order-shipment/SaveShipmentWatermark"
      },
      "stepType": "PersistedState",
      "nodeName": "SaveShipmentWatermark",
      "positionX": 880,
      "positionY": 0,
      "endpointUrl": "",
      "httpMethod": "GET",
      "urlMode": "Manual",
      "authType": "None",
      "mappingCode": {
        "$script": "order_shipment/save_watermark.cs"
      }
    },
    {
      "id": {
