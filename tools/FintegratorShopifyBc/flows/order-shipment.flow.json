      },
      "stepType": "Mapping",
      "nodeName": "LatestShipmentPerOrder",
      "positionX": 1320,
      "positionY": 0,
      "endpointUrl": "",
      "httpMethod": "GET",
      "urlMode": "Manual",
      "authType": "None",
      "mappingCode": {
