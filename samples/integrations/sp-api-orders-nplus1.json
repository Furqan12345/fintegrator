      "stepType": "Mapping",
      "nodeName": "TagLineItems",
      "positionX": 1180,
      "positionY": 120,
      "endpointUrl": "",
      "httpMethod": "GET",
      "urlMode": "Manual",
      "authType": "None",
      "mappingCode": "var fs = JObject.Parse(FlowStateJson); var order = fs[\"order\"]; var items = (JArray)(fs[\"FetchLineItems\"]?[\"items\"] ?? new JArray()); var enriched = new JArray(); foreach (var raw in items) { var c = (JObject)raw.DeepClone(); c[\"AmazonOrderId\"] = order?[\"AmazonOrderId\"]?.ToString(); enriched.Add(c); } return new JObject { [\"AmazonOrderId\"] = order?[\"AmazonOrderId\"]?.ToString(), [\"OrderStatus\"] = order?[\"OrderStatus\"]?.ToString(), [\"items\"] = enriched }.ToString();",
