# Replace these values on the VM. Keep this file private and never commit .env.
IPAAS_DOMAIN=integrator.example.com
IPAAS_PUBLIC_BASE_URL=https://integrator.example.com
IPAAS_ENCRYPTION_KEY=replace-with-32-character-random-base64
IPAAS_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

# Optional: required for self-service password reset and invitation emails.
IPAAS_SMTP_HOST=
IPAAS_SMTP_PORT=587
IPAAS_SMTP_USE_SSL=true
IPAAS_SMTP_USERNAME=
IPAAS_SMTP_PASSWORD=
IPAAS_SMTP_FROM=no-reply@fusetor.com

# Set to true only when the flow must call internal/private-network hosts.
IPAAS_ALLOW_PRIVATE_OUTBOUND=false

# Optional long-lived key for Prometheus scraping /metrics (X-Metrics-Key).
IPAAS_METRICS_KEY=replace-with-at-least-32-random-characters
