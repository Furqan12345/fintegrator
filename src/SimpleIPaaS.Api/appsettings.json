{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Database": {
      "Enabled": true,
      "MinimumLevel": "Information",
      "RetentionHours": 72,
      "MaxRows": 100000,
      "BatchSize": 200,
      "FlushIntervalSeconds": 1,
      "QueueCapacity": 20000,
      "PruneIntervalMinutes": 5,
      "MaxMessageLength": 4000,
      "MaxExceptionLength": 16000
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5001",
      "https://localhost:5001",
      "http://localhost:5000"
    ]
  },
  "Scripting": {
    "TimeoutSeconds": 10
  },
  "DeadLetter": {
    "MaxAutoRetryAttempts": 0
  }
}
