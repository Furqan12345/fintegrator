{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Database": {
      "Enabled": true,
      "MinimumLevel": "Information",
      "RetentionHours": 72,
      "WarningRetentionHours": 336,
      "BatchSize": 200,
      "FlushIntervalSeconds": 1,
      "QueueCapacity": 20000,
      "PruneIntervalMinutes": 5,
      "MaxMessageLength": 4000,
      "MaxExceptionLength": 16000
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "FlowBuildOutputTokens": 32768
  },
  "Auth": {
    "Jwt": {
      "Issuer": "fusetor",
      "Audience": "fusetor",
      "SigningKey": "",
      "AccessTokenMinutes": 10080,
      "RefreshTokenDays": 30,
      "SetupTokenMinutes": 10
    }
  },
  "App": {
    "PublicBaseUrl": ""
  },
  "Outbound": {
    "AllowPrivateNetworks": false,
    "AllowedHosts": []
  },
  "Metrics": {
    "ApiKey": ""
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "no-reply@fusetor.com",
      "FromName": "Fusetor"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5001",
      "https://localhost:5001",
      "http://localhost:5000"
    ]
  },
  "Scripting": {
    "TimeoutSeconds": 10
  },
  "Operations": {
    "EngineHeartbeatTimeoutSeconds": 90
  },
  "DeadLetter": {
    "MaxAutoRetryAttempts": 0
  }
}
