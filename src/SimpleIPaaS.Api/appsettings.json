{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5001",
      "https://localhost:5001",
      "http://localhost:5000"
    ]
  },
  "Scripting": {
    "TimeoutSeconds": 10
  },
  "DeadLetter": {
    "MaxAutoRetryAttempts": 0
  }
}

