{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Database": {
      "Enabled": true,
      "MinimumLevel": "Information",
      "RetentionHours": 72,
      "MaxRows": 100000,
      "BatchSize": 200,
      "FlushIntervalSeconds": 1,
      "QueueCapacity": 20000,
      "PruneIntervalMinutes": 5,
      "MaxMessageLength": 4000,
      "MaxExceptionLength": 16000
    }
  },
  "Scripting": {
    "TimeoutSeconds": 10
  },

  "Execution": {
    "MaxConcurrency": 4,
    "MaxFlowDurationSeconds": 600,
    "PollIntervalSeconds": 2
  },
  "DeadLetter": {
    "MaxAutoRetryAttempts": 0
  }
}
