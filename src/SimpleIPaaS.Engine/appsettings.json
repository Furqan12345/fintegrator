{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Scripting": {
    "TimeoutSeconds": 10
  },

  "Execution": {
    "MaxConcurrency": 4,
    "MaxFlowDurationSeconds": 600,
    "PollIntervalSeconds": 2
  },
  "DeadLetter": {
    "MaxAutoRetryAttempts": 0
  }
}
