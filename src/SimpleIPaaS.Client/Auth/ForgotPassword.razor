@page "/forgot-password"
@inject AuthApiClient AuthApi

<PageTitle>Forgot password · fusetor.com</PageTitle>

<h1 class="auth-title">Forgot password</h1>
<p class="auth-subtitle">Enter your account email and we’ll send a reset link.</p>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="auth-info">@_message</div>
}
@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="auth-error" role="alert">@_error</div>
}

<form class="auth-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <label class="form-label" for="forgot-email">Email</label>
    <input id="forgot-email" class="form-control" type="email" autocomplete="username" @bind="Email" disabled="@_busy" />
    <button type="submit" class="btn btn-primary auth-submit" disabled="@_busy">
        @(_busy ? "Sending…" : "Send reset link")
    </button>
</form>

<div class="auth-links">
    <a class="auth-link" href="/login">Back to sign in</a>
</div>

@code {
    private string Email { get; set; } = string.Empty;
    private bool _busy;
    private string? _message;
    private string? _error;

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _error = null;
        try
        {
            await AuthApi.ForgotPasswordAsync(Email.Trim());
            _message = "If the account exists, a reset email has been sent.";
        }
        catch (AuthApiException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "The API could not be reached. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
