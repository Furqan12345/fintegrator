@page "/reset-password"
@inject AuthApiClient AuthApi

<PageTitle>Reset password · fusetor.com</PageTitle>

<h1 class="auth-title">@(IsInvite ? "Set your password" : "Reset your password")</h1>
<p class="auth-subtitle">Choose a password of at least 12 characters.</p>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="auth-success">@_message</div>
    <p class="auth-hint"><a class="auth-link" href="/login">Return to sign in</a></p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="auth-error" role="alert">@_error</div>
    }

    <form class="auth-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <label class="form-label" for="reset-email">Email</label>
        <input id="reset-email" class="form-control" type="email" autocomplete="username" @bind="Email" disabled="@_busy" />

        <label class="form-label" for="reset-password">New password</label>
        <input id="reset-password" class="form-control" type="password" autocomplete="new-password" @bind="Password" disabled="@_busy" />

        <label class="form-label" for="reset-confirm">Confirm new password</label>
        <input id="reset-confirm" class="form-control" type="password" autocomplete="new-password" @bind="ConfirmPassword" disabled="@_busy" />

        <button type="submit" class="btn btn-primary auth-submit" disabled="@_busy">
            @(_busy ? "Saving…" : IsInvite ? "Set password" : "Reset password")
        </button>
    </form>
}

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "invite")]
    public string? InviteQuery { get; set; }

    private string Password { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private bool _busy;
    private string? _message;
    private string? _error;

    private bool IsInvite =>
        string.Equals(InviteQuery, "1", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(InviteQuery, "true", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            _error = "This link is invalid or has expired. Request a new one.";
        }
    }

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _error = null;
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            _error = "This link is invalid or has expired. Request a new one.";
            return;
        }

        if (!string.Equals(Password, ConfirmPassword, StringComparison.Ordinal))
        {
            _error = "The passwords do not match.";
            return;
        }

        _busy = true;
        try
        {
            await AuthApi.ResetPasswordAsync(new SimpleIPaaS.Shared.Models.ResetPasswordRequest
            {
                Email = Email.Trim(),
                Token = Token,
                NewPassword = Password
            });
            _message = IsInvite
                ? "Your password is set. You can now sign in and enroll two-factor authentication."
                : "Your password has been reset.";
        }
        catch (AuthApiException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "The API could not be reached. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
