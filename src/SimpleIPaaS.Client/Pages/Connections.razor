@page "/connections"
@using SimpleIPaaS.Client.Store
@using SimpleIPaaS.Shared.Models
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<ConnectionState> ConnectionState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager
@inject HttpClient Http

<PageTitle>Connections — SimpleIPaaS</PageTitle>

<div class="page-header">
    <div class="header-left">
        <h2>Connections</h2>
        <p class="subtitle">Manage authentication and endpoints for your integrations</p>
    </div>
    <div class="header-right">
        <button class="btn btn-primary" @onclick="CreateNewConnection">+ New Connection</button>
    </div>
</div>

<div class="connections-grid">
    @if (ConnectionState.Value.IsLoading && !ConnectionState.Value.Connections.Any())
    {
        <div class="loading-state">Loading connections...</div>
    }
    else if (!ConnectionState.Value.Connections.Any())
    {
        <div class="empty-state">
            <span class="empty-icon">🔌</span>
            <h3>No connections yet</h3>
            <p>Create a connection to authenticate with external APIs.</p>
            <button class="btn btn-primary" @onclick="CreateNewConnection">Create Connection</button>
        </div>
    }
    else
    {
        @foreach (var conn in ConnectionState.Value.Connections)
        {
            <div class="connection-card" @onclick="() => EditConnection(conn.Id)">
                <div class="card-header">
                    <h3 class="card-title">@conn.Name</h3>
                    <span class="status-badge @(conn.Status.ToLower())">@conn.Status</span>
                </div>
                <div class="card-body">
                    <p class="card-desc">@conn.BaseUrl</p>
                    <div class="card-meta">
                        <span>Auth: @conn.AuthType</span>
                    </div>
                </div>
                <div class="card-footer">
                    <span class="text-muted">Updated @conn.UpdatedAt.ToShortDateString()</span>
                    <button class="btn btn-sm btn-outline" @onclick:stopPropagation="true" @onclick="() => TestConnection(conn.Id)" disabled="@(_testingConnectionId == conn.Id)">
                        @(_testingConnectionId == conn.Id ? "Testing..." : "Test")
                    </button>
                </div>
                @if (_testResults.TryGetValue(conn.Id, out var testResult))
                {
                    <div class="card-footer">
                        <span class="status-badge @(testResult.Success ? "success" : "failed")">@(testResult.Success ? "✓ Reachable" : "✗ Failed")</span>
                        <span class="text-muted">@testResult.Message</span>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private Guid? _testingConnectionId;
    private readonly Dictionary<Guid, ConnectionTestResult> _testResults = new();

    private class ConnectionTestResult
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new LoadConnectionsAction());
    }

    private async Task TestConnection(Guid connectionId)
    {
        _testingConnectionId = connectionId;
        try
        {
            var response = await Http.PostAsync($"api/connections/{connectionId}/test", null);
            var content = await response.Content.ReadAsStringAsync();
            var result = new ConnectionTestResult { Success = false, Message = content };
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(content);
                var root = document.RootElement;
                result.Success = root.TryGetProperty("success", out var success) && success.GetBoolean();
                var statusCode = root.TryGetProperty("statusCode", out var code) ? code.GetInt32() : 0;
                var error = root.TryGetProperty("error", out var errorProp) ? errorProp.GetString() : null;
                result.Message = result.Success
                    ? $"HTTP {statusCode}"
                    : string.IsNullOrWhiteSpace(error) ? $"HTTP {statusCode}" : error!;
            }
            catch (System.Text.Json.JsonException)
            {
            }

            _testResults[connectionId] = result;
        }
        finally
        {
            _testingConnectionId = null;
        }
    }

    private void CreateNewConnection()
    {
        NavigationManager.NavigateTo("/connection-wizard");
    }

    private void EditConnection(Guid connectionId)
    {
        NavigationManager.NavigateTo($"/connection-wizard/{connectionId}");
    }
}
