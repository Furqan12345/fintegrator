@page "/connections"
@using SimpleIPaaS.Client.Store
@using SimpleIPaaS.Shared.Models
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<ConnectionState> ConnectionState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager
@inject HttpClient Http

<PageTitle>Connections — fusetor.com</PageTitle>

<div class="page-scroll">
    <div class="page-header">
        <div class="header-left">
            <p class="page-eyebrow"><AppIcon Name="connections" Class="icon icon-xs" /> Credentials</p>
            <h2>Connections <span class="header-count">@ConnectionState.Value.Connections.Count</span></h2>
            <p class="subtitle">Reusable authentication and base endpoints. Flow steps reference a connection instead of storing secrets themselves.</p>
        </div>
        <div class="header-right">
            <button class="btn btn-primary" @onclick="CreateNewConnection">
                <AppIcon Name="plus" Class="icon icon-sm" /> New connection
            </button>
        </div>
    </div>

    <FilterPanel @bind-Expanded="_filtersOpen" ActiveCount="ActiveFilterCount" OnClearAll="ClearFilters" CssClass="connections-filter-panel">
        <Actions>
            @if (HasActiveFilters)
            {
                <button class="btn btn-outline btn-sm" @onclick="ClearFilters" title="Reset the filters">
                    <AppIcon Name="x-circle" Class="icon icon-sm" /> Clear
                </button>
            }
            <div class="filter-summary">@VisibleConnections.Count of @ConnectionState.Value.Connections.Count connections</div>
        </Actions>
        <Chips>
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <FilterChip Label="@($"Search: {_search}")" Title="@_search" OnRemove="ClearSearch" />
            }
            @if (!string.IsNullOrWhiteSpace(_authFilter))
            {
                <FilterChip Label="@($"Auth: {AuthLabel(_authFilter)}")" OnRemove="ClearAuthFilter" />
            }
        </Chips>
        <ChildContent>
            <div class="filter-bar-group">
                <label class="filter-field filter-field-search">
                    <span class="filter-label">Search</span>
                    <input type="search" class="form-control filter-search" placeholder="Name, base URL or auth type"
                           value="@_search" @oninput="OnSearchChanged" />
                </label>
                <label class="filter-field">
                    <span class="filter-label">Auth type</span>
                    <select class="form-control filter-select" value="@_authFilter" @onchange="OnAuthFilterChanged">
                        <option value="">All auth types</option>
                        @foreach (var authType in AuthTypeOptions)
                        {
                            <option value="@authType">@AuthLabel(authType)</option>
                        }
                    </select>
                </label>
            </div>
        </ChildContent>
    </FilterPanel>

    <div class="connections-grid">
        @if (ConnectionState.Value.IsLoading && !ConnectionState.Value.Connections.Any())
        {
            <div class="loading-state">Loading connections…</div>
        }
        else if (!ConnectionState.Value.Connections.Any())
        {
            <div class="empty-state empty-state-hero">
                <span class="empty-icon"><AppIcon Name="connections" Class="icon icon-lg" /></span>
                <h3>No connections yet</h3>
                <p>A connection stores the base URL and credentials for an external API — OAuth, API keys, basic auth or Amazon SP-API — so your flows stay free of secrets.</p>
                <button class="btn btn-primary btn-lg" @onclick="CreateNewConnection"><AppIcon Name="plus" Class="icon icon-sm" /> Create connection</button>
            </div>
        }
        else if (VisibleConnections.Count == 0)
        {
            <div class="empty-state empty-state-hero">
                <span class="empty-icon"><AppIcon Name="search" Class="icon icon-lg" /></span>
                <h3>No connections match these filters</h3>
                <p>Try a shorter search term, or pick a different auth type.</p>
                <button class="btn btn-outline" @onclick="ClearFilters">Clear filters</button>
            </div>
        }
        else
        {
            @foreach (var conn in VisibleConnections)
            {
                <article class="connection-card" @onclick="() => EditConnection(conn.Id)">
                    <div class="card-header">
                        <div class="card-headline">
                            <span class="card-avatar @AvatarTone(conn.Name)">@Monogram(conn.Name)</span>
                            <div class="card-headline-text">
                                <h3 class="card-title">@conn.Name</h3>
                                <p class="card-subtitle">@AuthLabel(conn.AuthType)</p>
                            </div>
                        </div>
                        <span class="status-badge @(conn.Status.ToLower())">@conn.Status</span>
                    </div>
                    <div class="integration-card-body">
                        <p class="card-desc mono">@(string.IsNullOrWhiteSpace(conn.BaseUrl) ? "No base URL set" : conn.BaseUrl)</p>
                        <div class="card-meta">
                            <span class="chip"><AppIcon Name="connections" Class="icon icon-xs" /> @conn.AuthType</span>
                            <span class="chip">Updated @conn.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                        </div>
                        @if (_testResults.TryGetValue(conn.Id, out var testResult))
                        {
                            <div class="connection-test-result @(testResult.Success ? "is-success" : "is-failed")">
                                <span class="status-badge @(testResult.Success ? "success" : "failed")">@(testResult.Success ? "Reachable" : "Failed")</span>
                                <span class="text-muted">@testResult.Message</span>
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-sm btn-outline" @onclick:stopPropagation="true" @onclick="() => EditConnection(conn.Id)">Edit</button>
                        <button class="btn btn-sm btn-soft" @onclick:stopPropagation="true" @onclick="() => TestConnection(conn.Id)" disabled="@(_testingConnectionId == conn.Id)">
                            @(_testingConnectionId == conn.Id ? "Testing…" : "Test connection")
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick:stopPropagation="true" @onclick="() => RequestDelete(conn)">Delete</button>
                    </div>
                </article>
            }
        }
    </div>
</div>

@if (_deleteCandidate != null)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-container confirm-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">Delete connection</h2>
                <button class="modal-close-btn" @onclick="CancelDelete" aria-label="Close">✕</button>
            </div>
            <div class="modal-body">
                <p>Delete <strong>@_deleteCandidate.Name</strong>? Flow steps that reference this connection will fail until they are pointed at another one.</p>
                <p class="text-muted">Type the connection name to confirm.</p>
                <input type="text" class="form-control" @bind="_deleteConfirmName" placeholder="@_deleteCandidate.Name" />
                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <div class="validation-banner" role="alert">@_deleteError</div>
                }
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="CancelDelete">Cancel</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@(!CanConfirmDelete)">@(_deleting ? "Deleting…" : "Delete connection")</button>
            </div>
        </div>
    </div>
}

@code {
    private Guid? _testingConnectionId;
    private readonly Dictionary<Guid, ConnectionTestResult> _testResults = new();
    private ConnectionDto? _deleteCandidate;
    private string _deleteConfirmName = string.Empty;
    private string? _deleteError;
    private bool _deleting;

    // Filters are client-side: the page already holds the whole connection list, so narrowing
    // it never needs another request.
    private string _search = string.Empty;
    private string _authFilter = string.Empty;
    private bool _filtersOpen;

    private static readonly string[] AuthTypeOptions =
    {
        "None", "Basic", "Bearer", "ApiKey", "OAuth2ClientCredentials", "OAuth2RefreshToken",
        "OAuth2AuthCode", "AmazonSpApi", "Shopify", "Custom"
    };

    private int ActiveFilterCount =>
        (!string.IsNullOrWhiteSpace(_search) ? 1 : 0) + (!string.IsNullOrWhiteSpace(_authFilter) ? 1 : 0);

    private bool HasActiveFilters => ActiveFilterCount > 0;

    private IReadOnlyList<ConnectionDto> VisibleConnections
    {
        get
        {
            var connections = ConnectionState.Value.Connections.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                connections = connections.Where(connection =>
                    connection.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (connection.BaseUrl ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    AuthLabel(connection.AuthType).Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_authFilter))
            {
                connections = connections.Where(connection =>
                    string.Equals(connection.AuthType, _authFilter, StringComparison.OrdinalIgnoreCase));
            }

            return connections.ToList();
        }
    }

    private void OnSearchChanged(ChangeEventArgs args) => _search = args.Value?.ToString() ?? string.Empty;

    private void OnAuthFilterChanged(ChangeEventArgs args) => _authFilter = args.Value?.ToString() ?? string.Empty;

    private void ClearFilters()
    {
        _search = string.Empty;
        _authFilter = string.Empty;
    }

    private void ClearSearch() => _search = string.Empty;

    private void ClearAuthFilter() => _authFilter = string.Empty;

    private class ConnectionTestResult
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new LoadConnectionsAction());
    }

    private async Task TestConnection(Guid connectionId)
    {
        _testingConnectionId = connectionId;
        try
        {
            var response = await Http.PostAsync($"api/connections/{connectionId}/test", null);
            var content = await response.Content.ReadAsStringAsync();
            var result = new ConnectionTestResult { Success = false, Message = content };
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(content);
                var root = document.RootElement;
                result.Success = root.TryGetProperty("success", out var success) && success.GetBoolean();
                var statusCode = root.TryGetProperty("statusCode", out var code) ? code.GetInt32() : 0;
                var error = root.TryGetProperty("error", out var errorProp) ? errorProp.GetString() : null;
                result.Message = result.Success
                    ? $"HTTP {statusCode}"
                    : string.IsNullOrWhiteSpace(error)
                        ? statusCode == 0
                            ? "The connection could not be reached (no HTTP response)."
                            : $"HTTP {statusCode}"
                        : error!;
            }
            catch (System.Text.Json.JsonException)
            {
            }

            _testResults[connectionId] = result;
        }
        finally
        {
            _testingConnectionId = null;
        }
    }

    private void CreateNewConnection()
    {
        NavigationManager.NavigateTo("/connection-wizard");
    }

    private void RequestDelete(ConnectionDto connection)
    {
        _deleteCandidate = connection;
        _deleteConfirmName = string.Empty;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _deleteCandidate = null;
        _deleteConfirmName = string.Empty;
        _deleteError = null;
    }

    private bool CanConfirmDelete =>
        _deleteCandidate != null && !_deleting &&
        string.Equals(_deleteConfirmName.Trim(), _deleteCandidate.Name, StringComparison.Ordinal);

    private async Task ConfirmDelete()
    {
        if (_deleteCandidate == null || !CanConfirmDelete)
        {
            return;
        }

        _deleting = true;
        _deleteError = null;
        try
        {
            var response = await Http.DeleteAsync($"api/connections/{_deleteCandidate.Id}");
            if (response.IsSuccessStatusCode)
            {
                _deleteCandidate = null;
                _deleteConfirmName = string.Empty;
                Dispatcher.Dispatch(new LoadConnectionsAction());
                return;
            }

            _deleteError = response.StatusCode == System.Net.HttpStatusCode.NotFound
                ? "This connection no longer exists."
                : $"The connection could not be deleted (HTTP {(int)response.StatusCode}).";
        }
        catch (Exception ex)
        {
            _deleteError = $"The connection could not be deleted: {ex.Message}";
        }
        finally
        {
            _deleting = false;
        }
    }

    private void EditConnection(Guid connectionId)
    {
        NavigationManager.NavigateTo($"/connection-wizard/{connectionId}");
    }

    private static string AuthLabel(string authType) => authType switch
    {
        "None" => "No authentication",
        "Basic" => "Basic authentication",
        "Bearer" => "Bearer token",
        "ApiKey" => "API key",
        "OAuth2ClientCredentials" => "OAuth 2.0 · client credentials",
        "OAuth2RefreshToken" => "OAuth 2.0 · refresh token",
        "OAuth2AuthCode" => "OAuth 2.0 · authorization code",
        "AmazonSpApi" => "Amazon SP-API · LWA + SigV4",
        "Shopify" => "Shopify · Admin API",
        "Custom" => "Custom headers",
        _ => authType
    };

    private static string Monogram(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(new[] { ' ', '-', '_', '.' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
        }

        return name.Trim().Length >= 2
            ? name.Trim().Substring(0, 2).ToUpperInvariant()
            : name.Trim().ToUpperInvariant();
    }

    private static readonly string[] AvatarTones = { "", "tone-teal", "tone-violet", "tone-cyan", "tone-pink", "tone-amber" };

    private static string AvatarTone(string name) =>
        string.IsNullOrEmpty(name) ? string.Empty : AvatarTones[name.Aggregate(0, (acc, ch) => acc + ch) % AvatarTones.Length];
}
