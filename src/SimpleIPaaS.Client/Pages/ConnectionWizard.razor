@page "/connection-wizard"
@page "/connection-wizard/{ConnectionId:guid}"
@using System.Net.Http.Json
@using System.Text.Json
@using SimpleIPaaS.Client.Store
@using SimpleIPaaS.Shared.Models
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<ConnectionState> ConnectionState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager
@inject HttpClient Http

<PageTitle>Connection Wizard - SimpleIPaaS</PageTitle>

<div class="wizard-container">
    <div class="page-header">
        <div class="header-left">
            <p class="breadcrumb">
                <a href="connections">Connections</a>
                <span class="breadcrumb-sep">/</span>
                <span>@(ConnectionId.HasValue ? "Edit" : "New")</span>
            </p>
            <h2>@(ConnectionId.HasValue ? "Edit connection" : "New connection")</h2>
            <p class="subtitle">Store the endpoint and credentials once — every flow step can then reference this connection by name.</p>
        </div>
        <div class="header-right">
            <button class="btn btn-outline" @onclick="GoBack">Cancel</button>
            <button class="btn btn-primary" @onclick="SaveConnection" disabled="@ConnectionState.Value.IsLoading">
                @(ConnectionState.Value.IsLoading ? "Saving…" : "Save connection")
            </button>
        </div>
    </div>

    <div class="wizard-form">
        <section class="wizard-section">
            <h3 class="wizard-section-title"><AppIcon Name="connections" Class="icon icon-sm" /> Endpoint</h3>
            <p class="wizard-section-hint">Where requests are sent and how this connection is identified in the designer.</p>
            <div class="form-group">
                <label>Name</label>
                <input type="text" class="form-control" @bind="_connection.Name" placeholder="e.g. Salesforce Production" />
            </div>
            <div class="form-group">
                <label>Base URL</label>
                <input type="text" class="form-control" @bind="_connection.BaseUrl" placeholder="https://api.example.com" />
                <small class="field-hint">HTTP Action steps append their path to this base URL.</small>
            </div>
        </section>

        <section class="wizard-section">
            <h3 class="wizard-section-title"><AppIcon Name="settings" Class="icon icon-sm" /> Authentication</h3>
            <p class="wizard-section-hint">Secrets are encrypted at rest and never returned to the browser.</p>
            <div class="form-group">
                <label>Auth Type</label>
                <select class="form-control" @bind="_connection.AuthType">
                    <option value="None">None</option>
                    <option value="Basic">Basic Auth</option>
                    <option value="Bearer">Bearer Token</option>
                    <option value="ApiKey">API Key</option>
                    <option value="OAuth2ClientCredentials">OAuth 2.0 Client Credentials</option>
                    <option value="OAuth2RefreshToken">OAuth 2.0 Refresh Token</option>
                    <option value="OAuth2AuthCode">OAuth 2.0 Authorization Code</option>
                    <option value="AmazonSpApi">Amazon SP-API (LWA + AWS SigV4)</option>
                    <option value="Custom">Custom Headers</option>
                </select>
            </div>

        @if (ShowStoredSecretHint)
        {
            <div class="form-hint">Credentials for this connection are stored securely and are not shown. Leave the fields below blank to keep them, or enter new values to replace them.</div>
        }

        @if (!string.IsNullOrEmpty(_authError))
        {
            <div class="validation-banner">@_authError</div>
        }

        @if (_connection.AuthType == "Basic")
        {
            <div class="form-group">
                <label>Username</label>
                <input type="text" class="form-control" @bind="_basicUsername" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" class="form-control" @bind="_basicPassword" placeholder="@SecretPlaceholder" />
            </div>
        }
        else if (_connection.AuthType == "Bearer")
        {
            <div class="form-group">
                <label>Token</label>
                <input type="password" class="form-control" @bind="_bearerToken" placeholder="@SecretPlaceholder" />
            </div>
        }
        else if (_connection.AuthType == "ApiKey")
        {
            <div class="form-group">
                <label>Placement</label>
                <select class="form-control" @bind="_apiKeyPlacement">
                    <option value="header">Header</option>
                    <option value="query">Query Parameter</option>
                </select>
            </div>
            <div class="form-group">
                <label>@(_apiKeyPlacement == "query" ? "Parameter Name" : "Header Name")</label>
                <input type="text" class="form-control" @bind="_apiKeyHeaderName" />
            </div>
            <div class="form-group">
                <label>API Key</label>
                <input type="password" class="form-control" @bind="_apiKeyValue" placeholder="@SecretPlaceholder" />
            </div>
        }
        else if (_connection.AuthType == "OAuth2ClientCredentials")
        {
            <div class="form-group">
                <label>Token URL</label>
                <input type="text" class="form-control" @bind="_oauthTokenUrl" placeholder="https://auth.example.com/oauth/token" />
            </div>
            <div class="form-group">
                <label>Client ID</label>
                <input type="text" class="form-control" @bind="_oauthClientId" />
            </div>
            <div class="form-group">
                <label>Client Secret</label>
                <input type="password" class="form-control" @bind="_oauthClientSecret" placeholder="@SecretPlaceholder" />
            </div>
            <div class="form-group">
                <label>Scope (optional)</label>
                <input type="text" class="form-control" @bind="_oauthScope" placeholder="e.g. read write" />
            </div>
        }
        else if (_connection.AuthType == "OAuth2RefreshToken")
        {
            <div class="form-group">
                <label>Token URL</label>
                <input type="text" class="form-control" @bind="_oauthTokenUrl" />
            </div>
            <div class="form-group">
                <label>Refresh Token</label>
                <input type="password" class="form-control" @bind="_oauthRefreshToken" placeholder="@SecretPlaceholder" />
            </div>
            <div class="form-group">
                <label>Access Token (optional)</label>
                <input type="password" class="form-control" @bind="_oauthAccessToken" placeholder="@SecretPlaceholder" />
            </div>
            <div class="form-group">
                <label>Client ID (optional)</label>
                <input type="text" class="form-control" @bind="_oauthClientId" />
            </div>
            <div class="form-group">
                <label>Client Secret (optional)</label>
                <input type="password" class="form-control" @bind="_oauthClientSecret" placeholder="@SecretPlaceholder" />
            </div>
        }
        else if (_connection.AuthType == "OAuth2AuthCode")
        {
            <div class="form-group">
                <label>Token URL</label>
                <input type="text" class="form-control" @bind="_oauthTokenUrl" />
            </div>
            <div class="form-group">
                <label>Client ID</label>
                <input type="text" class="form-control" @bind="_oauthClientId" />
            </div>
            <div class="form-group">
                <label>Client Secret</label>
                <input type="password" class="form-control" @bind="_oauthClientSecret" placeholder="@SecretPlaceholder" />
            </div>
            <div class="form-group">
                <label>Access Token</label>
                <input type="password" class="form-control" @bind="_oauthAccessToken" placeholder="@SecretPlaceholder" />
            </div>
            <div class="form-group">
                <label>Refresh Token</label>
                <input type="password" class="form-control" @bind="_oauthRefreshToken" placeholder="@SecretPlaceholder" />
            </div>
        }
        else if (_connection.AuthType == "AmazonSpApi")
        {
            <div class="form-group">
                <label>LWA Token URL</label>
                <input type="text" class="form-control" @bind="_amazonTokenUrl" />
            </div>
            <div class="form-group">
                <label>LWA Client ID</label>
                <input type="text" class="form-control" @bind="_amazonClientId" />
            </div>
            <div class="form-group">
                <label>LWA Client Secret</label>
                <input type="password" class="form-control" @bind="_amazonClientSecret" placeholder="@SecretPlaceholder" />
            </div>
            <div class="form-group">
                <label>LWA Refresh Token</label>
                <input type="password" class="form-control" @bind="_amazonRefreshToken" placeholder="@SecretPlaceholder" />
            </div>
            <div class="form-group">
                <label>AWS Access Key ID</label>
                <input type="text" class="form-control" @bind="_amazonAccessKeyId" />
            </div>
            <div class="form-group">
                <label>AWS Secret Access Key</label>
                <input type="password" class="form-control" @bind="_amazonSecretAccessKey" placeholder="@SecretPlaceholder" />
            </div>
            <div class="form-group">
                <label>AWS Session Token (optional)</label>
                <input type="password" class="form-control" @bind="_amazonSessionToken" placeholder="@SecretPlaceholder" />
            </div>
            <div class="form-group">
                <label>AWS Region</label>
                <input type="text" class="form-control" @bind="_amazonRegion" placeholder="us-east-1" />
            </div>
            <div class="form-group">
                <label>AWS Service</label>
                <input type="text" class="form-control" @bind="_amazonService" placeholder="execute-api" />
            </div>
            <div class="form-group">
                <label>STS Role ARN (optional)</label>
                <input type="text" class="form-control" @bind="_amazonRoleArn" placeholder="arn:aws:iam::123456789012:role/SpApiRole" />
            </div>
            <div class="form-group">
                <label>STS Role Session Name</label>
                <input type="text" class="form-control" @bind="_amazonRoleSessionName" placeholder="fintegrator-sp-api" />
            </div>
            <div class="form-group">
                <label>STS External ID (optional)</label>
                <input type="password" class="form-control" @bind="_amazonExternalId" placeholder="@SecretPlaceholder" />
            </div>
            <div class="form-group">
                <label>STS Region</label>
                <input type="text" class="form-control" @bind="_amazonStsRegion" placeholder="us-east-1" />
            </div>
            <div class="form-group">
                <label>STS Endpoint (optional)</label>
                <input type="text" class="form-control" @bind="_amazonStsEndpoint" placeholder="https://sts.amazonaws.com" />
            </div>
            <div class="form-group">
                <label>STS Duration Seconds</label>
                <input type="number" min="900" max="43200" class="form-control" @bind="_amazonDurationSeconds" />
            </div>
        }
        else if (_connection.AuthType == "Custom")
        {
            <div class="form-group">
                <label>Custom Headers</label>
                @foreach (var header in _customHeaders)
                {
                    <div class="form-row">
                        <input type="text" class="form-control" @bind="header.Name" placeholder="Header name" />
                        <input type="text" class="form-control" @bind="header.Value" placeholder="Header value" />
                        <button class="btn btn-outline" type="button" @onclick="() => RemoveCustomHeader(header)">Remove</button>
                    </div>
                }
                <button class="btn btn-outline" type="button" @onclick="AddCustomHeader"><AppIcon Name="plus" Class="icon icon-xs" /> Add header</button>
            </div>
        }
        </section>
    </div>
</div>

@code {
    [Parameter] public Guid? ConnectionId { get; set; }

    private ConnectionDto _connection = new() { Status = "Active" };
    private string _basicUsername = string.Empty;
    private string _basicPassword = string.Empty;
    private string _bearerToken = string.Empty;
    private string _apiKeyHeaderName = "X-Api-Key";
    private string _apiKeyValue = string.Empty;
    private string _apiKeyPlacement = "header";
    private string _oauthTokenUrl = string.Empty;
    private string _oauthRefreshToken = string.Empty;
    private string _oauthAccessToken = string.Empty;
    private string _oauthClientId = string.Empty;
    private string _oauthClientSecret = string.Empty;
    private string _oauthScope = string.Empty;
    private string _amazonTokenUrl = "https://api.amazon.com/auth/o2/token";
    private string _amazonClientId = string.Empty;
    private string _amazonClientSecret = string.Empty;
    private string _amazonRefreshToken = string.Empty;
    private string _amazonAccessKeyId = string.Empty;
    private string _amazonSecretAccessKey = string.Empty;
    private string _amazonSessionToken = string.Empty;
    private string _amazonRegion = "us-east-1";
    private string _amazonService = "execute-api";
    private string _amazonRoleArn = string.Empty;
    private string _amazonRoleSessionName = "fintegrator-sp-api";
    private string _amazonExternalId = string.Empty;
    private string _amazonStsRegion = "us-east-1";
    private string _amazonStsEndpoint = string.Empty;
    private int _amazonDurationSeconds = 3600;
    private string _hydratedAmazonTokenUrl = "https://api.amazon.com/auth/o2/token";
    private string _hydratedAmazonClientId = string.Empty;
    private string _hydratedAmazonRegion = "us-east-1";
    private string _hydratedAmazonService = "execute-api";
    private string _hydratedAmazonRoleArn = string.Empty;
    private string _hydratedAmazonRoleSessionName = "fintegrator-sp-api";
    private string _hydratedAmazonStsRegion = "us-east-1";
    private string _hydratedAmazonStsEndpoint = string.Empty;
    private int _hydratedAmazonDurationSeconds = 3600;
    private List<CustomHeaderEntry> _customHeaders = new() { new CustomHeaderEntry() };
    private bool _isEditMode;
    private string _originalAuthType = string.Empty;
    private bool _hadStoredAuthConfig;
    private string? _authError;
    private string _hydratedApiKeyHeaderName = "X-Api-Key";
    private string _hydratedApiKeyPlacement = "header";
    private string _hydratedTokenUrl = string.Empty;
    private string _hydratedClientId = string.Empty;
    private string _hydratedScope = string.Empty;

    private bool ShowStoredSecretHint =>
        _isEditMode && _hadStoredAuthConfig && _connection.AuthType == _originalAuthType && _connection.AuthType != "None";

    private string SecretPlaceholder => ShowStoredSecretHint ? "Stored — leave blank to keep" : string.Empty;

    private class CustomHeaderEntry
    {
        public string Name { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    private void AddCustomHeader()
    {
        _customHeaders.Add(new CustomHeaderEntry());
    }

    private void RemoveCustomHeader(CustomHeaderEntry header)
    {
        _customHeaders.Remove(header);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (!ConnectionId.HasValue)
        {
            return;
        }

        var existing = ConnectionState.Value.Connections.FirstOrDefault(connection => connection.Id == ConnectionId.Value);
        if (existing == null)
        {
            existing = await Http.GetFromJsonAsync<ConnectionDto>($"api/connections/{ConnectionId.Value}");
        }

        if (existing == null)
        {
            return;
        }

        _connection = new ConnectionDto
        {
            Id = existing.Id,
            Name = existing.Name,
            BaseUrl = existing.BaseUrl,
            AuthType = existing.AuthType,
            TenantId = existing.TenantId,
            AuthConfigJson = existing.AuthConfigJson,
            Status = existing.Status
        };

        _isEditMode = true;
        _originalAuthType = existing.AuthType;
        _hadStoredAuthConfig = !string.Equals(existing.AuthType, "None", StringComparison.OrdinalIgnoreCase);

        HydrateAuthFields(existing.AuthConfigJson);
        CaptureAuthBaseline();
    }

    private void SaveConnection()
    {
        _authError = null;

        if (_isEditMode && _hadStoredAuthConfig && !HasAuthInput() && RequiresCredentials(_connection.AuthType))
        {
            if (_connection.AuthType != _originalAuthType)
            {
                _authError = "Changing the authentication type requires entering the new credentials.";
                return;
            }

            if (HasNonSecretAuthChange())
            {
                _authError = "Re-enter the credentials to change these authentication settings.";
                return;
            }
        }

        _connection.AuthConfigJson = ResolveAuthConfigJson();
        Dispatcher.Dispatch(new SaveConnectionAction { Connection = _connection });
        GoBack();
    }

    private static bool RequiresCredentials(string authType) =>
        !string.Equals(authType, "None", StringComparison.OrdinalIgnoreCase);

    private bool HasNonSecretAuthChange()
    {
        return _connection.AuthType switch
        {
            "ApiKey" => _apiKeyHeaderName != _hydratedApiKeyHeaderName || _apiKeyPlacement != _hydratedApiKeyPlacement,
            "OAuth2ClientCredentials" => _oauthTokenUrl != _hydratedTokenUrl || _oauthClientId != _hydratedClientId || _oauthScope != _hydratedScope,
            "OAuth2RefreshToken" or "OAuth2AuthCode" => _oauthTokenUrl != _hydratedTokenUrl || _oauthClientId != _hydratedClientId,
            "AmazonSpApi" => _amazonTokenUrl != _hydratedAmazonTokenUrl || _amazonClientId != _hydratedAmazonClientId || _amazonRegion != _hydratedAmazonRegion || _amazonService != _hydratedAmazonService || _amazonRoleArn != _hydratedAmazonRoleArn || _amazonRoleSessionName != _hydratedAmazonRoleSessionName || _amazonStsRegion != _hydratedAmazonStsRegion || _amazonStsEndpoint != _hydratedAmazonStsEndpoint || _amazonDurationSeconds != _hydratedAmazonDurationSeconds,
            "Custom" => _customHeaders.Any(header => !string.IsNullOrWhiteSpace(header.Name)),
            _ => false
        };
    }

    private string ResolveAuthConfigJson()
    {
        if (!_isEditMode || _connection.AuthType != _originalAuthType || HasAuthInput())
        {
            return BuildAuthConfigJson();
        }

        return string.Empty;
    }

    private bool HasAuthInput()
    {
        return _connection.AuthType switch
        {
            "Basic" => !string.IsNullOrEmpty(_basicUsername) || !string.IsNullOrEmpty(_basicPassword),
            "Bearer" => !string.IsNullOrEmpty(_bearerToken),
            "ApiKey" => !string.IsNullOrEmpty(_apiKeyValue),
            "OAuth2ClientCredentials" => !string.IsNullOrEmpty(_oauthClientId) || !string.IsNullOrEmpty(_oauthClientSecret) || !string.IsNullOrEmpty(_oauthTokenUrl),
            "OAuth2RefreshToken" => !string.IsNullOrEmpty(_oauthRefreshToken) || !string.IsNullOrEmpty(_oauthAccessToken) || !string.IsNullOrEmpty(_oauthClientSecret),
            "OAuth2AuthCode" => !string.IsNullOrEmpty(_oauthAccessToken) || !string.IsNullOrEmpty(_oauthRefreshToken) || !string.IsNullOrEmpty(_oauthClientSecret),
            "AmazonSpApi" => !string.IsNullOrEmpty(_amazonClientId) || !string.IsNullOrEmpty(_amazonClientSecret) || !string.IsNullOrEmpty(_amazonRefreshToken) || !string.IsNullOrEmpty(_amazonAccessKeyId) || !string.IsNullOrEmpty(_amazonSecretAccessKey) || !string.IsNullOrEmpty(_amazonSessionToken) || !string.IsNullOrEmpty(_amazonRoleArn) || !string.IsNullOrEmpty(_amazonExternalId),
            "Custom" => _customHeaders.Any(header => !string.IsNullOrWhiteSpace(header.Name)),
            _ => false
        };
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/connections");
    }

    private string BuildAuthConfigJson()
    {
        object payload = _connection.AuthType switch
        {
            "Basic" => new { username = _basicUsername, password = _basicPassword },
            "Bearer" => new { token = _bearerToken },
            "ApiKey" => new { headerName = _apiKeyHeaderName, apiKey = _apiKeyValue, placement = _apiKeyPlacement },
            "OAuth2ClientCredentials" => new { tokenUrl = _oauthTokenUrl, clientId = _oauthClientId, clientSecret = _oauthClientSecret, scope = _oauthScope },
            "OAuth2RefreshToken" => new { tokenUrl = _oauthTokenUrl, refreshToken = _oauthRefreshToken, accessToken = _oauthAccessToken, clientId = _oauthClientId, clientSecret = _oauthClientSecret },
            "OAuth2AuthCode" => new { tokenUrl = _oauthTokenUrl, clientId = _oauthClientId, clientSecret = _oauthClientSecret, accessToken = _oauthAccessToken, refreshToken = _oauthRefreshToken },
            "AmazonSpApi" => new { tokenUrl = _amazonTokenUrl, clientId = _amazonClientId, clientSecret = _amazonClientSecret, refreshToken = _amazonRefreshToken, accessKeyId = _amazonAccessKeyId, secretAccessKey = _amazonSecretAccessKey, sessionToken = _amazonSessionToken, region = _amazonRegion, service = _amazonService, roleArn = _amazonRoleArn, roleSessionName = _amazonRoleSessionName, externalId = _amazonExternalId, stsRegion = _amazonStsRegion, stsEndpoint = _amazonStsEndpoint, durationSeconds = _amazonDurationSeconds },
            "Custom" => new { headers = _customHeaders.Where(header => !string.IsNullOrWhiteSpace(header.Name)).Select(header => new { name = header.Name, value = header.Value }).ToList() },
            _ => new { }
        };

        return JsonSerializer.Serialize(payload);
    }

    private void CaptureAuthBaseline()
    {
        _hydratedApiKeyHeaderName = _apiKeyHeaderName;
        _hydratedApiKeyPlacement = _apiKeyPlacement;
        _hydratedTokenUrl = _oauthTokenUrl;
        _hydratedClientId = _oauthClientId;
        _hydratedScope = _oauthScope;
        _hydratedAmazonTokenUrl = _amazonTokenUrl;
        _hydratedAmazonClientId = _amazonClientId;
        _hydratedAmazonRegion = _amazonRegion;
        _hydratedAmazonService = _amazonService;
        _hydratedAmazonRoleArn = _amazonRoleArn;
        _hydratedAmazonRoleSessionName = _amazonRoleSessionName;
        _hydratedAmazonStsRegion = _amazonStsRegion;
        _hydratedAmazonStsEndpoint = _amazonStsEndpoint;
        _hydratedAmazonDurationSeconds = _amazonDurationSeconds;
    }

    private void HydrateAuthFields(string authConfigJson)
    {
        if (string.IsNullOrWhiteSpace(authConfigJson))
        {
            return;
        }

        using var document = JsonDocument.Parse(authConfigJson);
        var root = document.RootElement;
        _basicUsername = root.TryGetProperty("username", out var username) ? username.GetString() ?? string.Empty : string.Empty;
        _basicPassword = root.TryGetProperty("password", out var password) ? password.GetString() ?? string.Empty : string.Empty;
        _bearerToken = root.TryGetProperty("token", out var token) ? token.GetString() ?? string.Empty : string.Empty;
        _apiKeyHeaderName = root.TryGetProperty("headerName", out var headerName) ? headerName.GetString() ?? "X-Api-Key" : "X-Api-Key";
        _apiKeyValue = root.TryGetProperty("apiKey", out var apiKey) ? apiKey.GetString() ?? string.Empty : string.Empty;
        _apiKeyPlacement = root.TryGetProperty("placement", out var placement) ? placement.GetString() ?? "header" : "header";
        _oauthTokenUrl = root.TryGetProperty("tokenUrl", out var tokenUrl) ? tokenUrl.GetString() ?? string.Empty : string.Empty;
        _oauthRefreshToken = root.TryGetProperty("refreshToken", out var refreshToken) ? refreshToken.GetString() ?? string.Empty : string.Empty;
        _oauthAccessToken = root.TryGetProperty("accessToken", out var accessToken) ? accessToken.GetString() ?? string.Empty : string.Empty;
        _oauthClientId = root.TryGetProperty("clientId", out var clientId) ? clientId.GetString() ?? string.Empty : string.Empty;
        _oauthClientSecret = root.TryGetProperty("clientSecret", out var clientSecret) ? clientSecret.GetString() ?? string.Empty : string.Empty;
        _oauthScope = root.TryGetProperty("scope", out var scope) ? scope.GetString() ?? string.Empty : string.Empty;
        _amazonTokenUrl = root.TryGetProperty("tokenUrl", out var amazonTokenUrl) ? amazonTokenUrl.GetString() ?? "https://api.amazon.com/auth/o2/token" : "https://api.amazon.com/auth/o2/token";
        _amazonClientId = root.TryGetProperty("clientId", out var amazonClientId) ? amazonClientId.GetString() ?? string.Empty : string.Empty;
        _amazonRefreshToken = root.TryGetProperty("refreshToken", out var amazonRefreshToken) ? amazonRefreshToken.GetString() ?? string.Empty : string.Empty;
        _amazonAccessKeyId = root.TryGetProperty("accessKeyId", out var accessKeyId) ? accessKeyId.GetString() ?? string.Empty : string.Empty;
        _amazonSecretAccessKey = root.TryGetProperty("secretAccessKey", out var secretAccessKey) ? secretAccessKey.GetString() ?? string.Empty : string.Empty;
        _amazonSessionToken = root.TryGetProperty("sessionToken", out var sessionToken) ? sessionToken.GetString() ?? string.Empty : string.Empty;
        _amazonRegion = root.TryGetProperty("region", out var amazonRegion) ? amazonRegion.GetString() ?? "us-east-1" : "us-east-1";
        _amazonService = root.TryGetProperty("service", out var amazonService) ? amazonService.GetString() ?? "execute-api" : "execute-api";
        _amazonRoleArn = root.TryGetProperty("roleArn", out var roleArn) ? roleArn.GetString() ?? string.Empty : string.Empty;
        _amazonRoleSessionName = root.TryGetProperty("roleSessionName", out var roleSessionName) ? roleSessionName.GetString() ?? "fintegrator-sp-api" : "fintegrator-sp-api";
        _amazonExternalId = root.TryGetProperty("externalId", out var externalId) ? externalId.GetString() ?? string.Empty : string.Empty;
        _amazonStsRegion = root.TryGetProperty("stsRegion", out var stsRegion) ? stsRegion.GetString() ?? "us-east-1" : "us-east-1";
        _amazonStsEndpoint = root.TryGetProperty("stsEndpoint", out var stsEndpoint) ? stsEndpoint.GetString() ?? string.Empty : string.Empty;
        _amazonDurationSeconds = root.TryGetProperty("durationSeconds", out var durationSeconds) ? durationSeconds.GetInt32() : 3600;

        if (root.TryGetProperty("headers", out var headers) && headers.ValueKind == JsonValueKind.Array)
        {
            _customHeaders = headers.EnumerateArray()
                .Select(header => new CustomHeaderEntry
                {
                    Name = header.TryGetProperty("name", out var name) ? name.GetString() ?? string.Empty : string.Empty,
                    Value = header.TryGetProperty("value", out var value) ? value.GetString() ?? string.Empty : string.Empty
                })
                .ToList();

            if (_customHeaders.Count == 0)
            {
                _customHeaders.Add(new CustomHeaderEntry());
            }
        }
    }
}
