    private void RequestExitTestMode()
    {
        if (_testSession?.IsDirty == true)
        {
            _testConfirmAction = "exit";
            _showTestConfirm = true;
            StateHasChanged();
            return;
        }
        _ = ExitTestModeAsync();
    }

    private async Task ExitTestModeAsync(Guid? openCardId = null)
    {
        if (openCardId.HasValue && _testSession != null)
        {
            var pan = Diagram.Pan;
            _testReturnState = new TestModeReturnState(
                _testSession.SelectedId,
                _testSession.ScenarioName,
                openCardId,
                _testSession.SelectedCardName,
                _testSession.InspectorTab,
                _testSession.CurrentRun?.Id,
                _testSession.ResultsOpen,
                _testDrawerCollapsed,
                _testDrawerHeight,
                _testSession.ScenarioPanelOpen,
                Diagram.Zoom,
                pan.X,
                pan.Y);
        }
        else if (!openCardId.HasValue)
        {
            _testReturnState = null;
            _testRestoreView = null;
        }

        _showTestConfirm = false;
        _testConfirmAction = string.Empty;
        _testCanvasObserverAttached = false;
        try { await JSRuntime.InvokeVoidAsync("simpleIPaaSDesigner.unobserveCanvas"); }
        catch (JSException) { }
        if (_testSession != null)
        {
            _testStatus = _testSession.Status;
            _lastStatusFlowUpdated = null;
            _testSession.Changed -= OnTestSessionChanged;
            _testSession.StopPolling();
            await _testSession.DisposeAsync();
            _testSession = null;
        }
        _testMode = false;
        ApplyTestModeToDiagram();
        var id = FlowState.Value.CurrentFlow?.Id ?? FlowId;
        if (id.HasValue && id.Value != Guid.Empty)
        {
            _allowTestNavigation = true;
            NavigationManager.NavigateTo($"flow/{id.Value}", replace: !openCardId.HasValue);
            _allowTestNavigation = false;
        }
        StateHasChanged();
        if (openCardId.HasValue)
        {
            await Task.Delay(80);
            OpenCardEditor(openCardId.Value);
        }
    }

