    private ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (!_testMode && _testReturnState != null && !_allowTestNavigation
            && context.TargetLocation.Contains("mode=test", StringComparison.OrdinalIgnoreCase)
            && IsDraftDirty())
        {
            context.PreventNavigation();
            _testConfirmAction = "return-to-tests";
            _showTestConfirm = true;
            _ = InvokeAsync(StateHasChanged);
            return ValueTask.CompletedTask;
        }

        if (_testMode && (context.TargetLocation.Contains("mode=test", StringComparison.OrdinalIgnoreCase)
                          || _allowTestNavigation))
            return ValueTask.CompletedTask;

        if (_testMode && _testSession?.IsDirty == true && !_allowTestNavigation)
        {
            context.PreventNavigation();
            _pendingNavigationUrl = context.TargetLocation;
            _testConfirmAction = "navigate";
            _showTestConfirm = true;
            _ = InvokeAsync(StateHasChanged);
        }
        return ValueTask.CompletedTask;
    }

    private void AddNode(StepType type)
    {
        if (_testMode) return;
        var step = new IntegrationStepDto
        {
            StepType = type.ToString(),
            UrlMode = "Manual",
            // Keep new cards away from the floating navigation/toolbar controls at the
            // top-left of the canvas; a 0,0 node sat underneath them.
            PositionX = 160,
            PositionY = 140
        };
        var node = new IntegrationNodeModel(step) { Title = type.ToString() };
        Diagram.Nodes.Add(node);

        // A structural edit invalidates the graph the session was planned against.
        if (_debugMode)
        {
            ResetDebugSession();
            StateHasChanged();
        }
    }

    public bool HttpErrorPortHasEdges(Guid stepId) =>
        Diagram.Links.OfType<LinkModel>().Any(link =>
            (link.Source.Model as PortModel)?.Parent is IntegrationNodeModel source
            && source.StepConfig.Id == stepId
            && string.Equals(((PortModel)link.Source.Model).Id, "error", StringComparison.OrdinalIgnoreCase));

    public void RemoveHttpErrorEdges(Guid stepId)
    {
        foreach (var link in Diagram.Links.OfType<LinkModel>().Where(link =>
                     (link.Source.Model as PortModel)?.Parent is IntegrationNodeModel source
                     && source.StepConfig.Id == stepId
                     && string.Equals(((PortModel)link.Source.Model).Id, "error", StringComparison.OrdinalIgnoreCase)).ToList())
        {
            Diagram.Links.Remove(link);
        }
    }

    public void ApplyHttpErrorMode(Guid stepId, string mode)
    {
        var node = Diagram.Nodes.OfType<IntegrationNodeModel>()
            .FirstOrDefault(candidate => candidate.StepConfig.Id == stepId);
        if (node == null) return;
        node.StepConfig.HttpErrorMode = mode;
        node.SyncHttpErrorPort();
        node.Refresh();
        StateHasChanged();
    }

    // Used by the Email card to offer the node names immediately upstream of it.
    public IReadOnlyList<string> GetUpstreamNodeNames(IntegrationStepDto step)
    {
        if (Diagram == null)
        {
            return Array.Empty<string>();
        }

        var upstreamIds = new HashSet<Guid>();
        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            if ((link.Target.Model as PortModel)?.Parent is IntegrationNodeModel target
                && target.StepConfig.Id == step.Id
                && (link.Source.Model as PortModel)?.Parent is IntegrationNodeModel source)
            {
                upstreamIds.Add(source.StepConfig.Id);
            }
        }

        return Diagram.Nodes.OfType<IntegrationNodeModel>()
            .Where(node => upstreamIds.Contains(node.StepConfig.Id)
                && !string.IsNullOrWhiteSpace(node.StepConfig.NodeName))
            .Select(node => node.StepConfig.NodeName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(name => name)
            .ToList();
    }

