@page "/flow"
@page "/flow/{FlowId:guid}"
@page "/flow-designer"
@page "/flow-designer/{FlowId:guid}"
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Nodes
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.PathGenerators
@using Blazor.Diagrams.Core.Routers
@using Blazor.Diagrams.Options
@using SimpleIPaaS.Client.Components.Nodes
@using SimpleIPaaS.Client.Shared
@using SimpleIPaaS.Client.Store
@using SimpleIPaaS.Shared.Models
@using Microsoft.JSInterop
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@implements IDisposable
@inject IState<FlowState> FlowState
@inject IDispatcher Dispatcher
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Flow Designer - SimpleIPaaS</PageTitle>

<div class="diagram-container @CanvasContainerClass">
    <div class="diagram-toolbar @ToolbarClass">
        <button class="btn btn-icon toolbar-toggle" @onclick="ToggleToolbar" title="@ToolbarToggleLabel" aria-label="@ToolbarToggleLabel">
            <AppIcon Name="@(_toolbarCollapsed ? "chevron-down" : "chevron-up")" Class="icon icon-sm" />
        </button>

        <div class="toolbar-content">
            <input class="toolbar-input" type="text" @bind="FlowName" placeholder="Flow Name" />
            <select class="toolbar-input toolbar-select" value="@IntegrationValue" @onchange="OnIntegrationChanged">
                <option value="">Unassigned flow</option>
                @foreach (var integration in AvailableIntegrations)
                {
                    <option value="@integration.Id">@integration.Name</option>
                }
            </select>
            <div class="toolbar-divider"></div>
            <div class="toolbar-group" role="group" aria-label="Add node">
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.Schedule)" title="Add a schedule trigger">+ Schedule</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.HttpAction)" title="Add an HTTP action">+ HTTP Action</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.Mapping)" title="Add a mapper">+ Mapper</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.Branch)" title="Add a branch">+ Branch</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.CrossReferenceStore)" title="Add a cross-reference store">+ XRef Store</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.CrossReferenceFilter)" title="Add a cross-reference filter">+ XRef Filter</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.PersistedState)" title="Add persisted state">+ Persisted State</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.Debug)" title="Add a debug node">+ Debug</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.ForEach)" title="Add a for-each loop">+ For Each</button>
            </div>
            <div class="toolbar-divider"></div>
            <button class="btn btn-outline btn-sm" @onclick="DeleteSelectedNodes" title="Delete selected node(s)">
                <AppIcon Name="trash" Class="icon icon-xs" /> Delete
            </button>
            <button class="btn btn-outline btn-sm" @onclick="OpenFlowSettings" disabled="@(FlowState.Value.CurrentFlow == null)" title="Flow settings">
                <AppIcon Name="settings" Class="icon icon-xs" /> Settings
            </button>
            <div class="toolbar-divider"></div>
            <button class="btn btn-primary" @onclick="SaveFlow" disabled="@FlowState.Value.IsLoading">
                @(FlowState.Value.IsLoading ? "Saving…" : "Save")
            </button>
            <button class="btn btn-success" @onclick="RunFlow" disabled="@(FlowState.Value.IsLoading || FlowState.Value.CurrentFlow == null)">
                <AppIcon Name="play" Class="icon icon-xs" /> Run
            </button>
        </div>

        <button class="btn btn-icon canvas-fullscreen" @onclick="ToggleFullscreen" title="@FullscreenLabel" aria-label="@FullscreenLabel">
            <AppIcon Name="@(_isFullscreen ? "minimize" : "maximize")" Class="icon icon-sm" />
        </button>
    </div>

    @if (_validationErrors.Any())
    {
        <div class="validation-banner">
            <strong>Cannot save flow:</strong>
            <ul>
                @foreach (var error in _validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
            <button class="btn btn-sm btn-outline" @onclick="() => _validationErrors.Clear()">Dismiss</button>
        </div>
    }

    <CascadingValue Value="Diagram">
        <CascadingValue Value="this">
            <DiagramCanvas></DiagramCanvas>
        </CascadingValue>
    </CascadingValue>

    <div class="zoom-controls">
        <button class="btn btn-icon" @onclick="ZoomIn" title="Zoom In">+</button>
        <button class="btn btn-icon" @onclick="ZoomOut" title="Zoom Out">-</button>
        <button class="btn btn-icon" @onclick="() => Diagram.ZoomToFit(10)" title="Fit to Screen">Fit</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(FlowState.Value.RunResult))
    {
        <div class="run-result-panel">
            <h4>Execution Result</h4>
            <div class="run-result">@FlowState.Value.RunResult</div>
            <button class="btn btn-outline btn-block run-result-dismiss" @onclick="ClearResult">Dismiss</button>
        </div>
    }
</div>

@if (_editingStep != null)
{
    <MapperModal @bind-IsVisible="_showMapperModal" Step="_editingStep" TargetProperty="@_editingProperty" />
}

<DebugJsonModal @bind-IsVisible="_showDebugJsonModal" JsonContent="@_debugJsonContent" ErrorMessage="@_debugJsonError" />

@if (_showFlowSettings && FlowState.Value.CurrentFlow != null)
{
    var settingsFlow = FlowState.Value.CurrentFlow;
    <div class="modal-overlay" @onclick="CloseFlowSettings">
        <div class="modal-container flow-settings-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Flow settings</h2>
                    <p class="modal-subtitle">@settingsFlow.Name</p>
                </div>
                <button class="modal-close-btn" @onclick="CloseFlowSettings" aria-label="Close">✕</button>
            </div>
            <div class="modal-body modal-body-scroll">
                <div class="form-group">
                    <label>Flow Status</label>
                    <select class="form-control" @bind="settingsFlow.Status">
                        <option value="Draft">Draft</option>
                        <option value="Active">Active</option>
                    </select>
                </div>
                @if (HasScheduleNode)
                {
                    <div class="form-group">
                        <label>Trigger Type</label>
                        <input type="text" class="form-control" readonly value="Schedule node" />
                        <small class="field-hint">@ScheduleNodeSummary</small>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label>Trigger Type</label>
                        <select class="form-control" value="@settingsFlow.TriggerType" @onchange="OnTriggerTypeChanged">
                            <option value="Manual">Manual</option>
                            <option value="Webhook">Webhook</option>
                            <option value="Cron">Cron</option>
                        </select>
                    </div>
                }

                @if (!HasScheduleNode && settingsFlow.TriggerType == "Cron")
                {
                    <div class="form-group">
                        <label>Cron Expression</label>
                        <input type="text" class="form-control" @bind="settingsFlow.CronExpression" @bind:event="oninput" @bind:after="RefreshCronPreview" placeholder="*/5 * * * *" />
                        <small class="field-hint">@CronPreviewDescription</small>
                    </div>
                    @if (_cronPreviewOccurrences.Count > 0)
                    {
                        <div class="form-group">
                            <label>Next runs</label>
                            <ul class="cron-preview-list">
                                @foreach (var fire in _cronPreviewOccurrences)
                                {
                                    <li class="text-muted">@fire.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</li>
                                }
                            </ul>
                        </div>
                    }
                }
                else if (!HasScheduleNode && settingsFlow.TriggerType == "Webhook")
                {
                    <div class="form-group">
                        <label>Webhook URL</label>
                        @if (!HasWebhookSecret)
                        {
                            <small class="field-hint">Save the flow to generate the webhook URL.</small>
                        }
                        else
                        {
                            <div class="input-with-action">
                                <input type="text" class="form-control" readonly value="@WebhookUrl" />
                                <button class="btn btn-outline" @onclick="CopyWebhookUrl">@(_webhookCopied ? "Copied!" : "Copy")</button>
                            </div>
                        }
                    </div>
                    <div class="form-group">
                        <button class="btn btn-outline" @onclick="RegenerateWebhookSecret" disabled="@(!HasWebhookSecret || FlowState.Value.IsLoading)">Regenerate Secret</button>
                        <small class="field-hint">The server issues the secret; regenerating invalidates the current URL immediately.</small>
                    </div>
                }

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="FlowState.Value.CurrentFlow!.AllowPostReplay" />
                        Allow POST steps to be replayed from the dead-letter queue
                    </label>
                    <small class="field-hint">POST requests are not idempotent — replaying one can duplicate its effect on the target system. Leave off unless the endpoint is safe to call twice.</small>
                </div>

                <div class="modal-actions">
                    <button class="btn btn-outline" @onclick="CloseFlowSettings">Close</button>
                    <button class="btn btn-primary" @onclick="SaveFlowSettings" disabled="@FlowState.Value.IsLoading">Save settings</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? FlowId { get; set; }

    public IEnumerable<ConnectionDto> AvailableConnections => _connections;

    [SupplyParameterFromQuery(Name = "integrationId")]
    public Guid? IntegrationIdQuery { get; set; }

    private BlazorDiagram Diagram { get; set; } = null!;
    private string FlowName { get; set; } = "New Flow";
    private bool _isLoaded;
    private bool _showMapperModal;
    private IntegrationStepDto? _editingStep;
    private string _editingProperty = "MappingCode";
    private bool _showDebugJsonModal;
    private string _debugJsonContent = string.Empty;
    private string _debugJsonError = string.Empty;
    private List<IntegrationDto> _integrations = new();
    private List<ConnectionDto> _connections = new();
    private bool _showFlowSettings;
    private bool _webhookCopied;
    private List<string> _validationErrors = new();
    private List<DateTime> _cronPreviewOccurrences = new();
    private string _cronPreviewDescription = string.Empty;
    private string _cronPreviewError = string.Empty;
    private bool _toolbarCollapsed;
    private bool _isFullscreen;
    private DotNetObjectReference<FlowDesigner>? _dotnetHelper;

    private string ToolbarClass => _toolbarCollapsed ? "diagram-toolbar collapsed" : "diagram-toolbar";
    private string ToolbarToggleLabel => _toolbarCollapsed ? "Show node panel" : "Hide node panel";
    private string CanvasContainerClass => _isFullscreen ? "diagram-container canvas-fullscreen" : "diagram-container";
    private string FullscreenLabel => _isFullscreen ? "Exit fullscreen" : "Enter fullscreen";

    private IEnumerable<IntegrationDto> AvailableIntegrations => _integrations;
    private string IntegrationValue => FlowState.Value.CurrentFlow?.IntegrationId?.ToString() ?? IntegrationIdQuery?.ToString() ?? string.Empty;

    public void OpenMapperModal(IntegrationStepDto step, string targetProperty)
    {
        _editingStep = step;
        _editingProperty = targetProperty;
        _showMapperModal = true;
        StateHasChanged();
    }

    public void OpenDebugJsonModal(string jsonContent, string errorMessage)
    {
        _debugJsonContent = jsonContent;
        _debugJsonError = errorMessage;
        _showDebugJsonModal = true;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        SetupDiagram();
        await LoadLookupsAsync();

        if (FlowId.HasValue)
        {
            Dispatcher.Dispatch(new LoadFlowAction { Id = FlowId.Value });
        }
        else
        {
            Dispatcher.Dispatch(new UpdateFlowStateAction
            {
                Flow = new IntegrationFlowDto
                {
                    Name = "New Flow",
                    IntegrationId = IntegrationIdQuery
                }
            });
            _isLoaded = true;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _dotnetHelper = DotNetObjectReference.Create(this);
            _ = InvokeAsync(async () =>
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("simpleIPaaSFullscreen.onFullScreenChange", _dotnetHelper);
                }
                catch (JSException)
                {
                }
            });
        }

        if (FlowState.Value.CurrentFlow == null)
        {
            return;
        }

        if (FlowId.HasValue && !_isLoaded && FlowState.Value.CurrentFlow.Id == FlowId)
        {
            FlowName = FlowState.Value.CurrentFlow.Name;
            LoadDiagramFromCurrentFlow();
            _isLoaded = true;
            StateHasChanged();
        }
    }

    private async Task LoadLookupsAsync()
    {
        _integrations = await Http.GetFromJsonAsync<List<IntegrationDto>>("api/integrations") ?? new List<IntegrationDto>();
        _connections = await Http.GetFromJsonAsync<List<ConnectionDto>>("api/connections") ?? new List<ConnectionDto>();
    }

    private void LoadDiagramFromCurrentFlow()
    {
        Diagram.Nodes.Clear();
        Diagram.Links.Clear();

        if (FlowState.Value.CurrentFlow == null)
        {
            return;
        }

        foreach (var step in FlowState.Value.CurrentFlow.Nodes)
        {
            var node = new IntegrationNodeModel(step) { Title = step.StepType };
            node.SetPosition(step.PositionX, step.PositionY);
            Diagram.Nodes.Add(node);
        }

        foreach (var edge in FlowState.Value.CurrentFlow.Edges)
        {
            var sourceNode = Diagram.Nodes.FirstOrDefault(node => ((IntegrationNodeModel)node).StepConfig.Id == edge.SourceNodeId) as IntegrationNodeModel;
            var targetNode = Diagram.Nodes.FirstOrDefault(node => ((IntegrationNodeModel)node).StepConfig.Id == edge.TargetNodeId) as IntegrationNodeModel;
            if (sourceNode == null || targetNode == null)
            {
                continue;
            }

            var sourcePort = sourceNode.Ports.FirstOrDefault(port => port.Id == edge.SourcePortId);
            var targetPort = targetNode.Ports.FirstOrDefault(port => port.Id == edge.TargetPortId);
            if (sourcePort != null && targetPort != null)
            {
                Diagram.Links.Add(new LinkModel(sourcePort, targetPort));
            }
        }
    }

    private void SetupDiagram()
    {
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = true,
            Zoom =
            {
                Enabled = true,
                ScaleFactor = 1.1
            },
            Links =
            {
                DefaultRouter = new NormalRouter(),
                DefaultPathGenerator = new SmoothPathGenerator()
            }
        };

        Diagram = new BlazorDiagram(options);
        Diagram.RegisterComponent<IntegrationNodeModel, IntegrationNodeWidget>();
    }

    private void AddNode(StepType type)
    {
        var step = new IntegrationStepDto
        {
            StepType = type.ToString(),
            UrlMode = "Manual"
        };
        var node = new IntegrationNodeModel(step) { Title = type.ToString() };
        Diagram.Nodes.Add(node);
    }

    private void SaveFlow()
    {
        SaveFlow(false);
    }

    private void SaveFlow(bool runAfterSave)
    {
        if (FlowState.Value.CurrentFlow == null)
        {
            return;
        }

        _validationErrors = ValidateDiagram();
        if (_validationErrors.Any())
        {
            return;
        }

        var flow = FlowState.Value.CurrentFlow;
        flow.Name = FlowName;
        flow.IntegrationId = GetSelectedIntegrationId();
        flow.Nodes.Clear();
        flow.Edges.Clear();

        foreach (var node in Diagram.Nodes.OfType<IntegrationNodeModel>())
        {
            var step = node.StepConfig;
            step.PositionX = node.Position.X;
            step.PositionY = node.Position.Y;
            flow.Nodes.Add(step);
        }

        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            var sourcePort = link.Source.Model as PortModel;
            var targetPort = link.Target.Model as PortModel;
            if (sourcePort?.Parent is not IntegrationNodeModel sourceNode || targetPort?.Parent is not IntegrationNodeModel targetNode)
            {
                continue;
            }

            flow.Edges.Add(new IntegrationEdgeDto
            {
                SourceNodeId = sourceNode.StepConfig.Id,
                TargetNodeId = targetNode.StepConfig.Id,
                SourcePortId = sourcePort.Id,
                TargetPortId = targetPort.Id
            });
        }

        ApplyScheduleTrigger(flow);

        Dispatcher.Dispatch(new SaveFlowAction { Flow = flow, RunAfterSave = runAfterSave });
    }

    private void RunFlow()
    {
        SaveFlow(true);
    }

    private void ClearResult()
    {
        Dispatcher.Dispatch(new RunFlowResultAction { Result = string.Empty });
    }

    private void OnIntegrationChanged(ChangeEventArgs args)
    {
        if (FlowState.Value.CurrentFlow == null)
        {
            return;
        }

        if (Guid.TryParse(args.Value?.ToString(), out var integrationId))
        {
            FlowState.Value.CurrentFlow.IntegrationId = integrationId;
        }
        else
        {
            FlowState.Value.CurrentFlow.IntegrationId = null;
        }
    }

    private Guid? GetSelectedIntegrationId()
    {
        if (FlowState.Value.CurrentFlow?.IntegrationId != null)
        {
            return FlowState.Value.CurrentFlow.IntegrationId;
        }

        return IntegrationIdQuery;
    }

    private void ZoomIn() => Diagram.SetZoom(Diagram.Zoom * 1.2);
    private void ZoomOut() => Diagram.SetZoom(Diagram.Zoom / 1.2);

    private void ToggleToolbar()
    {
        _toolbarCollapsed = !_toolbarCollapsed;
    }

    private async Task ToggleFullscreen()
    {
        try
        {
            var isEnabled = await JSRuntime.InvokeAsync<bool>("simpleIPaaSFullscreen.isEnabled");
            if (!isEnabled)
            {
                return;
            }

            if (_isFullscreen)
            {
                await JSRuntime.InvokeVoidAsync("simpleIPaaSFullscreen.exit");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("simpleIPaaSFullscreen.enter", ".diagram-container");
            }
        }
        catch (JSException)
        {
        }
    }

    [JSInvokable]
    public async void NotifyFullscreenChange()
    {
        await InvokeAsync(async () =>
        {
            try
            {
                _isFullscreen = await JSRuntime.InvokeAsync<bool>("simpleIPaaSFullscreen.isActive");
            }
            catch (JSException)
            {
            }
            StateHasChanged();
        });
    }

    private void DeleteSelectedNodes()
    {
        var selectedNodes = Diagram.Nodes.OfType<IntegrationNodeModel>().Where(node => node.Selected).ToList();
        foreach (var node in selectedNodes)
        {
            var attachedLinks = Diagram.Links.OfType<LinkModel>()
                .Where(link => (link.Source.Model as PortModel)?.Parent == node || (link.Target.Model as PortModel)?.Parent == node)
                .ToList();
            foreach (var link in attachedLinks)
            {
                Diagram.Links.Remove(link);
            }

            Diagram.Nodes.Remove(node);
        }
    }

    private List<string> ValidateDiagram()
    {
        var errors = new List<string>();
        var nodes = Diagram.Nodes.OfType<IntegrationNodeModel>().ToList();

        if (!nodes.Any())
        {
            errors.Add("The flow must contain at least one node.");
            return errors;
        }

        var duplicateNames = nodes
            .Select(node => string.IsNullOrWhiteSpace(node.StepConfig.NodeName) ? node.StepConfig.StepType : node.StepConfig.NodeName)
            .GroupBy(name => name, StringComparer.OrdinalIgnoreCase)
            .Where(group => group.Count() > 1)
            .Select(group => group.Key)
            .ToList();
        foreach (var name in duplicateNames)
        {
            errors.Add($"Duplicate node name '{name}' — node names must be unique.");
        }

        var nodeIds = nodes.Select(node => node.StepConfig.Id).ToHashSet();
        var adjacency = nodeIds.ToDictionary(id => id, _ => new List<Guid>());
        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            var sourceNode = (link.Source.Model as PortModel)?.Parent as IntegrationNodeModel;
            var targetNode = (link.Target.Model as PortModel)?.Parent as IntegrationNodeModel;
            if (sourceNode == null || targetNode == null ||
                !nodeIds.Contains(sourceNode.StepConfig.Id) || !nodeIds.Contains(targetNode.StepConfig.Id))
            {
                errors.Add("An edge references a node that no longer exists on the canvas.");
                continue;
            }

            adjacency[sourceNode.StepConfig.Id].Add(targetNode.StepConfig.Id);
        }

        if (HasCycle(adjacency))
        {
            errors.Add("The flow contains a cycle — flows must be acyclic.");
        }

        return errors;
    }

    private static bool HasCycle(Dictionary<Guid, List<Guid>> adjacency)
    {
        var visiting = new HashSet<Guid>();
        var visited = new HashSet<Guid>();

        bool Visit(Guid nodeId)
        {
            if (visiting.Contains(nodeId))
            {
                return true;
            }

            if (!visited.Add(nodeId))
            {
                return false;
            }

            visiting.Add(nodeId);
            foreach (var next in adjacency[nodeId])
            {
                if (Visit(next))
                {
                    return true;
                }
            }

            visiting.Remove(nodeId);
            return false;
        }

        return adjacency.Keys.Any(Visit);
    }

    private async Task OpenFlowSettings()
    {
        _webhookCopied = false;
        _showFlowSettings = true;
        await RefreshCronPreview();
    }

    private void CloseFlowSettings()
    {
        _showFlowSettings = false;
    }

    private void SaveFlowSettings()
    {
        SaveFlow(false);
        if (!_validationErrors.Any())
        {
            _showFlowSettings = false;
        }
    }

    private async Task OnTriggerTypeChanged(ChangeEventArgs args)
    {
        var flow = FlowState.Value.CurrentFlow;
        if (flow == null)
        {
            return;
        }

        flow.TriggerType = args.Value?.ToString() ?? "Manual";
        flow.RunAt = null;
        _webhookCopied = false;
        await RefreshCronPreview();
    }

    private async Task RegenerateWebhookSecret()
    {
        var flow = FlowState.Value.CurrentFlow;
        if (flow == null || flow.Id == Guid.Empty)
        {
            return;
        }

        _webhookCopied = false;

        var response = await Http.PostAsync($"api/integrationflow/{flow.Id}/webhook-secret", null);
        if (response.IsSuccessStatusCode)
        {
            var updated = await response.Content.ReadFromJsonAsync<IntegrationFlowDto>();
            if (updated != null)
            {
                flow.WebhookSecret = updated.WebhookSecret;
            }
        }
    }

    private bool HasWebhookSecret
    {
        get
        {
            var flow = FlowState.Value.CurrentFlow;
            return flow != null && flow.Id != Guid.Empty && !string.IsNullOrWhiteSpace(flow.WebhookSecret);
        }
    }

    private string WebhookUrl
    {
        get
        {
            var flow = FlowState.Value.CurrentFlow;
            if (flow == null || flow.Id == Guid.Empty || string.IsNullOrWhiteSpace(flow.WebhookSecret))
            {
                return string.Empty;
            }

            var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? string.Empty;
            return $"{baseUrl}/api/webhooks/{flow.Id}/{flow.WebhookSecret}";
        }
    }

    private async Task CopyWebhookUrl()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", WebhookUrl);
        _webhookCopied = true;
    }

    private async Task RefreshCronPreview()
    {
        _cronPreviewOccurrences = new List<DateTime>();
        _cronPreviewDescription = string.Empty;
        _cronPreviewError = string.Empty;

        var expression = FlowState.Value.CurrentFlow?.CronExpression ?? string.Empty;
        if (string.IsNullOrWhiteSpace(expression))
        {
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/integrationflow/cron-preview", new CronPreviewRequestDto
            {
                CronExpression = expression,
                Count = 3
            });

            if (!response.IsSuccessStatusCode)
            {
                _cronPreviewError = "Invalid cron expression.";
                return;
            }

            var preview = await response.Content.ReadFromJsonAsync<CronPreviewResponseDto>();
            if (preview == null)
            {
                return;
            }

            _cronPreviewDescription = preview.Description;
            _cronPreviewOccurrences = preview.NextOccurrences;
        }
        catch (HttpRequestException)
        {
            _cronPreviewError = "Could not reach the server to preview this schedule.";
        }
    }

    private string CronPreviewDescription
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_cronPreviewError))
            {
                return _cronPreviewError;
            }

            return string.IsNullOrWhiteSpace(_cronPreviewDescription)
                ? "Enter a cron expression — 5 fields, or 6 to include seconds."
                : _cronPreviewDescription;
        }
    }

    private IntegrationStepDto? ScheduleStep => Diagram?.Nodes
        .OfType<IntegrationNodeModel>()
        .Select(node => node.StepConfig)
        .FirstOrDefault(step => step.StepType == StepType.Schedule.ToString());

    private bool HasScheduleNode => ScheduleStep != null;

    private string ScheduleNodeSummary
    {
        get
        {
            var schedule = ScheduleStep;
            if (schedule == null)
            {
                return string.Empty;
            }

            var name = string.IsNullOrWhiteSpace(schedule.NodeName) ? "Schedule" : schedule.NodeName;

            if (ReadScheduleValue(schedule, "mode") == "OneTime")
            {
                return TryReadScheduleRunAt(schedule, out var runAt)
                    ? $"The '{name}' node owns this trigger — one-time run at {runAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)}. Edit it on the canvas."
                    : $"The '{name}' node owns this trigger — no run time set yet. Edit it on the canvas.";
            }

            var expression = ReadScheduleValue(schedule, "cronExpression");
            return string.IsNullOrWhiteSpace(expression)
                ? $"The '{name}' node owns this trigger — no cron expression set yet. Edit it on the canvas."
                : $"The '{name}' node owns this trigger — recurring '{expression}'. Edit it on the canvas.";
        }
    }

    private void ApplyScheduleTrigger(IntegrationFlowDto flow)
    {
        var schedule = ScheduleStep;
        if (schedule == null)
        {
            return;
        }

        flow.TriggerType = "Cron";

        if (ReadScheduleValue(schedule, "mode") == "OneTime")
        {
            flow.CronExpression = string.Empty;
            flow.RunAt = TryReadScheduleRunAt(schedule, out var runAt) ? runAt : null;
            return;
        }

        flow.CronExpression = ReadScheduleValue(schedule, "cronExpression");
        flow.RunAt = null;
    }

    private static bool TryReadScheduleRunAt(IntegrationStepDto step, out DateTime runAtUtc)
    {
        return DateTime.TryParse(
            ReadScheduleValue(step, "runAtUtc"),
            CultureInfo.InvariantCulture,
            DateTimeStyles.AdjustToUniversal | DateTimeStyles.AssumeUniversal,
            out runAtUtc);
    }

    private static string ReadScheduleValue(IntegrationStepDto step, string key)
    {
        if (string.IsNullOrWhiteSpace(step.StepConfig))
        {
            return string.Empty;
        }

        try
        {
            var schedule = JsonNode.Parse(step.StepConfig)?["schedule"] as JsonObject;
            return schedule?[key]?.GetValue<string>() ?? string.Empty;
        }
        catch (JsonException)
        {
            return string.Empty;
        }
    }

    public enum StepType
    {
        HttpAction,
        Mapping,
        Branch,
        Debug,
        PersistedState,
        Schedule,
         CrossReferenceStore,
        CrossReferenceFilter,
        ForEach
    }

    public void Dispose()
    {
        _dotnetHelper?.Dispose();
        _dotnetHelper = null;
    }
}
