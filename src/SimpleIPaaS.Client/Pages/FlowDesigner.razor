    private IntegrationFlowDto? CaptureCurrentDraft()
    {
        var current = FlowState.Value.CurrentFlow;
        if (current == null) return null;

        var snapshot = JsonSerializer.Deserialize<IntegrationFlowDto>(JsonSerializer.Serialize(current));
        if (snapshot == null) return null;
        snapshot.Name = FlowName;
        snapshot.IntegrationId = GetSelectedIntegrationId();
        snapshot.Nodes = Diagram.Nodes.OfType<IntegrationNodeModel>()
            .Select(node => JsonSerializer.Deserialize<IntegrationStepDto>(JsonSerializer.Serialize(node.StepConfig))!)
            .ToList();
        snapshot.Edges = new List<IntegrationEdgeDto>();

        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            var sourcePort = link.Source.Model as PortModel;
            var targetPort = link.Target.Model as PortModel;
            if (sourcePort?.Parent is not IntegrationNodeModel sourceNode || targetPort?.Parent is not IntegrationNodeModel targetNode)
                continue;
            var previous = current.Edges.FirstOrDefault(edge => edge.SourceNodeId == sourceNode.StepConfig.Id &&
                edge.TargetNodeId == targetNode.StepConfig.Id && edge.SourcePortId == sourcePort.Id && edge.TargetPortId == targetPort.Id);
            snapshot.Edges.Add(new IntegrationEdgeDto
            {
                Id = previous?.Id ?? Guid.NewGuid(),
                SourceNodeId = sourceNode.StepConfig.Id,
                TargetNodeId = targetNode.StepConfig.Id,
                SourcePortId = sourcePort.Id,
                TargetPortId = targetPort.Id,
                Condition = previous?.Condition ?? string.Empty,
                Order = previous?.Order ?? 0
            });
        }
        return snapshot;
    }

    private Task ApplyAiFlowDraftAsync(AiFlowBuildResponseDto result)
    {
        _validationErrors.Clear();
        FlowName = result.Flow.Name;
        if (string.IsNullOrWhiteSpace(result.Flow.HelperCode) && FlowState.Value.CurrentFlow != null)
        {
            // An AI draft may omit the helper prelude; never drop what the flow already had.
            result.Flow.HelperCode = FlowState.Value.CurrentFlow.HelperCode;
        }
        Dispatcher.Dispatch(new UpdateFlowStateAction { Flow = result.Flow });
        LoadDiagramFromCurrentFlow();
        _isLoaded = true;
        StateHasChanged();
        return Task.CompletedTask;
    }
    private void SaveFlow()
    {
        SaveFlow(false);
    }

    private void SaveFlow(bool runAfterSave)
    {
        if (FlowState.Value.CurrentFlow == null)
        {
            return;
        }

        _validationErrors = ValidateDiagram();
        if (_validationErrors.Any())
        {
            return;
        }

        var flow = CaptureDiagramIntoFlow();
        ApplyScheduleTrigger(flow);
        _flowBeforeSave = FlowState.Value.CurrentFlow;
        _awaitingSaveBaseline = true;

        Dispatcher.Dispatch(new SaveFlowAction
        {
            Flow = flow,
            RunAfterSave = runAfterSave,
            ChatSessionId = ChatSessionIdQuery
        });
    }

    // Copies the live canvas into the flow DTO the save and debug paths both persist. Positions are
    // read from the diagram nodes because they change without touching StepConfig.
    private IntegrationFlowDto CaptureDiagramIntoFlow()
    {
        var flow = FlowState.Value.CurrentFlow!;
        if (flow.DefaultDeadLetterResyncStepId is Guid selectedNodeId && !Diagram.Nodes.OfType<IntegrationNodeModel>().Any(node => node.StepConfig.Id == selectedNodeId))
        {
            flow.DefaultDeadLetterResyncStepId = null;
        }

        flow.Name = FlowName;
        flow.IntegrationId = GetSelectedIntegrationId();

        // Capture the stored edges before clearing: a redrawn edge must keep its identity, otherwise
        // every save mints new edge ids. That made an untouched flow look modified to the publish
        // comparison, appended a version that carried no real change, and churned the edge rows.
        var previousEdges = flow.Edges
            .GroupBy(edge => (edge.SourceNodeId, edge.TargetNodeId, edge.SourcePortId, edge.TargetPortId))
            .ToDictionary(group => group.Key, group => group.First());

        flow.Nodes.Clear();
        flow.Edges.Clear();

        foreach (var node in Diagram.Nodes.OfType<IntegrationNodeModel>())
        {
            var step = node.StepConfig;
            step.PositionX = node.Position.X;
            step.PositionY = node.Position.Y;
            flow.Nodes.Add(step);
        }

        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            var sourcePort = link.Source.Model as PortModel;
            var targetPort = link.Target.Model as PortModel;
            if (sourcePort?.Parent is not IntegrationNodeModel sourceNode || targetPort?.Parent is not IntegrationNodeModel targetNode)
            {
                continue;
            }

            var key = (sourceNode.StepConfig.Id, targetNode.StepConfig.Id, sourcePort.Id, targetPort.Id);
            previousEdges.TryGetValue(key, out var previous);

            flow.Edges.Add(new IntegrationEdgeDto
            {
                Id = previous?.Id ?? Guid.NewGuid(),
                SourceNodeId = key.Item1,
                TargetNodeId = key.Item2,
                SourcePortId = key.Item3,
                TargetPortId = key.Item4,
                Condition = previous?.Condition ?? string.Empty,
                Order = previous?.Order ?? 0
            });
        }

        return flow;
    }

    private void RunFlow()
    {
        SaveFlow(true);
    }

    // ── Debug Mode ───────────────────────────────────────────────────────────────
    // A debug session never enqueues a run: each card is executed on its own, in the order the
    // operator clicks them, and the accumulated upstream outputs travel with the request so a node
    // sees exactly the input a production run would have handed it.

    private async Task ToggleDebugModeAsync()
    {
        if (_debugMode)
        {
            ExitDebugMode();
            return;
        }

        _validationErrors = ValidateDiagram();
        if (_validationErrors.Any())
        {
            return;
        }

        // Debug execution resolves nodes by the ids the server stored, so the canvas has to be
        // persisted before the first Run button can work.
        var flow = CaptureDiagramIntoFlow();
        if (flow.Id == Guid.Empty)
        {
            _validationErrors = new List<string> { "Save the flow before entering Debug Mode." };
            return;
        }

        _debugBusy = true;
        StateHasChanged();
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/integrationflow/{flow.Id}", flow);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _validationErrors = new List<string>
                {
                    string.IsNullOrWhiteSpace(body) ? "The flow could not be saved for debugging." : body
                };
                return;
            }

            var saved = await response.Content.ReadFromJsonAsync<IntegrationFlowDto>();
            if (saved != null)
            {
                Dispatcher.Dispatch(new UpdateFlowStateAction { Flow = saved });
            }

            _debugMode = true;
            ResetDebugSession();
        }
        catch (Exception)
        {
            _validationErrors = new List<string> { "Could not reach the API to save the flow for debugging." };
        }
        finally
        {
            _debugBusy = false;
            StateHasChanged();
        }
    }

    private void ExitDebugMode()
    {
        _debugMode = false;
        _debugInspectorNodeId = null;
        _debugInspectorLogs = new();
        _debugInspectorLogsError = null;
        _debugSessions.Clear();
        _debugGraph = null;
        _debugPersistedStateJson = "{}";
        ClearDebugLinkHighlight();
        foreach (var node in Diagram.Nodes.OfType<IntegrationNodeModel>())
        {
            node.IsDebugMode = false;
            node.DebugRunnable = false;
            node.DebugState = DebugNodeState.Idle;
            node.DebugRun = null;
            node.DebugSupply = null;
            node.DebugViewLogs = null;
            node.Refresh();
        }

        StateHasChanged();
    }

    private void ResetDebugSession()
    {
        _debugSessions.Clear();
        _debugInspectorNodeId = null;
        _debugInspectorLogs = new();
        _debugInspectorLogsError = null;
        _debugPersistedStateJson = FlowState.Value.CurrentFlow?.PersistedStateJson ?? "{}";
        _debugSequence = 0;
        ClearDebugLinkHighlight();

        var nodes = Diagram.Nodes.OfType<IntegrationNodeModel>().ToList();
        var nodeIds = nodes.Select(node => node.StepConfig.Id);
        var edges = Diagram.Links.OfType<LinkModel>()
            .Select(link => (link.Source.Model as PortModel, link.Target.Model as PortModel))
            .Where(pair => pair.Item1?.Parent is IntegrationNodeModel && pair.Item2?.Parent is IntegrationNodeModel)
            .Select(pair => new DebugGraph.DebugEdge(
                ((IntegrationNodeModel)pair.Item1!.Parent!).StepConfig.Id,
                ((IntegrationNodeModel)pair.Item2!.Parent!).StepConfig.Id,
                pair.Item1!.Id,
                pair.Item2!.Id))
            .ToList();

        _debugGraph = DebugGraph.Build(nodeIds, edges);

        foreach (var node in nodes)
        {
            node.IsDebugMode = true;
            node.DebugState = DebugNodeState.Idle;
            node.DebugRun = node_ => RunDebugNodeAsync(node_);
            node.DebugSupply = node_ => OpenDebugSupplyAsync(node_);
            node.DebugViewLogs = node_ => OpenDebugInspectorAsync(node_);
            _debugSessions[node.StepConfig.Id] = new DebugNodeSession
            {
                NodeId = node.StepConfig.Id,
                NodeName = DebugNodeLabel(node)
            };
        }

        RefreshDebugRunnability();
    }

    private void RefreshDebugRunnability()
    {
        if (_debugGraph == null)
        {
            return;
        }

        foreach (var node in Diagram.Nodes.OfType<IntegrationNodeModel>())
        {
            var nodeId = node.StepConfig.Id;
            if (!_debugSessions.TryGetValue(nodeId, out var session))
            {
                continue;
            }

            var incoming = _debugGraph.Incoming.TryGetValue(nodeId, out var edges) ? edges : new List<DebugGraph.DebugEdge>();

            // The widget renders the node, so execution state has to land on the node as well as in
            // the session. Projecting it here (the single place every state change funnels through)
            // is what makes the badge and the View Logs button appear.
            node.ApplyDebugSession(session);
            node.DebugRunnable = DebugSessionRules.IsRunnable(session, incoming, _debugSessions);
            node.Refresh();
        }

        HighlightDebugActiveEdges();
    }

    private void ClearDebugLinkHighlight()
    {
        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            link.Color = null;
            link.Width = 1.5;
        }
    }

    private async Task MarkHttpErrorLinksAsync()
    {
        var errorLinkIds = Diagram.Links.OfType<LinkModel>()
            .Where(link => DiagramPortLayout.IsErrorPort((link.Source.Model as PortModel)?.Id))
            .Select(link => link.Id)
            .ToArray();
        try
        {
            await JSRuntime.InvokeVoidAsync("simpleIPaaSDesigner.markHttpErrorLinks", (object)errorLinkIds);
        }
        catch (JSException)
        {
        }
    }

    // LinkModel.Color is only a presentation attribute, and app.css intentionally styles
    // .diagram-link path with !important for theme-aware default edges. Set the highlighted
    // strokes inline with priority so Debug Mode actually renders them.
    private async Task ApplyDebugLinkStylesAsync()
    {
        if (!_debugMode || _debugGraph == null)
        {
            return;
        }

        var active = new List<string>();
        var dimmed = new List<string>();
        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            if ((link.Source.Model as PortModel)?.Parent is not IntegrationNodeModel source)
                continue;
            if (!_debugSessions.TryGetValue(source.StepConfig.Id, out var session)
                || session.State is not (DebugNodeState.Success or DebugNodeState.Supplied))
                continue;

            var sourcePortId = ((PortModel)link.Source.Model).Id;
            if (!string.IsNullOrEmpty(session.ActivePortId)
                && !string.Equals(session.ActivePortId, sourcePortId, StringComparison.OrdinalIgnoreCase))
            {
                dimmed.Add(link.Id);
            }
            else
            {
                active.Add(link.Id);
            }
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("simpleIPaaSDesigner.applyLinkStyles", active.ToArray(), dimmed.ToArray());
        }
        catch (JSException)
        {
        }
    }

    // The same active-path treatment used by test runs, driven by Debug Mode's session state.
    private void HighlightDebugActiveEdges()
    {
        ClearDebugLinkHighlight();
        if (!_debugMode) return;

        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            if ((link.Source.Model as PortModel)?.Parent is not IntegrationNodeModel source)
                continue;
            if (!_debugSessions.TryGetValue(source.StepConfig.Id, out var session)
                || session.State is not (DebugNodeState.Success or DebugNodeState.Supplied))
                continue;
            if (!string.IsNullOrEmpty(session.ActivePortId)
                && !string.Equals(session.ActivePortId, ((PortModel)link.Source.Model).Id, StringComparison.OrdinalIgnoreCase))
            {
                // The Branch took the other port: keep its skipped edge visible but clearly dimmed.
                link.Color = "#94a3b8";
                link.Width = 1.5;
                continue;
            }

            link.Color = "#6366f1";
            link.Width = 4;
        }
    }

    private async Task FocusDebugBranchAsync(Guid branchId)
    {
        var branch = Diagram.Nodes.OfType<IntegrationNodeModel>().FirstOrDefault(node => node.StepConfig.Id == branchId);
        if (branch == null) return;

        var related = new List<IntegrationNodeModel> { branch };
        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            if ((link.Source.Model as PortModel)?.Parent is not IntegrationNodeModel source
                || source.StepConfig.Id != branchId
                || (link.Target.Model as PortModel)?.Parent is not IntegrationNodeModel target)
                continue;
            if (!related.Contains(target)) related.Add(target);
        }

        var viewport = await GetCanvasViewportAsync();
        if (viewport is not { Length: >= 2 } || viewport[0] <= 0 || viewport[1] <= 0) return;

        double Width(IntegrationNodeModel node) => node.Size is { Width: > 0 } ? node.Size.Width : 220;
        double Height(IntegrationNodeModel node) => node.Size is { Height: > 0 } ? node.Size.Height : 100;
        var minX = related.Min(node => node.Position.X);
        var minY = related.Min(node => node.Position.Y);
        var contentWidth = Math.Max(1, related.Max(node => node.Position.X + Width(node)) - minX);
        var contentHeight = Math.Max(1, related.Max(node => node.Position.Y + Height(node)) - minY);

        var topInset = viewport.Length > 2 && viewport[2] > 0 ? viewport[2] + 24 : 80;
        var leftInset = viewport.Length > 3 && viewport[3] > 0 ? viewport[3] + 18 : 20;
        var availableWidth = Math.Max(180, viewport[0] - leftInset - 24);
        var availableHeight = Math.Max(160, viewport[1] - topInset - 24);
        var zoom = Math.Clamp(Math.Min(availableWidth / contentWidth, availableHeight / contentHeight), 0.35, 0.55);

        Diagram.SetZoom(zoom);
        Diagram.SetPan(
            leftInset + Math.Max(0, (availableWidth - contentWidth * zoom) / 2) - minX * zoom,
            topInset + Math.Max(0, (availableHeight - contentHeight * zoom) / 2) - minY * zoom);
        Diagram.SelectModel(branch, true);
    }

    private static string DebugNodeLabel(IntegrationNodeModel node) =>
        string.IsNullOrWhiteSpace(node.StepConfig.NodeName) ? node.StepConfig.StepType : node.StepConfig.NodeName;

    private async Task RunDebugNodeAsync(IntegrationNodeModel node)
    {
        if (!_debugMode || _debugBusy || _debugGraph == null)
        {
            return;
        }

        var flow = FlowState.Value.CurrentFlow;
        var session = _debugSessions[node.StepConfig.Id];
        if (flow == null || flow.Id == Guid.Empty || session.State == DebugNodeState.Running)
        {
            return;
        }

        // Re-running an upstream card invalidates everything below it so a downstream card can never
        // be run against output the operator has already replaced.
        InvalidateDownstream(node.StepConfig.Id);

        session.State = DebugNodeState.Running;
        session.Input = null;
        session.Output = null;
        session.Error = null;
        session.ActivePortId = null;
        _debugBusy = true;
        RefreshDebugRunnability();
        StateHasChanged();

        await Task.Yield();

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/integrationflow/{flow.Id}/debug/{node.StepConfig.Id}",
                new DebugNodeRunRequestDto
                {
                    FlowStateJson = BuildDebugFlowState(node.StepConfig.Id),
                    PersistedStateJson = _debugPersistedStateJson
                });

            if (!response.IsSuccessStatusCode)
            {
                session.State = DebugNodeState.Error;
                session.Error = string.IsNullOrWhiteSpace(await response.Content.ReadAsStringAsync())
                    ? "The step could not be executed."
                    : await response.Content.ReadAsStringAsync();
            }
            else
            {
                var result = await response.Content.ReadFromJsonAsync<DebugNodeRunResultDto>();
                if (result == null)
                {
                    session.State = DebugNodeState.Error;
                    session.Error = "The API returned an empty result.";
                }
                else
                {
                    session.State = string.Equals(result.Status, "Success", StringComparison.OrdinalIgnoreCase)
                        ? DebugNodeState.Success
                        : DebugNodeState.Error;
                    session.Input = result.Input;
                    session.Output = result.Output;
                    session.Error = string.IsNullOrWhiteSpace(result.Error) ? null : result.Error;
                    session.DurationMs = result.DurationMs;
                    session.ExecutionId = result.ExecutionId;
                    session.StepExecutionId = result.StepExecutionId;
                    session.ActivePortId = node.StepConfig.StepType == "Branch"
                        ? BranchPort(result.BranchResult)
                        : node.StepConfig.StepType == "HttpAction" && result.ErrorPort ? "error" : null;
                    if (node.StepConfig.StepType == "PersistedState" && !string.IsNullOrWhiteSpace(result.Output))
                        _debugPersistedStateJson = result.Output;
                }
            }
        }
        catch (Exception)
        {
            session.State = DebugNodeState.Error;
            session.Error = "Could not reach the API to run this step.";
        }
        finally
        {
            session.CompletedAtUtc = DateTime.UtcNow;
            session.Sequence = ++_debugSequence;
            _debugBusy = false;
        }

        RefreshDebugRunnability();
        if (_debugInspectorNodeId == node.StepConfig.Id)
        {
            LoadDebugInspectorLogsAsync();
        }

        StateHasChanged();
    }

    private static string BranchPort(bool branchResult) => branchResult ? "true" : "false";

    private void InvalidateDownstream(Guid nodeId)
    {
        if (_debugGraph == null)
        {
            return;
        }

        foreach (var descendantId in _debugGraph.Descendants(nodeId))
        {
            if (!_debugSessions.TryGetValue(descendantId, out var session))
            {
                continue;
            }

            session.State = DebugNodeState.Idle;
            session.Input = null;
            session.Output = null;
            session.Error = null;
            session.DurationMs = 0;
            session.ExecutionId = null;
            session.StepExecutionId = null;
            session.ActivePortId = null;
        }
    }

    // Only executed, not-yet-invalidated cards contribute their output. A card is keyed by its node
    // name, exactly like the production executor writes flowStateContext.
    private string BuildDebugFlowState(Guid currentNodeId)
    {
        var state = new Dictionary<string, object?>();
        foreach (var session in DebugStateOrdering.Ordered(_debugSessions.Values, currentNodeId))
            state[session.NodeName] = ParsePayload(session.Output!);
        return JsonSerializer.Serialize(state, DebugJsonOptions);
    }

    private static readonly JsonSerializerOptions DebugJsonOptions = new()
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };

    private string BuildDebugStateSnapshot()
    {
        var state = new Dictionary<string, object?>();
        foreach (var session in DebugStateOrdering.Ordered(_debugSessions.Values))
            state[session.NodeName] = ParsePayload(session.Output!);
        return JsonSerializer.Serialize(state, DebugJsonOptions);
    }

    private static object? ParsePayload(string payload)
    {
        try
        {
            return JsonSerializer.Deserialize<JsonElement>(payload);
        }
        catch (JsonException)
        {
            return payload;
        }
    }

    private static string PrettyJson(string? payload)
    {
        if (string.IsNullOrWhiteSpace(payload)) return "{}";
        try
        {
            using var document = JsonDocument.Parse(payload);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
        }
        catch (JsonException)
        {
            return payload;
        }
    }

    private string DebugSupplyStepType =>
        _debugSupplyNodeId is Guid nodeId
            ? FlowState.Value.CurrentFlow?.Nodes.FirstOrDefault(node => node.Id == nodeId)?.StepType ?? string.Empty
            : string.Empty;

    private Task OpenDebugSupplyAsync(IntegrationNodeModel node)
    {
        _debugSupplyNodeId = node.StepConfig.Id;
        _debugSupplyNodeName = DebugNodeLabel(node);
        _debugSupplyError = null;
        _debugSupplyBranchResult = !_debugSessions.TryGetValue(node.StepConfig.Id, out var existing)
            || !string.Equals(existing.ActivePortId, "false", StringComparison.OrdinalIgnoreCase);
        _debugSupplyHttpError = node.StepConfig.StepType == "HttpAction"
            && node.StepConfig.HttpErrorMode == "Continue"
            && string.Equals(existing?.ActivePortId, "error", StringComparison.OrdinalIgnoreCase);
        _debugSupplyJson = _debugSupplyHttpError
            ? BuildHttpErrorSupplyEnvelope()
            : !string.IsNullOrWhiteSpace(existing?.Output)
                ? PrettyJson(existing.Output)
                : node.StepConfig.StepType is "ForEach" or "FanOut" ? "[]" : "{}";
        _showDebugSupplyModal = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OnDebugSupplyJsonChanged(string value) => _debugSupplyJson = value;

    private void SetDebugSupplyHttpMode(bool error)
    {
        _debugSupplyHttpError = error;
        _debugSupplyJson = error ? BuildHttpErrorSupplyEnvelope() : "{}";
        _debugSupplyError = null;
    }

    private static string BuildHttpErrorSupplyEnvelope() =>
        """{"ok":false,"statusCode":400,"error":"HTTP request failed with status code 400","body":{},"headers":{}}""";

    private void CloseDebugSupply()
    {
        _showDebugSupplyModal = false;
        _debugSupplyError = null;
        StateHasChanged();
    }

    private async Task ConfirmDebugSupplyAsync()
    {
        if (_debugSupplyNodeId is not Guid nodeId) return;
        var node = Diagram.Nodes.OfType<IntegrationNodeModel>().FirstOrDefault(item => item.StepConfig.Id == nodeId);
        if (node == null) return;

        string output;
        if (node.StepConfig.StepType == "Branch")
        {
            output = _debugSupplyBranchResult ? "true" : "false";
        }
        else
        {
            try
            {
                using var document = JsonDocument.Parse(string.IsNullOrWhiteSpace(_debugSupplyJson) ? "{}" : _debugSupplyJson);
                if (node.StepConfig.StepType is "ForEach" or "FanOut" && document.RootElement.ValueKind != JsonValueKind.Array)
                {
                    _debugSupplyError = $"{node.StepConfig.StepType} needs a JSON array.";
                    return;
                }
                output = JsonSerializer.Serialize(document.RootElement);
            }
            catch (JsonException ex)
            {
                _debugSupplyError = ErrorText.Describe(ex);
                return;
            }
        }

        InvalidateDownstream(nodeId);
        if (!_debugSessions.TryGetValue(nodeId, out var session))
        {
            session = new DebugNodeSession { NodeId = nodeId, NodeName = DebugNodeLabel(node) };
            _debugSessions[nodeId] = session;
        }
        session.State = DebugNodeState.Supplied;
        session.Output = output;
        session.Error = null;
        session.DurationMs = 0;
        session.ExecutionId = null;
        session.StepExecutionId = null;
        session.CompletedAtUtc = DateTime.UtcNow;
        session.ActivePortId = node.StepConfig.StepType == "Branch"
            ? BranchPort(_debugSupplyBranchResult)
            : node.StepConfig.StepType == "HttpAction" && _debugSupplyHttpError ? "error" : null;
        session.Sequence = ++_debugSequence;
        if (node.StepConfig.StepType == "PersistedState")
            _debugPersistedStateJson = output;

        _showDebugSupplyModal = false;
        _debugSupplyError = null;
        RefreshDebugRunnability();
        if (node.StepConfig.StepType == "Branch")
            await FocusDebugBranchAsync(nodeId);
        if (_debugInspectorNodeId == nodeId)
            await OpenDebugInspectorAsync(node);
        StateHasChanged();
    }

    private Task OpenDebugInspectorAsync(IntegrationNodeModel node)
    {
        _debugInspectorNodeId = node.StepConfig.Id;
        _debugInspectorNodeName = DebugNodeLabel(node);
        _debugInspectorStepType = node.StepConfig.StepType;
        _debugInspectorLogs = new();
        _debugInspectorLogsError = null;
        LoadDebugInspectorLogsAsync();
        return InvokeAsync(StateHasChanged);
    }

    private void CloseDebugInspector()
    {
        _debugInspectorNodeId = null;
        _debugInspectorLogs = new();
        _debugInspectorLogsError = null;
        StateHasChanged();
    }

    private Task RefreshDebugInspectorLogsAsync()
    {
        LoadDebugInspectorLogsAsync();
        return Task.CompletedTask;
    }

    // The inspector shows the row's own console trail: every log line the executor wrote while this
    // card ran is tagged with the step execution id, so no timestamp heuristics are needed.
    private async void LoadDebugInspectorLogsAsync()
    {
        var nodeId = _debugInspectorNodeId;
        if (nodeId is not Guid inspectedId || !_debugSessions.TryGetValue(inspectedId, out var session))
        {
            return;
        }

        if (session.StepExecutionId is not Guid stepExecutionId)
        {
            _debugInspectorLogs = new();
            _debugInspectorLogsError = "Logs are unavailable until this step has run.";
            StateHasChanged();
            return;
        }

        _debugInspectorLogsLoading = true;
        _debugInspectorLogsError = null;
        StateHasChanged();

        try
        {
            var page = await Http.GetFromJsonAsync<LogPageDto>(
                $"api/logs?stepExecutionId={stepExecutionId}&pageSize=200");
            _debugInspectorLogs = page?.Items ?? new List<AppLogEntryDto>();
        }
        catch (Exception)
        {
            _debugInspectorLogs = new();
            _debugInspectorLogsError = "Could not load the logs for this step.";
        }
        finally
        {
            _debugInspectorLogsLoading = false;
            StateHasChanged();
        }
    }

    private void ClearResult()
    {
        Dispatcher.Dispatch(new RunFlowResultAction { Result = string.Empty });
    }

    private void OnIntegrationChanged(ChangeEventArgs args)
    {
        if (FlowState.Value.CurrentFlow == null)
        {
            return;
        }

        if (Guid.TryParse(args.Value?.ToString(), out var integrationId))
        {
            FlowState.Value.CurrentFlow.IntegrationId = integrationId;
        }
        else
        {
            FlowState.Value.CurrentFlow.IntegrationId = null;
        }
    }

    private Guid? GetSelectedIntegrationId()
    {
        if (FlowState.Value.CurrentFlow?.IntegrationId != null)
        {
            return FlowState.Value.CurrentFlow.IntegrationId;
        }

        return IntegrationIdQuery;
    }

    private const int FitMargin = 80;
    private const double FitPadding = 40d;
    private const double MaxFitZoom = 1.25d;
    private const double OverlayGap = 16d;
    private const int TidyColumnGap = 120;
    private const int TidyRowGap = 72;

    private void ZoomIn() => Diagram.SetZoom(Diagram.Zoom * 1.2);
    private void ZoomOut() => Diagram.SetZoom(Diagram.Zoom / 1.2);

    /// <summary>
    /// Fits the whole flow in view with an even margin. The diagram library's own ZoomToFit clips
    /// wide graphs and leaves them off-centre, so the content box is measured here and the zoom and
    /// pan are set directly: centred when there is slack, padded when there is not.
    /// </summary>
    private Task FitToScreenAsync() => FitCoreAsync(openView: false);

    // The view a flow opens with: never larger than 100% (the Fit button may go to 125%) and never smaller than
    // 50%, so a very large flow opens readable at its top-left instead of as an unreadable thumbnail.
    private const double OpenMinZoom = 0.5d;
    private const double OpenMaxZoom = 1.0d;

    private async Task FitCoreAsync(bool openView)
    {
        var nodes = Diagram.Nodes.ToList();
        if (nodes.Count == 0)
        {
            TryZoomToFit();
            return;
        }

        // The diagram library does not populate Model.Size for every custom node in this build.
        // Fall back to the rendered card size so Fit still works instead of silently doing nothing.
        double NodeWidth(NodeModel node) =>
            node.Size is { Width: > 0 } ? node.Size.Width : (_testMode ? 210d : 300d);
        double NodeHeight(NodeModel node) =>
            node.Size is { Height: > 0 } ? node.Size.Height : (_testMode ? 90d : 200d);

        var minX = nodes.Min(node => node.Position.X);
        var minY = nodes.Min(node => node.Position.Y);
        var contentWidth = Math.Max(1d, nodes.Max(node => node.Position.X + NodeWidth(node)) - minX);
        var contentHeight = Math.Max(1d, nodes.Max(node => node.Position.Y + NodeHeight(node)) - minY);

        var viewport = await GetCanvasViewportAsync();
        if (viewport is not { Length: >= 2 } || viewport[0] <= 0 || viewport[1] <= 0)
        {
            TryZoomToFit();
            return;
        }

        // The palette and the zoom stack float over the canvas: fit into what is left of it, so no
        // card ends up hidden behind them.
        var topInset = viewport.Length > 2 && viewport[2] > 0 ? viewport[2] + OverlayGap : FitPadding;
        // Test mode adds a taller toolbar (scenario controls + status row). Leave room for the
        // card badges above the top row instead of hiding them behind the floating bar.
        if (_testMode) topInset += 40;
        var leftInset = viewport.Length > 3 && viewport[3] > 0 ? viewport[3] + OverlayGap : FitPadding;
        var availableWidth = Math.Max(160d, viewport[0] - leftInset - FitPadding);
        var availableHeight = Math.Max(160d, viewport[1] - topInset - FitPadding);

        var zoom = Math.Min(availableWidth / contentWidth, availableHeight / contentHeight);
        if (!double.IsFinite(zoom) || zoom <= 0) return;
        zoom = openView ? Math.Clamp(zoom, OpenMinZoom, OpenMaxZoom) : Math.Min(zoom, MaxFitZoom);

        Diagram.SetZoom(zoom);
        Diagram.SetPan(
            leftInset + Math.Max(0d, (availableWidth - (contentWidth * zoom)) / 2d) - (minX * zoom),
            topInset + Math.Max(0d, (availableHeight - (contentHeight * zoom)) / 2d) - (minY * zoom));
    }

    private void TryZoomToFit()
    {
        try
        {
            Diagram.ZoomToFit((int)FitMargin);
            if (Diagram.Zoom > MaxFitZoom) Diagram.SetZoom(MaxFitZoom);
        }
        catch (ArgumentException)
        {
            // The canvas may not have been measured yet.
        }
    }

    private async Task<double[]?> GetCanvasViewportAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<double[]?>("simpleIPaaSDesigner.viewport", ".diagram-canvas");
        }
        catch (JSException)
        {
            return null;
        }
    }

    /// <summary>
    /// Arranges the cards in evenly spaced columns: one column per graph depth, stacked with the
    /// measured card height (so tall cards such as the scheduler cannot collide), centred against
    /// the tallest column. Positions are only persisted when the flow is saved, so this stays a
    /// preview until then.
    /// </summary>
    private async Task TidyLayoutAsync()
    {
        var nodes = Diagram.Nodes.ToList();
        if (nodes.Count == 0)
        {
            return;
        }

        // Depth = longest path from a root. Relaxation instead of recursion keeps a malformed graph
        // (a cycle can only reach the designer from hand-edited JSON) from blowing the stack.
        // Use the live canvas links first; saved flow edges only fill in links that could not
        // be rendered (a missing port, for example).
        var nodeByStepId = nodes.OfType<IntegrationNodeModel>().ToDictionary(node => node.StepConfig.Id, node => node);
        var edges = FlowState.Value.CurrentFlow?.Edges ?? new List<IntegrationEdgeDto>();

        // Prefer the live diagram links. CurrentFlow.Edges is only refreshed on save, so a new
        // connection made in the canvas would otherwise leave every node at depth 0 and Tidy
        // would stack the whole flow in one vertical column.
        var graphEdges = new HashSet<(Guid Source, Guid Target)>();
        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            if (link.Source.Model is not PortModel sourcePort ||
                link.Target.Model is not PortModel targetPort ||
                sourcePort.Parent is not IntegrationNodeModel sourceNode ||
                targetPort.Parent is not IntegrationNodeModel targetNode)
            {
                continue;
            }

            graphEdges.Add((sourceNode.StepConfig.Id, targetNode.StepConfig.Id));
        }

        // Keep saved edges as a fallback for links that could not be rendered.
        foreach (var edge in edges)
        {
            graphEdges.Add((edge.SourceNodeId, edge.TargetNodeId));
        }

        var depth = nodes.ToDictionary(node => node, _ => 0);
        for (var pass = 0; pass < nodes.Count; pass++)
        {
            var changed = false;
            foreach (var edge in graphEdges)
            {
                if (!nodeByStepId.TryGetValue(edge.Source, out var source) ||
                    !nodeByStepId.TryGetValue(edge.Target, out var target))
                {
                    continue;
                }

                if (depth[target] <= depth[source])
                {
                    depth[target] = depth[source] + 1;
                    changed = true;
                }
            }

            if (!changed)
            {
                break;
            }
        }

        var columns = nodes
            .GroupBy(node => depth[node])
            .OrderBy(column => column.Key)
            .Select(column => column.OrderBy(node => node.Position.Y).ToList())
            .ToList();

        double Width(NodeModel node) => node.Size is { Width: > 0 } size ? size.Width : 320d;
        double Height(NodeModel node) => node.Size is { Height: > 0 } size ? size.Height : 220d;

        // Column x positions: each column is as wide as its widest card plus a fixed gap.
        var columnX = new List<double>();
        var x = 0d;
        foreach (var column in columns)
        {
            columnX.Add(x);
            x += column.Max(Width) + TidyColumnGap;
        }

        var columnHeights = columns
            .Select(column => column.Sum(Height) + (TidyRowGap * (column.Count - 1)))
            .ToList();
        var tallest = columnHeights.Count == 0 ? 0d : columnHeights.Max();

        for (var index = 0; index < columns.Count; index++)
        {
            var column = columns[index];
            var y = Math.Max(0d, (tallest - columnHeights[index]) / 2d);
            foreach (var node in column)
            {
                node.SetPosition(columnX[index], y);
                y += Height(node) + TidyRowGap;
            }
        }

        await FitToScreenAsync();
    }

