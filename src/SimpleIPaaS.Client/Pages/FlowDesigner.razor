    }

    private async Task RollbackFlowAsync(int versionNumber)
    {
        var flow = FlowState.Value.CurrentFlow;
        if (flow == null || flow.Id == Guid.Empty)
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm", $"Rollback {flow.Name} to version {versionNumber}? This will immediately activate that version.");
        if (!confirmed)
        {
            return;
        }

        HttpResponseMessage response;
        try
        {
            response = await Http.PostAsJsonAsync(
                $"api/integrationflow/{flow.Id}/rollback/{versionNumber}",
                new FlowVersionActionDto { ChangeNote = $"Rollback to version {versionNumber}" });
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _validationErrors = new List<string> { $"The selected version could not be restored. {ErrorText.Describe(ex)}" };
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            _validationErrors = new List<string> { "The selected version could not be restored." };
            return;
        }

        var rolledBack = await response.Content.ReadFromJsonAsync<IntegrationFlowDto>();
        if (rolledBack != null)
        {
            Dispatcher.Dispatch(new UpdateFlowStateAction { Flow = rolledBack });
            await Task.Yield();
            LoadDiagramFromCurrentFlow();
            await OpenVersionHistoryAsync();
        }
    }

