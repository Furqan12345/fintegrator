    [JSInvokable]
    public async Task NotifyCanvasMetrics(int[] metrics)
    {
        if (metrics.Length < 2) return;
        _testCanvasWidth = metrics[0];
        _testCanvasHeight = metrics[1];
        if (_testSession?.ResultsOpen == false) _testFullCanvasHeight = _testCanvasHeight;
        if (!_testMode || _testSession == null) return;

        if (!_scenarioPanelUserChoice.HasValue && _testCanvasWidth < 900 && _testSession.ScenarioPanelOpen)
        {
            _testSession.SetPanelOpen(false);
            _fitTestAfterRender = true;
        }

        if (!_testDrawerHeightInitialized && _testSession.ResultsOpen && _testFullCanvasHeight > 0)
        {
            var minimumDrawerHeight = _testFullCanvasHeight < 620 ? 230 : 170;
            _testDrawerHeight = Math.Clamp((int)(_testFullCanvasHeight * 0.32), minimumDrawerHeight, 300);
            _testDrawerHeightInitialized = true;
            _fitTestAfterRender = true;
        }

        if (!_testDrawerAutoCollapsed && _testSession.ResultsOpen && _testCanvasWidth > 0 && _testCanvasWidth < 560)
        {
            _testDrawerCollapsed = true;
            _testDrawerAutoCollapsed = true;
            _fitTestAfterRender = true;
        }

        if (_fitTestAfterRender && _testSession.Evaluation?.FailedCardId is Guid failedCardId)
            _failedCardToCenter = failedCardId;

        await InvokeAsync(StateHasChanged);
    }

    private void TestDrawerHeightChanged(int height)
    {
        _testDrawerHeight = Math.Clamp(height, 150, 520);
        _fitTestAfterRender = true;
        if (_testSession?.Evaluation?.FailedCardId is Guid failedCardId)
            _failedCardToCenter = failedCardId;
        StateHasChanged();
    }

