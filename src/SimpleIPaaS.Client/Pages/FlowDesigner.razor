@page "/flow"
@page "/flow/{FlowId:guid}"
@page "/flow-designer"
@page "/flow-designer/{FlowId:guid}"
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.Json.Nodes
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.PathGenerators
@using Blazor.Diagrams.Core.Routers
@using Blazor.Diagrams.Options
@using SimpleIPaaS.Client.Components.Nodes
@using SimpleIPaaS.Client.Components.FlowTests
@using SimpleIPaaS.Client.Services
@using SimpleIPaaS.Client.Shared
@using SimpleIPaaS.Client.Store
@using Microsoft.AspNetCore.Components.Routing
@using SimpleIPaaS.Shared.Models
@using Microsoft.JSInterop
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@implements IDisposable
@inject IState<FlowState> FlowState
@inject IDispatcher Dispatcher
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject SimpleIPaaS.Client.Services.AiBuildJobTracker AiBuild

<PageTitle>Flow Designer — fusetor.com</PageTitle>

<div class="designer-shell">
@if (!_testMode && _testReturnState != null)
{
    <div class="test-return-bar">
        <button class="btn btn-primary btn-sm" @onclick="ReturnToTestsAsync">← Back to tests</button>
        <span>Return to @TestReturnSummary</span>
    </div>
}
@if (_testMode && _testSession != null)
{
    <TestScenarioPanel Session="_testSession"
                       Collapsed="@(!_testSession.ScenarioPanelOpen)"
                       OnToggle="ToggleTestScenarioPanel"
                       OnNew="RequestNewTestScenario"
                       OnDuplicate="RequestDuplicateTestScenario" />
}
@if (_debugMode && _debugInspectorNodeId.HasValue)
{
    <DebugInspector NodeName="@_debugInspectorNodeName"
                    StepType="@_debugInspectorStepType"
                    Session="@CurrentInspectorSession"
                    FlowStateJson="@DebugFlowStateSnapshot"
                    PersistedStateJson="@DebugPersistedStateSnapshot"
                    Logs="@_debugInspectorLogs"
                    LogsError="@_debugInspectorLogsError"
                    LoadingLogs="@_debugInspectorLogsLoading"
                    OnCloseRequested="@CloseDebugInspector"
                    RefreshRequested="@RefreshDebugInspectorLogsAsync" />
}

<div class="@CanvasContainerClass @(_testMode ? "test-mode-active" : "") @(_testMode && _testSession?.ResultsOpen == true ? "test-results-open" : "")" style="@TestCanvasStyle">
    <div class="diagram-toolbar @ToolbarClass">
        <button class="btn btn-icon toolbar-toggle" @onclick="ToggleToolbar" title="@ToolbarToggleLabel" aria-label="@ToolbarToggleLabel">
            <AppIcon Name="@(_toolbarCollapsed ? "chevron-down" : "chevron-up")" Class="icon icon-sm" />
        </button>

        <div class="toolbar-content">
            <input class="toolbar-input flow-name-input" type="text" @bind="FlowName" readonly="@(_testMode || IsOpeningFlow)" placeholder="@(IsOpeningFlow ? "Loading flow…" : "Flow Name")" />
            @if (_testMode && _testSession != null)
            {
                <TestModeToolbar Session="_testSession"
                                 OnExit="RequestExitTestMode"
                                 OnScenarioSelected="OnTestScenarioSelected"
                                 OnNew="RequestNewTestScenario"
                                 OnDuplicate="RequestDuplicateTestScenario" />
            }
            else
            {
            <select class="toolbar-input toolbar-select" value="@IntegrationValue" @onchange="OnIntegrationChanged">
                <option value="">Unassigned flow</option>
                @foreach (var integration in AvailableIntegrations)
                {
                    <option value="@integration.Id">@integration.Name</option>
                }
            </select>
            <div class="toolbar-divider"></div>
            <div class="toolbar-group" role="group" aria-label="Add node">
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.Schedule)" title="Add a schedule trigger">+ Schedule</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.HttpAction)" title="Add an HTTP action">+ HTTP Action</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.Mapping)" title="Add a mapper">+ Mapper</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.Branch)" title="Add a branch">+ Branch</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.CrossReferenceStore)" title="Add a cross-reference store">+ XRef Store</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.CrossReferenceFilter)" title="Add a cross-reference filter">+ XRef Filter</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.PersistedState)" title="Add persisted state">+ Persisted State</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.Debug)" title="Add a debug node">+ Debug</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.ForEach)" title="Add a for-each loop">+ For Each</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.FanOut)" title="Create one transaction per array item">+ Fan Out</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.Email)" title="Send an email">+ Email</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.AddIdentifier)" title="Set the transaction's identifier">+ Identifier</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.Error)" title="Set the transaction's error message">+ Error</button>
                <button class="btn btn-outline btn-sm" @onclick="() => AddNode(StepType.Success)" title="Set the transaction's success message">+ Success</button>
            </div>
            <button class="btn btn-primary btn-sm ai-flow-launch" @onclick="OpenAiChat" title="Describe a flow and let the AI agent build it in a chat session" disabled="@(FlowState.Value.CurrentFlow == null || (FlowId.HasValue && !_isLoaded))">Build with AI</button>
            @if (AiBuild != null && AiBuild.IsBusy)
            {
                <button class="btn btn-outline btn-sm ai-build-chip" @onclick="OpenAiFlowBuilder" title="Open the AI build progress">
                    AI building… @AiBuild.CurrentJob?.ToolCallsUsed tools
                </button>
            }
            else if (AiBuild?.CurrentJob?.Status == "Completed")
            {
                <button class="btn btn-success btn-sm ai-build-chip" @onclick="OpenAiFlowBuilder" title="Review the AI draft">AI draft ready</button>
            }
            <div class="toolbar-divider"></div>
            <button class="btn btn-outline btn-sm" @onclick="DeleteSelectedNodes" title="Delete selected node(s)">
                <AppIcon Name="trash" Class="icon icon-xs" /> Delete
            </button>
            <button class="btn btn-outline btn-sm" @onclick="OpenFlowSettings" disabled="@(FlowState.Value.CurrentFlow == null)" title="Flow settings">
                <AppIcon Name="settings" Class="icon icon-xs" /> Settings
            </button>
            <button class="btn btn-outline btn-sm" @onclick="OpenPersistedState" disabled="@(FlowState.Value.CurrentFlow == null || FlowState.Value.CurrentFlow.Id == Guid.Empty)" title="View and edit the durable state every run starts from">
                <AppIcon Name="crossreferences" Class="icon icon-xs" /> State
            </button>
            <button class="btn btn-outline btn-sm" @onclick="OpenHelperScript" disabled="@(FlowState.Value.CurrentFlow == null || (FlowId.HasValue && !_isLoaded))" title="Define C# helper functions shared by every script in this flow">
                <AppIcon Name="logs" Class="icon icon-xs" /> Helpers
            </button>
            <button class="btn btn-outline btn-sm" @onclick="ToggleTestModeAsync" disabled="@(FlowState.Value.CurrentFlow == null || FlowState.Value.CurrentFlow.Id == Guid.Empty)" title="Open the flow in test mode">
                <AppIcon Name="check" Class="icon icon-xs" />
                @TestToolbarLabel
            </button>
            <button class="btn btn-outline btn-sm" @onclick="OpenFlowLogs" disabled="@(FlowState.Value.CurrentFlow == null || FlowState.Value.CurrentFlow.Id == Guid.Empty)" title="View debug logs for this flow">
                <AppIcon Name="search" Class="icon icon-xs" /> Logs
            </button>
            <button class="btn btn-outline btn-sm" @onclick="PublishFlowAsync" disabled="@(_publishBusy || FlowState.Value.CurrentFlow == null || FlowState.Value.CurrentFlow.Id == Guid.Empty || FlowState.Value.IsLoading)" title="Publish this draft">
                <AppIcon Name="arrow-right" Class="icon icon-xs" /> @(_publishBusy ? "Publishing…" : "Publish")
            </button>
            @if (HasSchedule)
            {
                <button class="btn btn-outline btn-sm" @onclick="ToggleScheduleAsync"
                        disabled="@(_scheduleBusy || !CanToggleSchedule || FlowState.Value.IsLoading)"
                        title="@(FlowState.Value.CurrentFlow?.PublishedVersion == null ? "Publish the flow before starting its schedule" : IsScheduleActive ? "Pause the schedule" : "Start the schedule")">
                    <AppIcon Name="clock" Class="icon icon-xs" />
                    @(_scheduleBusy ? "Updating…" : IsScheduleActive ? "Pause schedule" : "Start schedule")
                </button>
            }
            <button class="btn btn-outline btn-sm" @onclick="OpenVersionHistoryAsync" disabled="@(FlowState.Value.CurrentFlow == null || FlowState.Value.CurrentFlow.Id == Guid.Empty)" title="View published versions">
                <AppIcon Name="refresh" Class="icon icon-xs" /> Versions
            </button>
            <div class="toolbar-divider"></div>
            <button class="btn btn-outline btn-sm @(_debugMode ? "debug-toggle-active" : string.Empty)"
                    @onclick="ToggleDebugModeAsync"
                    disabled="@(_debugBusy)"
                    title="@(_debugMode ? "Leave step-by-step debugging" : "Run this flow one step at a time")">
                <AppIcon Name="search" Class="icon icon-xs" /> @(_debugMode ? "Debug Mode On" : "Debug Mode")
            </button>
            @if (_debugMode)
            {
                <button class="btn btn-outline btn-sm" @onclick="ResetDebugSession" title="Clear all debug results and supplied outputs">
                    <AppIcon Name="refresh" Class="icon icon-xs" /> Reset
                </button>
            }
            <button class="btn btn-primary" @onclick="SaveFlow" disabled="@FlowState.Value.IsLoading">
                @SaveButtonLabel
            </button>
            <button class="btn btn-success" @onclick="RunFlow" disabled="@(FlowState.Value.IsLoading || FlowState.Value.CurrentFlow == null)">
                <AppIcon Name="play" Class="icon icon-xs" /> Run
            </button>
            }
        </div>

        <button class="btn btn-icon canvas-fullscreen" @onclick="ToggleFullscreen" title="@FullscreenLabel" aria-label="@FullscreenLabel">
            <AppIcon Name="@(_isFullscreen ? "minimize" : "maximize")" Class="icon icon-sm" />
        </button>
    </div>

    @if (DeadLetterIdQuery.HasValue)
    {
        <section class="resync-panel">
            <div class="resync-panel-heading">
                <div>
                    <h3>Resync dead letter</h3>
                    <p class="text-muted">Choose a completed upstream node to replay from. That node and its downstream path will run again.</p>
                </div>
                <a class="btn btn-sm btn-outline" href="/deadletters">Close</a>
            </div>
            @if (_resyncLoading)
            {
                <p class="text-muted">Loading recovery details…</p>
            }
            else if (_resyncDeadLetter != null)
            {
                <div class="resync-controls">
                    <label class="form-group resync-node-select">
                        <span>Start from node</span>
                        <select class="form-control" @bind="_selectedResyncStepId" disabled="@(_resyncOptions.Count == 0 || _resyncQueued)">
                            @foreach (var option in _resyncOptions)
                            {
                                <option value="@option.StepId">@option.NodeName (@option.StepType)@(option.IsDefault ? " — flow default + downstream" : option.IsFailedNode ? " — failed node + downstream" : " + downstream")</option>
                            }
                        </select>
                    </label>
                    <button class="btn btn-primary" @onclick="QueueResyncAsync" disabled="@(!CanQueueResync)">
                        @(_resyncQueueing ? "Queueing…" : "Resync")
                    </button>
                </div>
                <small class="field-hint">The selected node and all reachable downstream nodes run again. Earlier nodes keep their original results; HTTP actions on the rerun path may run again.</small>
            }
            @if (!string.IsNullOrWhiteSpace(_resyncMessage))
            {
                <div class="resync-message @(_resyncQueued ? "success" : "error")">@_resyncMessage</div>
            }
        </section>
    }

    @if (_validationErrors.Any())
    {
        <div class="validation-banner">
            <strong>Cannot save flow:</strong>
            <ul>
                @foreach (var error in _validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
            <button class="btn btn-sm btn-outline" @onclick="() => _validationErrors.Clear()">Dismiss</button>
        </div>
    }

    @if (IsOpeningFlow && _flowLoadFailed)
    {
        <div class="designer-loading designer-load-failed" role="alert">
            <AppIcon Name="alert" Class="icon icon-md" />
            <span>This flow could not be loaded. Check that the API is running, then try again.</span>
            <button class="btn btn-sm btn-primary" @onclick="RetryLoadFlow">Try again</button>
            <a class="btn btn-sm btn-outline" href="integrations">Back to integrations</a>
        </div>
    }
    else if (IsOpeningFlow)
    {
        <div class="designer-loading" role="status" aria-live="polite">
            <span class="designer-loading-spinner" aria-hidden="true"></span>
            Loading flow…
        </div>
    }

    <CascadingValue Value="Diagram">
        <CascadingValue Value="this">
            <DiagramCanvas></DiagramCanvas>
        </CascadingValue>
    </CascadingValue>

    <div class="zoom-controls">
        <button class="btn btn-icon" @onclick="ZoomIn" title="Zoom In">+</button>
        <button class="btn btn-icon" @onclick="ZoomOut" title="Zoom Out">-</button>
        <button class="btn btn-icon" @onclick="FitToScreenAsync" title="Fit the whole flow in view with a comfortable margin">Fit</button>
        <button class="btn btn-icon" @onclick="TidyLayoutAsync" title="Arrange the cards in evenly spaced columns">Tidy</button>
    </div>

    @if (!_testMode && !string.IsNullOrWhiteSpace(FlowState.Value.RunResult))
    {
        <div class="run-result-panel">
            <h4>Execution Result</h4>
            <div class="run-result">@FlowState.Value.RunResult</div>
            <button class="btn btn-outline btn-block run-result-dismiss" @onclick="ClearResult">Dismiss</button>
        </div>
    }

    @if (_testMode && _testSession != null && _testSession.ResultsOpen)
    {
        <TestResultsDrawer Session="_testSession"
                           Height="_testDrawerHeight"
                           Collapsed="_testDrawerCollapsed"
                           OnHeightChanged="TestDrawerHeightChanged"
                           OnToggleCollapsed="ToggleTestDrawer"
                           OnShowCard="ShowTestCard"
                           OnClose="CloseTestResults" />
    }
</div>
@if (_testMode && _testSession?.SelectedCardId is Guid testCardId)
{
    <TestCardInspector Session="_testSession"
                       CardId="testCardId"
                       CardName="@_testSession.SelectedCardName"
                       OnClose="CloseTestInspector"
                       OnOpenInEditor="OpenCardInEditor" />
}
</div>

@if (_showPublishTests && _testSession != null)
{
    <PublishTestsDialog Session="_testSession"
                        OnClose="ClosePublishTestsDialog"
                        OnOpenTestMode="OpenTestModeFromPublish"
                        OnPublished="OnTestsPublished" />
}
@if (_showTestConfirm)
{
    <div class="modal-overlay" @onclick="CancelTestDiscard">
        <div class="modal-container confirm-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="test-eyebrow">UNSAVED FLOW CHANGES</div>
                    <h3 class="modal-title">
                        @(_testConfirmAction switch
                        {
                            "save-before-test" => "Save changes before testing?",
                            "return-to-tests" => "Save changes before returning to tests?",
                            _ => "Discard unsaved changes?"
                        })
                    </h3>
                    <p class="modal-subtitle">
                        @(_testConfirmAction switch
                        {
                            "save-before-test" => "Tests run against the saved draft. Save the flow, then enter test mode.",
                            "return-to-tests" => "The flow changed while you were in the editor. Save it, then restore your test session.",
                            _ => "The current flow has unsaved edits. This action will discard them."
                        })
                    </p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_testSaveError))
            {
                <div class="modal-body">
                    <div class="test-error-box">@_testSaveError</div>
                </div>
            }
            <div class="modal-actions">
                <button class="btn btn-ghost" @onclick="CancelTestDiscard">Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmTestDiscardAsync">
                    @(_testConfirmAction switch
                    {
                        "save-before-test" => "Save and continue",
                        "return-to-tests" => "Save and return",
                        _ => "Discard and continue"
                    })
                </button>
            </div>
        </div>
    </div>
}
@if (_editingStep != null)
{
    <MapperModal @bind-IsVisible="_showMapperModal"
                 Step="_editingStep"
                 TargetProperty="@_editingProperty"
                 HelperCode="@(FlowState.Value.CurrentFlow?.HelperCode ?? string.Empty)" />
}

    <PersistedStateModal @bind-IsVisible="_showPersistedStateModal" FlowId="@(_persistedStateFlowId)" />
    <HelperScriptModal @bind-IsVisible="_showHelperScriptModal"
                       Value="@(FlowState.Value.CurrentFlow?.HelperCode ?? string.Empty)"
                       ValueChanged="OnHelperCodeChanged" />

<DebugJsonModal @bind-IsVisible="_showDebugJsonModal" JsonContent="@_debugJsonContent" ErrorMessage="@_debugJsonError" />
@if (_showDebugSupplyModal)
{
    <div class="modal-overlay" @onclick="CloseDebugSupply">
        <div class="modal-container flow-settings-modal debug-supply-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="test-eyebrow">DEBUG · SUPPLY OUTPUT</div>
                    <h3 class="modal-title">@_debugSupplyNodeName</h3>
                    <p class="modal-subtitle">The card is marked done without calling the API. No HTTP, email or database side effects.</p>
                </div>
                <button class="modal-close-btn" @onclick="CloseDebugSupply">×</button>
            </div>
            <div class="modal-body">
                @if (DebugSupplyStepType == "Branch")
                {
                    <div class="debug-supply-choice">
                        <label class="test-radio">
                            <input type="radio" name="supply-branch" checked="@_debugSupplyBranchResult" @onchange="() => _debugSupplyBranchResult = true" />
                            <span><strong>True</strong><small>Route down the true port.</small></span>
                        </label>
                        <label class="test-radio">
                            <input type="radio" name="supply-branch" checked="@(!_debugSupplyBranchResult)" @onchange="() => _debugSupplyBranchResult = false" />
                            <span><strong>False</strong><small>Route down the false port.</small></span>
                        </label>
                    </div>
                }
                else
                {
                    @if (DebugSupplyStepType == "HttpAction" && DebugSupplyHttpContinue)
                    {
                        <div class="debug-supply-choice">
                            <label class="test-radio">
                                <input type="radio" name="supply-http" checked="@(!_debugSupplyHttpError)" @onchange="() => SetDebugSupplyHttpMode(false)" />
                                <span><strong>Success</strong><small>Route through the normal output port.</small></span>
                            </label>
                            <label class="test-radio">
                                <input type="radio" name="supply-http" checked="@_debugSupplyHttpError" @onchange="() => SetDebugSupplyHttpMode(true)" />
                                <span><strong>Error</strong><small>Route through the Error port with the error envelope.</small></span>
                            </label>
                        </div>
                    }
                    <CodeEditor Value="@_debugSupplyJson" ValueChanged="OnDebugSupplyJsonChanged" Language="json" CssClass="test-config-editor" />
                    @if (!string.IsNullOrWhiteSpace(_debugSupplyError))
                    {
                        <div class="test-field-error">@_debugSupplyError</div>
                    }
                    @if (DebugSupplyStepType is "ForEach" or "FanOut")
                    {
                        <div class="field-hint">Supply a JSON array; it becomes this loop/fan-out card's output.</div>
                    }
                }
            </div>
            <div class="modal-actions">
                <button class="btn btn-ghost" @onclick="CloseDebugSupply">Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmDebugSupplyAsync">Supply output</button>
            </div>
        </div>
    </div>
}
<AiFlowBuilderModal @bind-IsVisible="_showAiFlowBuilder" CurrentFlow="_aiFlowCurrentFlow" OnFlowGenerated="ApplyAiFlowDraftAsync" />

@if (_showFlowSettings && FlowState.Value.CurrentFlow != null)
{
    var settingsFlow = FlowState.Value.CurrentFlow;
    <div class="modal-overlay" @onclick="CloseFlowSettings">
        <div class="modal-container flow-settings-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Flow settings</h2>
                    <p class="modal-subtitle">@settingsFlow.Name</p>
                </div>
                <button class="modal-close-btn" @onclick="CloseFlowSettings" aria-label="Close">✕</button>
            </div>
            <div class="modal-body modal-body-scroll">
                <div class="form-group">
                    <label>Flow lifecycle</label>
                    <div class="text-muted">@settingsFlow.Status</div>
                    <small class="field-hint">Save changes as a draft, then use Publish to make this version active. @(settingsFlow.PublishedVersion.HasValue ? $"The published version is v{settingsFlow.PublishedVersion}." : "No version has been published yet.")</small>
                </div>
                @if (HasScheduleNode)
                {
                    <div class="form-group">
                        <label>Trigger Type</label>
                        <input type="text" class="form-control" readonly value="Schedule node" />
                        <small class="field-hint">@ScheduleNodeSummary</small>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label>Trigger Type</label>
                        <select class="form-control" value="@settingsFlow.TriggerType" @onchange="OnTriggerTypeChanged">
                            <option value="Manual">Manual</option>
                            <option value="Webhook">Webhook</option>
                            <option value="Cron">Cron</option>
                        </select>
                    </div>
                }

                @if (!HasScheduleNode && settingsFlow.TriggerType == "Cron")
                {
                    <div class="form-group">
                        <label>Cron Expression</label>
                        <input type="text" class="form-control" @bind="settingsFlow.CronExpression" @bind:event="oninput" @bind:after="RefreshCronPreview" placeholder="*/5 * * * *" />
                        <small class="field-hint">@CronPreviewDescription</small>
                    </div>
                    @if (_cronPreviewOccurrences.Count > 0)
                    {
                        <div class="form-group">
                            <label>Next runs</label>
                            <ul class="cron-preview-list">
                                @foreach (var fire in _cronPreviewOccurrences)
                                {
                                    <li class="text-muted">@fire.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</li>
                                }
                            </ul>
                        </div>
                    }
                }
                else if (!HasScheduleNode && settingsFlow.TriggerType == "Webhook")
                {
                    <div class="form-group">
                        <label>Webhook URL</label>
                        @if (!HasWebhookSecret)
                        {
                            <small class="field-hint">Save the flow to generate the webhook URL.</small>
                        }
                        else
                        {
                            <div class="input-with-action">
                                <input type="text" class="form-control" readonly value="@WebhookUrl" />
                                <button class="btn btn-outline" @onclick="CopyWebhookUrl">@(_webhookCopied ? "Copied!" : "Copy")</button>
                            </div>
                        }
                    </div>
                    <div class="form-group">
                        <button class="btn btn-outline" @onclick="RegenerateWebhookSecret" disabled="@(!HasWebhookSecret || FlowState.Value.IsLoading)">Regenerate Secret</button>
                        <small class="field-hint">The server issues the secret; regenerating invalidates the current URL immediately.</small>
                    </div>
                }

                <div class="form-group">
                    <label for="default-resync-node">Dead-letter resync starts from</label>
                    <select id="default-resync-node" class="form-control" value="@DefaultDeadLetterResyncNodeValue" @onchange="OnDefaultDeadLetterResyncNodeChanged">
                        <option value="">Failed node + downstream (default)</option>
                        @foreach (var node in ResyncNodeChoices)
                        {
                            <option value="@node.StepConfig.Id">@ResyncNodeLabel(node)</option>
                        }
                    </select>
                    <small class="field-hint">Resync reruns the selected node and all reachable downstream nodes. With the default, it reruns the failed node and the rest of its downstream path.</small>
                </div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="FlowState.Value.CurrentFlow!.AllowPostReplay" />
                        Allow side-effecting steps (POST, PATCH, …) to be replayed from the dead-letter queue
                    </label>
                    <small class="field-hint">POST requests are not idempotent — replaying one can duplicate its effect on the target system. Leave off unless the endpoint is safe to call twice.</small>
                </div>

                <div class="modal-actions">
                    <button class="btn btn-outline" @onclick="CloseFlowSettings">Close</button>
                    <button class="btn btn-primary" @onclick="SaveFlowSettings" disabled="@FlowState.Value.IsLoading">Save settings</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showVersionHistory && FlowState.Value.CurrentFlow != null)
{
    <div class="modal-overlay" @onclick="CloseVersionHistory">
        <div class="modal-container flow-settings-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Published versions</h2>
                    <p class="modal-subtitle">@FlowState.Value.CurrentFlow.Name</p>
                </div>
                <button class="modal-close-btn" @onclick="CloseVersionHistory" aria-label="Close">✕</button>
            </div>
            <div class="modal-body modal-body-scroll">
                @if (_versions.Count == 0)
                {
                    <p class="text-muted">No published versions yet. Save the flow, then publish it.</p>
                }
                else
                {
                    @foreach (var version in _versions)
                    {
                        <div class="version-history-row">
                            <div>
                                <strong>v@(version.VersionNumber)</strong>
                                @if (version.IsCurrent)
                                {
                                    <span class="text-muted"> · current</span>
                                }
                                <div class="text-muted">@version.CreatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</div>
                                <div>@version.ChangeNote</div>
                                @if (version.RolledBackFromVersion.HasValue)
                                {
                                    <small class="field-hint">Rollback from v@(version.RolledBackFromVersion)</small>
                                }
                            </div>
                            <button class="btn btn-outline btn-sm"
                                    @onclick="() => RollbackFlowAsync(version.VersionNumber)"
                                    disabled="@version.IsCurrent">
                                Rollback
                            </button>
                        </div>
                    }
                }
                <div class="modal-actions">
                    <button class="btn btn-outline" @onclick="CloseVersionHistory">Close</button>
                </div>
            </div>
        </div>
    </div>
}

