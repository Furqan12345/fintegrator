    private async Task ConfirmTestDiscardAsync()
    {
        if (_testConfirmAction == "save-before-test")
        {
            await SaveDraftBeforeTestAsync();
            return;
        }
        if (_testConfirmAction == "return-to-tests")
        {
            await SaveDraftBeforeTestAsync(_testReturnState);
            return;
        }
        if (_testSession == null) return;
        switch (_testConfirmAction)
        {
            case "exit":
                await ExitTestModeAsync();
                break;
            case "new":
                _showTestConfirm = false;
                _testSession.NewScenario();
                break;
            case "duplicate":
                _showTestConfirm = false;
                _testSession.DuplicateScenario();
                break;
            case "switch":
                _showTestConfirm = false;
                if (_pendingScenarioId is Guid scenarioId)
                {
                    var scenario = _testSession.Scenarios.FirstOrDefault(item => item.Id == scenarioId);
                    if (scenario != null) _testSession.LoadScenario(scenario);
                }
                _pendingScenarioId = null;
                break;
            case "navigate":
                _showTestConfirm = false;
                _testSession.StopPolling();
                _allowTestNavigation = true;
                if (!string.IsNullOrWhiteSpace(_pendingNavigationUrl))
                    NavigationManager.NavigateTo(_pendingNavigationUrl);
                _allowTestNavigation = false;
                break;
            case "open-editor":
                _showTestConfirm = false;
                if (_pendingEditorCardId is Guid editorCardId)
                {
                    _pendingEditorCardId = null;
                    await ExitTestModeAsync(editorCardId);
                }
                break;
        }
    }

