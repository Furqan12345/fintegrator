            if (status == null) return "Tests";
            if (status.Total == 0)
                return status.ScenarioCount == 0 ? "Tests" : $"Tests • {status.ScenarioCount}";
            if (status.Failed > 0) return $"Tests ✗ {status.Passed}/{status.Total}";
            if (status.Stale > 0) return "Tests • stale";
            if (status.NeverRun > 0) return $"Tests • {status.Passed}/{status.Total}";
            return $"Tests ✓ {status.Passed}/{status.Total}";
