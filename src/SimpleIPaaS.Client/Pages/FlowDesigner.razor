        var versions = await SafeFetch.GetAsync<List<FlowVersionDto>>(
            Http, $"api/integrationflow/{flow.Id}/versions", Dispatcher, "the version history");

        if (versions != null)
        {
            _versions = versions;
        }

        _showVersionHistory = true;
    }

