    }

    private void ApplyTestModeToDiagram()
    {
        if (Diagram == null) return;
        var session = _testSession;
        foreach (var node in Diagram.Nodes.OfType<IntegrationNodeModel>())
        {
            node.IsTestMode = _testMode;
            node.Locked = _testMode;
            foreach (var port in node.Ports) port.Locked = _testMode;
            if (_testMode && session != null)
            {
                node.TestClick = OpenTestInspectorAsync;
                var visual = session.GetCardVisual(node.StepConfig.Id);
                node.TestBadge = visual.Badge;
                node.TestTone = visual.Tone;
                node.TestState = visual.State;
                node.TestStatus = visual.Badge;
                node.IsMocked = session.IsSupplied(node.StepConfig.Id);
                var cardResult = session.CardResult(node.StepConfig.Id);
                node.ActiveHttpPort = node.StepConfig.StepType == "HttpAction"
                    && node.StepConfig.HttpErrorMode == "Continue"
                    && cardResult != null
                    && (cardResult.HttpStatusCode is > 0 and (< 200 or >= 300)
                        || cardResult.Output.Contains("\"ok\":false", StringComparison.OrdinalIgnoreCase))
                        ? "error"
                        : null;
            }
            else
            {
                node.TestClick = null;
                node.TestBadge = string.Empty;
                node.TestTone = string.Empty;
                node.TestState = string.Empty;
                node.IsMocked = false;
                node.ActiveHttpPort = null;
            }
            node.Refresh();
        }

        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            link.Locked = _testMode;
            link.Color = null;
            link.Width = 1.5;
        }

        if (_testMode && session?.Evaluation != null)
        {
            HighlightRunPath(session);
        }
    }

    private void HighlightRunPath(FlowTestSession session)
    {
        var ran = new Dictionary<Guid, DateTime>();
        if (session.IsRunning && session.Detail != null)
        {
            foreach (var card in session.Detail.Progress.Where(item => item.StartedAt.HasValue))
                ran[card.CardId] = card.StartedAt!.Value;
        }
        else if (session.Evaluation != null)
        {
            foreach (var card in session.Evaluation.Cards.Where(item =>
                         item.Status != "NotReached" && item.StartedAt.HasValue))
                ran[card.CardId] = card.StartedAt!.Value;
        }
        if (ran.Count == 0) return;

        foreach (var link in Diagram.Links.OfType<LinkModel>())
        {
            if ((link.Source.Model as PortModel)?.Parent is not IntegrationNodeModel source
                || (link.Target.Model as PortModel)?.Parent is not IntegrationNodeModel target)
                continue;
            if (!ran.TryGetValue(source.StepConfig.Id, out var sourceStart)
                || !ran.TryGetValue(target.StepConfig.Id, out var targetStart)
                || targetStart < sourceStart)
                continue;

            if (source.StepConfig.StepType.Equals("Branch", StringComparison.OrdinalIgnoreCase))
            {
                var output = session.CardResult(source.StepConfig.Id)?.Output ?? string.Empty;
                var branchTrue = output.Contains("true", StringComparison.OrdinalIgnoreCase);
                var branchFalse = output.Contains("false", StringComparison.OrdinalIgnoreCase);
                if (branchTrue != branchFalse)
                {
                    var expectedPort = branchTrue ? "true" : "false";
                    var sourcePortId = (link.Source.Model as PortModel)?.Id ?? string.Empty;
                    if (!sourcePortId.Equals(expectedPort, StringComparison.OrdinalIgnoreCase)) continue;
                }
            }
            else if (source.StepConfig.StepType.Equals("HttpAction", StringComparison.OrdinalIgnoreCase)
                     && source.StepConfig.HttpErrorMode == "Continue")
            {
                var result = session.CardResult(source.StepConfig.Id);
                var errorPort = result?.HttpStatusCode is > 0 and (< 200 or >= 300)
                    || (result?.Output.Contains("\"ok\":false", StringComparison.OrdinalIgnoreCase) ?? false);
                var sourcePortId = (link.Source.Model as PortModel)?.Id ?? string.Empty;
                if (errorPort != sourcePortId.Equals("error", StringComparison.OrdinalIgnoreCase)) continue;
            }

            link.Color = "#6366f1";
            link.Width = 3;
        }
    }

    private Task OpenTestInspectorAsync(IntegrationNodeModel node)
    {
        _testSession?.SelectCard(node.StepConfig.Id, node.StepConfig.NodeName);
        return Task.CompletedTask;
    }

    private void ShowTestCard(Guid cardId)
    {
        if (_testSession == null) return;
        var node = Diagram.Nodes.OfType<IntegrationNodeModel>()
            .FirstOrDefault(item => item.StepConfig.Id == cardId);
        if (node != null) _testSession.SelectCard(cardId, node.StepConfig.NodeName);
        _fitTestAfterRender = true;
        _failedCardToCenter = cardId;
        StateHasChanged();
    }

    private void CenterTestCard(Guid cardId)
    {
        var node = Diagram.Nodes.OfType<IntegrationNodeModel>()
            .FirstOrDefault(item => item.StepConfig.Id == cardId);
        if (node == null) return;
        var zoom = Diagram.Zoom <= 0 ? 1 : Diagram.Zoom;
        if (zoom < 0.72)
        {
            zoom = 0.72;
            Diagram.SetZoom(zoom);
        }
        var container = Diagram.Container;
        if (container == null || node.Size == null) return;
        var x = container.Width / 2 - (node.Position.X + node.Size.Width / 2) * zoom;
        var centerY = container.Height * 0.52;
        if (_testMode && _testCanvasWidth > 0 && _testCanvasWidth < 560)
        {
            // Below the compact toolbar and zoom row, above the auto-collapsed drawer.
            var topBoundary = 184d;
            var bottomBoundary = Math.Max(topBoundary + 80, container.Height - 12d);
            centerY = (topBoundary + bottomBoundary) / 2d;
        }
        var y = centerY - (node.Position.Y + node.Size.Height / 2) * zoom;
        Diagram.SetPan(x, y);
        Diagram.SelectModel(node, true);
    }

