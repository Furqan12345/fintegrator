    {
        _showTestConfirm = false;
        _testConfirmAction = string.Empty;
        _testSaveError = null;
        _pendingScenarioId = null;
        _pendingEditorCardId = null;
        _pendingNavigationUrl = null;
    }

    private async Task RefreshTestStatusIfNeededAsync(IntegrationFlowDto flow)
    {
        // An unsaved flow has no id yet, so it has no test suite to ask about.
        if (flow.Id == Guid.Empty || _statusRefreshBusy || _lastStatusFlowUpdated == flow.UpdatedAt) return;
        _statusRefreshBusy = true;
        try
        {
            _testStatus = await Http.GetFromJsonAsync<FlowTestSuiteStatusDto>(
                $"api/integrationflow/{flow.Id}/test-suite/status");
            _lastStatusFlowUpdated = flow.UpdatedAt;
            await InvokeAsync(StateHasChanged);
        }
        catch (HttpRequestException) { }
        finally
        {
            _statusRefreshBusy = false;
        }
    }

    private async Task<FlowTestSuiteStatusDto?> LoadTestStatusAsync()
    {
        var flow = FlowState.Value.CurrentFlow;
        if (flow == null || flow.Id == Guid.Empty) return null;
        try
        {
            _testStatus = await Http.GetFromJsonAsync<FlowTestSuiteStatusDto>(
                $"api/integrationflow/{flow.Id}/test-suite/status");
            _lastStatusFlowUpdated = flow.UpdatedAt;
            return _testStatus;
        }
        catch (HttpRequestException)
        {
            return _testStatus;
        }
    }

