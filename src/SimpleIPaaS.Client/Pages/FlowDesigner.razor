    private async Task ToggleScheduleAsync()
    {
        var flow = FlowState.Value.CurrentFlow;
        if (flow == null || flow.Id == Guid.Empty || !CanToggleSchedule) return;

        _scheduleBusy = true;
        _validationErrors.Clear();
        try
        {
            var action = IsScheduleActive ? "pause" : "start";
            using var response = await Http.PostAsync($"api/integrationflow/{flow.Id}/schedule/{action}", null);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _validationErrors = new List<string>
                {
                    string.IsNullOrWhiteSpace(body) ? "The schedule could not be updated." : body
                };
                return;
            }

            var updated = await response.Content.ReadFromJsonAsync<IntegrationFlowDto>();
            if (updated != null)
            {
                Dispatcher.Dispatch(new UpdateFlowStateAction { Flow = updated });
            }
        }
        catch (Exception)
        {
            _validationErrors = new List<string> { "Could not reach the API to update the schedule." };
        }
        finally
        {
            _scheduleBusy = false;
            StateHasChanged();
        }
    }

    private async Task PublishFlowAsync()
    {
        var flow = FlowState.Value.CurrentFlow;
        if (_publishBusy || flow == null || flow.Id == Guid.Empty)
        {
            return;
        }

        var status = await LoadTestStatusAsync();
        if (status != null && status.RequiredTests.Any(test => test.State != "Passed"))
        {
            await EnsurePublishSessionAsync();
            if (_testSession != null) await _testSession.LoadStatusAsync();
            _showPublishTests = true;
            StateHasChanged();
            return;
        }

        await PublishFlowCoreAsync("Published from Flow Designer");
    }

    private async Task PublishFlowCoreAsync(string changeNote)
    {
        var flow = FlowState.Value.CurrentFlow;
        if (_publishBusy || flow == null || flow.Id == Guid.Empty)
        {
            return;
        }

        // Publishing appends a version server-side, so a second click while the first request is
        // still in flight would create a duplicate "Published from Flow Designer" row.
        _publishBusy = true;
        _validationErrors.Clear();

        var unconnectedErrorPorts = flow.Nodes
            .Where(node => node.StepType == "HttpAction" && node.HttpErrorMode == "Continue"
                && !flow.Edges.Any(edge => edge.SourceNodeId == node.Id
                    && string.Equals(edge.SourcePortId, "error", StringComparison.OrdinalIgnoreCase)))
            .Select(node => node.NodeName)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList();
        if (unconnectedErrorPorts.Count > 0)
        {
            Dispatcher.Dispatch(new ShowToastAction
            {
                Message = $"Error port not connected for {string.Join(", ", unconnectedErrorPorts)} — errors will be ignored.",
                Level = "warning"
            });
        }
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/integrationflow/{flow.Id}/publish",
                new FlowVersionActionDto { ChangeNote = changeNote });

            if (!response.IsSuccessStatusCode)
            {
                _validationErrors = new List<string> { "The draft could not be published. Review the flow and try again." };
                return;
            }

            var published = await response.Content.ReadFromJsonAsync<IntegrationFlowDto>();
            if (published != null)
            {
                Dispatcher.Dispatch(new UpdateFlowStateAction { Flow = published });
                await LoadTestStatusAsync();
                await OpenVersionHistoryAsync();
            }
        }
        catch (Exception)
        {
            _validationErrors = new List<string> { "Could not reach the API to publish this flow." };
        }
        finally
        {
            _publishBusy = false;
            StateHasChanged();
        }
    }

    private async Task OpenVersionHistoryAsync()
    {
        var flow = FlowState.Value.CurrentFlow;
        if (flow == null || flow.Id == Guid.Empty)
