    public void OpenMapperModal(IntegrationStepDto step, string targetProperty)
    {
        _editingStep = step;
        _editingProperty = targetProperty;
        _showMapperModal = true;
        StateHasChanged();
    }

    private void OpenPersistedState()
    {
        var flowId = FlowState.Value.CurrentFlow?.Id ?? Guid.Empty;
        if (flowId == Guid.Empty) return;

        _persistedStateFlowId = flowId;
        _showPersistedStateModal = true;
        StateHasChanged();
    }

    private void OpenHelperScript()
    {
        if (FlowState.Value.CurrentFlow == null) return;
        _showHelperScriptModal = true;
        StateHasChanged();
    }

    private void OnHelperCodeChanged(string helperCode)
    {
        if (FlowState.Value.CurrentFlow == null) return;
        FlowState.Value.CurrentFlow.HelperCode = helperCode ?? string.Empty;
        StateHasChanged();
    }

    public void OpenDebugJsonModal(string jsonContent, string errorMessage)
    {
        _debugJsonContent = jsonContent;
        _debugJsonError = errorMessage;
        _showDebugJsonModal = true;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        AiBuild.Changed += OnAiBuildChanged;
        SetupDiagram();
        _locationChangingRegistration = NavigationManager.RegisterLocationChangingHandler(OnLocationChangingAsync);
        SubscribeToAction<LoadFlowResultAction>(action =>
        {
            _freshFlowId = action.Flow?.Id;
            _ = InvokeAsync(StateHasChanged);
        });
        SubscribeToAction<LoadFlowFailedAction>(action =>
        {
            if (action.Id != _expectedFlowId || _isLoaded) return;
            _flowLoadFailed = true;
            _ = InvokeAsync(StateHasChanged);
        });

        // Start the flow request first: the lookups only feed dropdowns, so the flow must not wait on them.
        _expectedFlowId = FlowId;
        if (FlowId.HasValue)
        {
            FlowName = string.Empty;
            Dispatcher.Dispatch(new LoadFlowAction { Id = FlowId.Value });
        }
        await LoadLookupsAsync();

        if (!FlowId.HasValue && !DeadLetterIdQuery.HasValue)
        {
            Dispatcher.Dispatch(new UpdateFlowStateAction
            {
                Flow = new IntegrationFlowDto
                {
                    Name = "New Flow",
                    IntegrationId = IntegrationIdQuery
                }
            });
            _isLoaded = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (string.Equals(AiBuildQuery, "open", StringComparison.OrdinalIgnoreCase))
                _ = InvokeAsync(OpenRestoredAiBuildAsync);
            _dotnetHelper = DotNetObjectReference.Create(this);
            _ = InvokeAsync(async () =>
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("simpleIPaaSFullscreen.onFullScreenChange", _dotnetHelper);
                }
                catch (JSException)
                {
                }
            });
            // Warm up the Monaco bundle while the user is still on the canvas so
            // the mapper modal opens with its editor ready.
            _ = InvokeAsync(async () =>
            {
                try
                {
                    var editorModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/code-editor.js");
                    await editorModule.InvokeVoidAsync("preload");
                    await editorModule.DisposeAsync();
                }
                catch (JSException)
                {
                }
            });
        }

        if (DeadLetterIdQuery.HasValue && _loadedResyncDeadLetterId != DeadLetterIdQuery.Value && !_resyncLoading)
        {
            await LoadResyncContextAsync(DeadLetterIdQuery.Value);
        }

        if (DraftMessageIdQuery.HasValue && !_appliedDraftMessage && (!FlowId.HasValue || _isLoaded))
        {
            await ApplyChatDraftAsync(DraftMessageIdQuery.Value);
        }

        var currentFlow = FlowState.Value.CurrentFlow;
        if (currentFlow != null && _expectedFlowId.HasValue && !_isLoaded && currentFlow.Id == _expectedFlowId.Value
            && _freshFlowId == _expectedFlowId)
        {
            FlowName = currentFlow.Name;
            LoadDiagramFromCurrentFlow();
            _lastSavedDraftJson = FlowDraftSignature.Create(currentFlow);
            _isLoaded = true;
            // Cards sit at their saved coordinates, which are often off-screen or under the toolbar at 100% zoom.
            // Frame the flow once when it opens (test mode frames itself).
            if (!string.Equals(ModeQuery, "test", StringComparison.OrdinalIgnoreCase)) _fitOnOpenAfterRender = true;
            StateHasChanged();
        }

        if (_awaitingSaveBaseline && !FlowState.Value.IsLoading && currentFlow != null)
        {
            if (!ReferenceEquals(currentFlow, _flowBeforeSave))
                _lastSavedDraftJson = FlowDraftSignature.Create(currentFlow);
            _awaitingSaveBaseline = false;
            _flowBeforeSave = null;
        }

        if (_fitTestAfterRender && _testMode)
        {
            _fitTestAfterRender = false;
            await FitToScreenAsync();
        }

        if (_fitOnOpenAfterRender && !_testMode && _isLoaded && Diagram.Nodes.Count > 0)
        {
            _fitOnOpenAfterRender = false;
            await FitCoreAsync(openView: true);
        }

        if (_testRestoreView is { } restoreView && _testMode)
        {
            _testRestoreView = null;
            _restoringTestSession = false;
            Diagram.SetZoom(restoreView.Zoom);
            Diagram.SetPan(restoreView.PanX, restoreView.PanY);
        }

        if (_failedCardToCenter is Guid failedCardId && _testMode)
        {
            _failedCardToCenter = null;
            CenterTestCard(failedCardId);
        }

        await MarkHttpErrorLinksAsync();

        if (_debugMode)
        {
            await ApplyDebugLinkStylesAsync();
            _debugLinkStylesApplied = true;
        }
        else if (_debugLinkStylesApplied)
        {
            _debugLinkStylesApplied = false;
            try { await JSRuntime.InvokeVoidAsync("simpleIPaaSDesigner.clearLinkStyles"); }
            catch (JSException) { }
        }

        if (_testMode && !_testCanvasObserverAttached && _dotnetHelper != null)
        {
            _testCanvasObserverAttached = true;
            try { await JSRuntime.InvokeVoidAsync("simpleIPaaSDesigner.observeCanvas", _dotnetHelper); }
            catch (JSException) { }
        }

        // Re-read the flow: an earlier render's OnAfterRenderAsync can resume here after a later one loaded the
        // flow, with currentFlow still holding the store's empty placeholder.
        currentFlow = FlowState.Value.CurrentFlow;
        if (_isLoaded && currentFlow != null)
        {
            if (!_testMode && string.Equals(ModeQuery, "test", StringComparison.OrdinalIgnoreCase))
            {
                var restore = _testReturnState;
                await EnterTestModeAsync(skipDirtyGuard: true, restoreState: restore);
            }
            else if (!_testMode)
            {
                await RefreshTestStatusIfNeededAsync(currentFlow);
            }
        }
    }

    private async Task LoadResyncContextAsync(Guid deadLetterId)
    {
        _resyncLoading = true;
        _loadedResyncDeadLetterId = deadLetterId;
        _resyncMessage = string.Empty;
        try
        {
            var entry = await Http.GetFromJsonAsync<DeadLetterDto>($"api/deadletters/{deadLetterId}");
            if (entry == null || entry.FlowId == Guid.Empty)
            {
                _resyncMessage = "The dead letter or its flow could not be found.";
                return;
            }

            if (FlowId.HasValue && FlowId.Value != entry.FlowId)
            {
                _resyncMessage = "This dead letter belongs to a different flow.";
                return;
            }

            _resyncDeadLetter = entry;
            _expectedFlowId = entry.FlowId;
            // With a flow id in the URL the flow is already being loaded; otherwise fetch it fresh.
            if (!FlowId.HasValue)
            {
                Dispatcher.Dispatch(new LoadFlowAction { Id = entry.FlowId });
            }

            _resyncOptions = await Http.GetFromJsonAsync<List<ResyncNodeOptionDto>>(
                $"api/deadletters/{deadLetterId}/resync-nodes") ?? new List<ResyncNodeOptionDto>();
            _selectedResyncStepId = _resyncOptions.FirstOrDefault(option => option.IsDefault)?.StepId.ToString()
                ?? _resyncOptions.FirstOrDefault(option => option.IsFailedNode)?.StepId.ToString()
                ?? _resyncOptions.FirstOrDefault()?.StepId.ToString()
                ?? string.Empty;
            if (_resyncOptions.Count == 0)
            {
                _resyncMessage = "No eligible failed or completed upstream nodes are available for resync.";
            }
        }
        catch (Exception)
        {
            _resyncMessage = "Could not load this dead letter’s resync options. Refresh the page and try again.";
        }
        finally
        {
            _resyncLoading = false;
            StateHasChanged();
        }
    }

    private async Task QueueResyncAsync()
    {
        if (_resyncDeadLetter == null || !Guid.TryParse(_selectedResyncStepId, out var startStepId))
        {
            return;
        }

        _resyncQueueing = true;
        _resyncMessage = string.Empty;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/deadletters/{_resyncDeadLetter.Id}/retry",
                new ResyncDeadLetterRequestDto { StartStepId = startStepId });
            if (response.IsSuccessStatusCode)
            {
                _resyncQueued = true;
                _resyncMessage = "Resync queued. The engine will run the selected node and its downstream path.";
            }
            else
            {
                var detail = await response.Content.ReadAsStringAsync();
                _resyncMessage = string.IsNullOrWhiteSpace(detail)
                    ? "Could not queue this resync."
                    : detail;
            }
        }
        catch (Exception)
        {
            _resyncMessage = "Could not reach the API to queue this resync.";
        }
        finally
        {
            _resyncQueueing = false;
            StateHasChanged();
        }
    }

    private void RetryLoadFlow()
    {
        if (!FlowId.HasValue) return;
        _flowLoadFailed = false;
        Dispatcher.Dispatch(new LoadFlowAction { Id = FlowId.Value });
    }

    // The integration picker and the connection dropdowns. Both requests run together; the integration list
    // only needs names, so it uses the lite view. A failure leaves the dropdown empty instead of crashing the page.
    private async Task LoadLookupsAsync()
    {
        var integrations = SafeFetch.GetAsync<List<IntegrationDto>>(Http, "api/integrations?lite=true", Dispatcher, "integrations");
        var connections = SafeFetch.GetAsync<List<ConnectionDto>>(Http, "api/connections", Dispatcher, "connections");
        _integrations = await integrations ?? new List<IntegrationDto>();
        _connections = await connections ?? new List<ConnectionDto>();
        // If the flow arrived first, its HTTP cards rendered with an empty connection list.
        if (_isLoaded)
        {
            foreach (var node in Diagram.Nodes) node.Refresh();
        }
    }

    private void LoadDiagramFromCurrentFlow()
    {
        // Loading a different flow (or a fresh copy of this one) rebuilds every card, so a debug
        // session holding the old node ids would point at nodes that no longer exist.
        if (_debugMode)
        {
            ExitDebugMode();
        }

        Diagram.Nodes.Clear();
        Diagram.Links.Clear();

        if (FlowState.Value.CurrentFlow == null)
        {
            return;
        }

        foreach (var step in FlowState.Value.CurrentFlow.Nodes)
        {
            var node = new IntegrationNodeModel(step) { Title = step.StepType };
            node.SetPosition(step.PositionX, step.PositionY);
            Diagram.Nodes.Add(node);
        }

        foreach (var edge in FlowState.Value.CurrentFlow.Edges)
        {
            var sourceNode = Diagram.Nodes.FirstOrDefault(node => ((IntegrationNodeModel)node).StepConfig.Id == edge.SourceNodeId) as IntegrationNodeModel;
            var targetNode = Diagram.Nodes.FirstOrDefault(node => ((IntegrationNodeModel)node).StepConfig.Id == edge.TargetNodeId) as IntegrationNodeModel;
            if (sourceNode == null || targetNode == null)
            {
                continue;
            }

            var sourcePort = sourceNode.Ports.FirstOrDefault(port => port.Id == edge.SourcePortId);
            var targetPort = targetNode.Ports.FirstOrDefault(port => port.Id == edge.TargetPortId);
            if (sourcePort != null && targetPort != null)
            {
                Diagram.Links.Add(new LinkModel(sourcePort, targetPort));
            }
        }
        ApplyTestModeToDiagram();
    }

    private void SetupDiagram()
    {
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = true,
            Zoom =
            {
                Enabled = true,
                ScaleFactor = 1.1
            },
            Links =
            {
                DefaultRouter = new NormalRouter(),
                DefaultPathGenerator = new DirectionalPathGenerator()
            }
        };

        Diagram = new BlazorDiagram(options);
        Diagram.RegisterComponent<IntegrationNodeModel, IntegrationNodeWidget>();
    }

    private string? DraftSignature()
    {
        var draft = CaptureCurrentDraft();
        return draft == null ? null : FlowDraftSignature.Create(draft);
    }

    private bool IsDraftDirty()
    {
        var signature = DraftSignature();
        return _lastSavedDraftJson != null && signature != null && signature != _lastSavedDraftJson;
    }

    private async Task ToggleTestModeAsync()
    {
        if (_testMode)
        {
            RequestExitTestMode();
            return;
        }
        await EnterTestModeAsync(skipDirtyGuard: false);
    }

    private async Task EnterTestModeAsync(bool skipDirtyGuard, TestModeReturnState? restoreState = null)
    {
        var flow = FlowState.Value.CurrentFlow;
        if (flow == null || flow.Id == Guid.Empty) return;
        if (!skipDirtyGuard && IsDraftDirty())
        {
            _testConfirmAction = "save-before-test";
            _showTestConfirm = true;
            StateHasChanged();
            return;
        }
        await StartTestModeAsync(flow, restoreState);
    }

    private async Task SaveDraftBeforeTestAsync(TestModeReturnState? restoreState = null)
    {
        var flow = FlowState.Value.CurrentFlow;
        if (flow == null) return;
        var draft = CaptureCurrentDraft();
        if (draft == null) return;
        _testSaveError = null;
        HttpResponseMessage response;
        try
        {
            response = await Http.PutAsJsonAsync($"api/integrationflow/{flow.Id}", draft);
        }
        catch (Exception ex)
        {
            _testSaveError = $"Could not save the flow. {ErrorText.Describe(ex)}";
            _showTestConfirm = true;
            StateHasChanged();
            return;
        }
        if (!response.IsSuccessStatusCode)
        {
            _testSaveError = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(_testSaveError))
                _testSaveError = "The flow could not be saved.";
            _showTestConfirm = true;
            StateHasChanged();
            return;
        }
        var saved = await response.Content.ReadFromJsonAsync<IntegrationFlowDto>();
        if (saved == null)
        {
            _testSaveError = "The API returned an empty saved flow.";
            _showTestConfirm = true;
            StateHasChanged();
            return;
        }

        Dispatcher.Dispatch(new SaveFlowResultAction { Flow = saved });
        FlowName = saved.Name;
        LoadDiagramFromCurrentFlow();
        _lastSavedDraftJson = FlowDraftSignature.Create(saved);
        _testSaveError = null;
        _showTestConfirm = false;
        await StartTestModeAsync(saved, restoreState);
    }

    private async Task StartTestModeAsync(IntegrationFlowDto flow, TestModeReturnState? restoreState = null)
    {
        if (_debugMode) ExitDebugMode();
        if (_testSession != null)
        {
            _testSession.Changed -= OnTestSessionChanged;
            await _testSession.DisposeAsync();
        }

        _testSession = new FlowTestSession(Http, flow);
        _testSession.Changed += OnTestSessionChanged;
        _testMode = true;
        _lastFailedTestCardId = null;
        _scenarioPanelUserChoice = null;
        _testDrawerHeightInitialized = false;
        _testDrawerCollapsed = false;
        _testDrawerAutoCollapsed = false;
        _lastTestResultsOpen = false;
        _testCanvasObserverAttached = false;
        _restoringTestSession = restoreState != null;
        await _testSession.InitializeAsync();

        if (restoreState != null)
        {
            var scenario = _testSession.Scenarios.FirstOrDefault(item => item.Id == restoreState.ScenarioId);
            if (scenario != null)
            {
                _testSession.LoadScenario(scenario);
                await _testSession.LoadRunsAsync();
                if (restoreState.RunId.HasValue)
                    await _testSession.LoadRunAsync(restoreState.RunId.Value);
            }

            _scenarioPanelUserChoice = restoreState.ScenarioPanelOpen;
            _testSession.SetPanelOpen(restoreState.ScenarioPanelOpen);
            _testSession.KeepInspectorTab = true;
            _testSession.SetInspectorTab(restoreState.InspectorTab);
            _testSession.SetResultsOpen(restoreState.ResultsOpen);
            if (restoreState.CardId.HasValue)
                _testSession.SelectCard(restoreState.CardId, restoreState.CardName);
            _testDrawerCollapsed = restoreState.DrawerCollapsed;
            _testDrawerHeight = restoreState.DrawerHeight;
            _testDrawerHeightInitialized = true;
            _testDrawerAutoCollapsed = true;
            _lastTestResultsOpen = restoreState.ResultsOpen;
            _testRestoreView = new TestRestoreView(restoreState.Zoom, restoreState.PanX, restoreState.PanY);
            _testReturnState = null;
            _fitTestAfterRender = false;
        }
        else
        {
            _testSession.KeepInspectorTab = false;
            _fitTestAfterRender = true;
        }

        ApplyTestModeToDiagram();
        if (restoreState != null || !NavigationManager.Uri.Contains("mode=test", StringComparison.OrdinalIgnoreCase))
        {
            _allowTestNavigation = true;
            NavigationManager.NavigateTo($"flow/{flow.Id}?mode=test", replace: true);
            _allowTestNavigation = false;
        }
        StateHasChanged();
    }

    private void OnTestSessionChanged()
    {
        _ = InvokeAsync(() =>
        {
            ApplyTestModeToDiagram();
            if (_restoringTestSession)
            {
                StateHasChanged();
                return;
            }
            var resultsOpen = _testSession?.ResultsOpen == true;
            if (resultsOpen && !_lastTestResultsOpen)
            {
                _fitTestAfterRender = true;
                if (!_testDrawerAutoCollapsed && _testCanvasWidth > 0 && _testCanvasWidth < 560)
                {
                    _testDrawerCollapsed = true;
                    _testDrawerAutoCollapsed = true;
                }
            }
            else if (!resultsOpen && _lastTestResultsOpen)
            {
                _fitTestAfterRender = true;
            }
            _lastTestResultsOpen = resultsOpen;

            var failed = _testSession?.Evaluation?.FailedCardId;
            if (failed.HasValue && failed != _lastFailedTestCardId)
            {
                _lastFailedTestCardId = failed;
                _failedCardToCenter = failed;
            }
            StateHasChanged();
        });
    }

