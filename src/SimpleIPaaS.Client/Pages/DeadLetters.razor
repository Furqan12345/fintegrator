@page "/deadletters"
@using SimpleIPaaS.Client.Store
@using SimpleIPaaS.Shared.Models
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<DeadLetterState> DeadLetterState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

<PageTitle>Dead Letters — SimpleIPaaS</PageTitle>

<div class="page-header">
    <div class="header-left">
        <h2>Dead Letters</h2>
        <p class="subtitle">Retry or discard failed integration messages</p>
    </div>
    <div class="header-right">
        <select class="form-control filter-select-sm" value="@_statusFilter" @onchange="OnStatusFilterChanged">
            <option value="">All statuses</option>
            <option value="Pending">Pending</option>
            <option value="Retrying">Retrying</option>
            <option value="Resolved">Resolved</option>
            <option value="Discarded">Discarded</option>
        </select>
    </div>
</div>

@if (ExecutionId.HasValue)
{
    <div class="validation-banner">
        <strong>Filtered</strong> to execution @ShortId(ExecutionId.Value)@(StepId.HasValue ? $", step {ShortId(StepId.Value)}" : string.Empty).
        <button class="btn btn-sm btn-outline" @onclick="ClearScopeFilter">Show all</button>
    </div>
}

<div class="activity-log-container">
    @if (DeadLetterState.Value.IsLoading && !DeadLetterState.Value.DeadLetters.Any())
    {
        <div class="loading-state">Loading dead letters...</div>
    }
    else if (!VisibleEntries.Any())
    {
        <div class="empty-state">
            <span class="empty-icon"><AppIcon Name="deadletters" Class="icon icon-lg" /></span>
            <h3>No dead letters</h3>
            <p>Failed messages will land here for retry or discard.</p>
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Flow</th>
                    <th>Node</th>
                    <th>Error</th>
                    <th>Retries</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in VisibleEntries)
                {
                    <tr>
                        <td>
                            @ResolveFlowName(entry)
                            @if (!string.IsNullOrWhiteSpace(entry.IntegrationName))
                            {
                                <div class="text-muted">@entry.IntegrationName</div>
                            }
                        </td>
                        <td>@ResolveNodeName(entry)</td>
                        <td title="@entry.ErrorMessage">@Truncate(entry.ErrorMessage, 60)</td>
                        <td>
                            @entry.RetryCount/@MaxRetries
                            @if (entry.RetryCount >= MaxRetries)
                            {
                                <span class="status-badge warning" title="Maximum retries reached">max</span>
                            }
                        </td>
                        <td><span class="status-badge @(entry.Status.ToLowerInvariant())">@entry.Status</span></td>
                        <td>@entry.CreatedAt.ToLocalTime()</td>
                        <td>
                            <button class="btn btn-sm btn-outline" @onclick="() => Retry(entry)" disabled="@DeadLetterState.Value.IsLoading">Retry</button>
                            <button class="btn btn-sm btn-outline" @onclick="() => AskDiscard(entry)" disabled="@DeadLetterState.Value.IsLoading">Discard</button>
                            <button class="btn btn-sm btn-outline" @onclick="() => ViewExecution(entry.FlowExecutionId)">Execution</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_discardTarget != null)
{
    <div class="modal-overlay" @onclick="CancelDiscard">
        <div class="modal-container confirm-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">Discard dead letter</h2>
                <button class="modal-close-btn" @onclick="CancelDiscard">✕</button>
            </div>
            <div class="modal-body">
                <p>Discard this dead letter from <strong>@ResolveFlowName(_discardTarget)</strong> (node @ResolveNodeName(_discardTarget))? It will no longer be retried.</p>
                <div class="modal-actions">
                    <button class="btn btn-outline" @onclick="CancelDiscard">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDiscard">Discard</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const int MaxRetries = 5;

    [SupplyParameterFromQuery(Name = "executionId")]
    public Guid? ExecutionId { get; set; }

    [SupplyParameterFromQuery(Name = "stepId")]
    public Guid? StepId { get; set; }

    private string _statusFilter = string.Empty;
    private DeadLetterDto? _discardTarget;

    private IEnumerable<DeadLetterDto> VisibleEntries
    {
        get
        {
            var entries = DeadLetterState.Value.DeadLetters.AsEnumerable();
            if (ExecutionId.HasValue)
            {
                entries = entries.Where(entry => entry.FlowExecutionId == ExecutionId.Value);
            }

            if (StepId.HasValue)
            {
                entries = entries.Where(entry => entry.StepId == StepId.Value);
            }

            return entries.OrderByDescending(entry => entry.CreatedAt);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Dispatcher.Dispatch(new LoadDeadLettersAction { Status = _statusFilter });
    }

    private void OnStatusFilterChanged(ChangeEventArgs args)
    {
        _statusFilter = args.Value?.ToString() ?? string.Empty;
        Dispatcher.Dispatch(new LoadDeadLettersAction { Status = _statusFilter });
    }

    private void ClearScopeFilter()
    {
        NavigationManager.NavigateTo("/deadletters");
    }

    private void Retry(DeadLetterDto entry)
    {
        Dispatcher.Dispatch(new RetryDeadLetterAction { Id = entry.Id, StatusFilter = _statusFilter });
    }

    private void AskDiscard(DeadLetterDto entry)
    {
        _discardTarget = entry;
    }

    private void CancelDiscard()
    {
        _discardTarget = null;
    }

    private void ConfirmDiscard()
    {
        if (_discardTarget != null)
        {
            Dispatcher.Dispatch(new DiscardDeadLetterAction { Id = _discardTarget.Id, StatusFilter = _statusFilter });
        }

        _discardTarget = null;
    }

    private void ViewExecution(Guid executionId)
    {
        NavigationManager.NavigateTo($"/execution/{executionId}");
    }

    private static string ResolveFlowName(DeadLetterDto entry) =>
        string.IsNullOrWhiteSpace(entry.FlowName) ? ShortId(entry.FlowExecutionId) : entry.FlowName;

    private static string ResolveNodeName(DeadLetterDto entry) =>
        string.IsNullOrWhiteSpace(entry.NodeName) ? ShortId(entry.StepId) : entry.NodeName;

    private static string ShortId(Guid id) => id == Guid.Empty ? "-" : $"{id.ToString()[..8]}…";

    private static string Truncate(string value, int maxLength) =>
        string.IsNullOrEmpty(value) || value.Length <= maxLength ? value : value.Substring(0, maxLength) + "...";
}
