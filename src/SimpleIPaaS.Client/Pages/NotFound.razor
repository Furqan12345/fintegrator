@page "/not-found"
@layout MainLayout

<PageTitle>Not Found — SimpleIPaaS</PageTitle>

<div class="page-body notfound-page">
    <div class="empty-state empty-state-hero">
        <span class="empty-icon"><AppIcon Name="search" Class="icon icon-lg" /></span>
        <p class="page-eyebrow">Error 404</p>
        <h3>We couldn't find that page</h3>
        <p>The link may be out of date, or the flow, execution or connection it pointed at no longer exists.</p>
        <div class="inline-actions">
            <a class="btn btn-primary" href="">Back to dashboard</a>
            <a class="btn btn-outline" href="activity">Open activity log</a>
        </div>
    </div>
</div>
