@page "/logs"
@using System.Globalization
@using System.Net.Http.Json
@using System.Threading
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using SimpleIPaaS.Client.Store
@using SimpleIPaaS.Shared.Models
@implements IAsyncDisposable
@inject HttpClient Http
@inject IDispatcher Dispatcher
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Debug Logs — SimpleIPaaS</PageTitle>

<div class="logs-page">
    <header class="logs-header">
        <div class="logs-title">
            <h2>Debug Logs</h2>
            <p class="logs-subtitle">Live application log from the Engine and API processes</p>
        </div>
        <div class="logs-actions">
            <span class="logs-status @(_paused ? "paused" : "live")">
                <span class="logs-status-dot"></span>
                @(_paused ? "Paused" : "Live")
            </span>
            <button type="button" class="logs-btn" @onclick="TogglePause">
                @(_paused ? "Resume" : "Pause")
            </button>
            <button type="button" class="logs-btn" @onclick="RefreshAsync" disabled="@_busy">Refresh</button>
            <button type="button" class="logs-btn danger" @onclick="() => _confirmClear = true">Clear logs</button>
        </div>
    </header>

    <div class="logs-filters">
        <label class="logs-field compact">
            <span>Minimum level</span>
            <select value="@_level" @onchange="OnLevelChanged">
                <option value="">All levels</option>
                @foreach (var level in _levels)
                {
                    <option value="@level">@level and above</option>
                }
            </select>
        </label>

        <label class="logs-field compact">
            <span>Source</span>
            <select value="@_source" @onchange="OnSourceChanged">
                <option value="">All sources</option>
                @foreach (var source in _sources)
                {
                    <option value="@source">@source</option>
                }
            </select>
        </label>

        <label class="logs-field compact">
            <span>Integration</span>
            <select value="@_integrationFilter" @onchange="OnIntegrationChanged">
                <option value="">All integrations</option>
                @foreach (var integration in _integrations)
                {
                    <option value="@integration.Id">@integration.Name</option>
                }
            </select>
        </label>
        <label class="logs-field flow-filter">
            <span>Flow</span>
            <select value="@_flowFilter" @onchange="OnFlowChanged">
                <option value="">All flows</option>
                @foreach (var flow in _flows)
                {
                    <option value="@flow.Id">@flow.Name</option>
                }
            </select>
        </label>

        <label class="logs-field grow">
            <span>Search</span>
            <input type="search"
                   placeholder="Message, category, node or exception text — press Enter"
                   value="@_search"
                   @onchange="OnSearchChanged" />
        </label>

        <label class="logs-field execution-filter">
            <span>Execution id</span>
            <input type="text"
                   placeholder="correlate by execution"
                   value="@_executionFilter"
                   @onchange="OnExecutionFilterChanged" />
        </label>

        <label class="logs-field compact observability-filter">
            <span>Service</span>
            <select value="@_service" @onchange="OnServiceChanged">
                <option value="">All services</option>
                @foreach (var item in _services) { <option value="@item">@item</option> }
            </select>
        </label>
        <label class="logs-field compact observability-filter">
            <span>Component</span>
            <select value="@_component" @onchange="OnComponentChanged">
                <option value="">All components</option>
                @foreach (var item in _components) { <option value="@item">@item</option> }
            </select>
        </label>
        <label class="logs-field compact observability-filter">
            <span>Event</span>
            <select value="@_eventName" @onchange="OnEventChanged">
                <option value="">All events</option>
                @foreach (var item in _events) { <option value="@item">@item</option> }
            </select>
        </label>
        <label class="logs-field compact observability-filter">
            <span>Outcome</span>
            <select value="@_outcome" @onchange="OnOutcomeChanged">
                <option value="">All outcomes</option>
                @foreach (var item in _outcomes) { <option value="@item">@item</option> }
            </select>
        </label>
        <div class="logs-count">
            Showing <strong>@_entries.Count</strong>@(_total > _entries.Count ? $" of {_total} matching" : string.Empty)
            <span class="logs-cursor" title="Live tail cursor">cursor @_cursor</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_notice))
    {
        <div class="logs-notice">@_notice</div>
    }

    <div class="logs-console" @ref="_consoleRef">
        <div class="logs-column-header" aria-hidden="true">
            <span>Time</span><span>Level</span><span>Service / component</span><span>Event</span><span>Integration</span><span>Flow</span><span>Card</span><span>Message</span><span></span>
        </div>
        @if (_entries.Count == 0)
        {
            <div class="logs-empty">
                @if (_loading)
                {
                    <span>Loading log entries…</span>
                }
                else
                {
                    <span>No log entries match the current filters.</span>
                }
            </div>
        }
        else
        {
            <Virtualize Items="_entries" Context="entry" OverscanCount="20">
            @{
                var expandable = HasDetail(entry);
            }
                <div class="logs-row level-@entry.Level.ToLowerInvariant() @(expandable ? "expandable" : string.Empty) @(_expanded.Contains(entry.Id) ? "expanded" : string.Empty)"
                     @onclick="() => ToggleExpanded(entry)">
                    <span class="logs-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture)</span>
                    <span class="logs-level">@ShortLevel(entry.Level)</span>
                    <span class="logs-context logs-component" title="@ComponentLabel(entry)">@ComponentLabel(entry)</span>
                    <span class="logs-context logs-event" title="@entry.EventName">@(string.IsNullOrWhiteSpace(entry.EventName) ? "log" : entry.EventName)</span>
                    <span class="logs-context logs-integration" title="@IntegrationLabel(entry)">
                        @if (entry.IntegrationId.HasValue)
                        {
                            <button type="button" class="logs-context-link" @onclick:stopPropagation="true" @onclick="() => FilterByIntegrationAsync(entry.IntegrationId!.Value)">@IntegrationLabel(entry)</button>
                        }
                        else
                        {
                            @IntegrationLabel(entry)
                        }
                    </span>
                    <span class="logs-context logs-flow" title="@FlowLabel(entry)">
                        @if (entry.FlowId.HasValue)
                        {
                            <button type="button" class="logs-context-link" @onclick:stopPropagation="true" @onclick="() => FilterByFlowAsync(entry.FlowId!.Value)">@FlowLabel(entry)</button>
                        }
                        else
                        {
                            @FlowLabel(entry)
                        }
                    </span>
                    <span class="logs-context logs-node" title="@(string.IsNullOrWhiteSpace(entry.NodeName) ? "No card" : entry.NodeName)">@(string.IsNullOrWhiteSpace(entry.NodeName) ? "—" : entry.NodeName)</span>
                    <span class="logs-message" title="@entry.Message">
                        @entry.Message
                        @if (entry.FlowExecutionId.HasValue)
                        {
                            <button type="button" class="logs-chip link" title="Filter by this execution" @onclick:stopPropagation="true" @onclick="() => OpenTimelineAsync(entry.FlowExecutionId!.Value)">exec @ShortId(entry.FlowExecutionId.Value)</button>
                        }
                    </span>
                    @if (expandable)
                    {
                        <span class="logs-caret">@(_expanded.Contains(entry.Id) ? "▾" : "▸")</span>
                    }
                </div>

                @if (expandable && _expanded.Contains(entry.Id))
                {
                    <div class="logs-detail">
                        <dl class="logs-meta">
                            <dt>Log id</dt><dd>@entry.Id</dd>
                            <dt>Timestamp (UTC)</dt><dd>@entry.Timestamp.ToString("u", CultureInfo.InvariantCulture)</dd>
                            <dt>Event id</dt><dd>@entry.EventId · v@entry.EventVersion</dd>
                            <dt>Event</dt><dd>@entry.EventName · @entry.Outcome</dd>
                            <dt>Service / component</dt><dd>@ComponentLabel(entry)</dd>
                            <dt>Environment / version</dt><dd>@entry.EnvironmentName · @entry.ApplicationVersion</dd>
                            @if (entry.ConnectionId.HasValue)
                            {
                                <dt>Connection</dt><dd>@entry.ConnectionId</dd>
                            }
                            <dt>Category</dt><dd>@entry.Category</dd>
                            <dt>Integration</dt><dd>@IntegrationLabel(entry)@(entry.IntegrationId.HasValue ? $" · {entry.IntegrationId}" : string.Empty)</dd>
                            <dt>Flow</dt><dd>@FlowLabel(entry)@(entry.FlowId.HasValue ? $" · {entry.FlowId}" : string.Empty)</dd>
                            @if (entry.DurationMs.HasValue)
                            {
                                <dt>Duration</dt><dd>@entry.DurationMs ms</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(entry.TraceId))
                            {
                                <dt>Trace</dt><dd>@entry.TraceId · span @entry.SpanId</dd>
                            }
                            @if (entry.FlowExecutionId.HasValue)
                            {
                                <dt>Execution</dt><dd>@entry.FlowExecutionId</dd>
                            }
                            @if (entry.NodeName is not null)
                            {
                                <dt>Node</dt><dd>@entry.NodeName</dd>
                            }
                            @if (entry.TenantId.HasValue)
                            {
                                <dt>Tenant</dt><dd>@entry.TenantId</dd>
                            }
                        </dl>
                        @if (!string.IsNullOrWhiteSpace(entry.Operation))
                        {
                            <dt>Operation</dt><dd>@entry.Operation</dd>
                        }
                        @if (entry.Invocation.HasValue || entry.RetryAttempt.HasValue || entry.IsTest.HasValue)
                        {
                            <dt>Run context</dt><dd>invocation @(entry.Invocation?.ToString() ?? "—") · retry @(entry.RetryAttempt?.ToString() ?? "—") · @(entry.IsTest == true ? "test" : "production")</dd>
                        }
                        @if (entry.StepExecutionId.HasValue)
                        {
                            <dt>Step execution</dt><dd>@entry.StepExecutionId</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.PropertiesJson) && entry.PropertiesJson != "{}")
                        {
                            <dt>Structured properties</dt><dd><pre class="logs-properties">@entry.PropertiesJson</pre></dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.Exception))
                        {
                            <pre class="logs-exception">@entry.Exception</pre>
                        }
                    </div>
                }
            </Virtualize>
        }
    </div>
</div>

@if (_confirmClear)
{
    <div class="logs-modal-overlay" @onclick="() => _confirmClear = false">
        <div class="logs-modal" @onclick:stopPropagation="true">
            <h3>Clear logs</h3>
            <p>
                This permanently deletes every application log row from the shared database.
                Flows, executions and cross-reference data are not affected.
            </p>
            <div class="logs-modal-actions">
                <button type="button" class="logs-btn" @onclick="() => _confirmClear = false">Cancel</button>
                <button type="button" class="logs-btn danger" @onclick="ClearLogsAsync">Clear logs</button>
            </div>
        </div>
    </div>
}

@code {
    private const int MaxBufferedEntries = 2000;
    private const int InitialPageSize = 300;
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);

    private readonly List<AppLogEntryDto> _entries = new();
    private readonly HashSet<long> _expanded = new();
    private readonly CancellationTokenSource _cts = new();

    private string[] _levels = Array.Empty<string>();
    private string[] _sources = Array.Empty<string>();
    private List<FlowOption> _flows = new();
    private List<IntegrationOption> _integrations = new();
    private string[] _services = Array.Empty<string>();
    private string[] _components = Array.Empty<string>();
    private string[] _events = Array.Empty<string>();
    private string[] _outcomes = Array.Empty<string>();

    [SupplyParameterFromQuery(Name = "flowId")]
    public Guid? FlowId { get; set; }

    private string _level = "Information";
    private string _source = string.Empty;
    private string _service = string.Empty;
    private string _component = string.Empty;
    private string _eventName = string.Empty;
    private string _outcome = string.Empty;
    private string _integrationFilter = string.Empty;
    private string _flowFilter = string.Empty;
    private string _search = string.Empty;
    private string _executionFilter = string.Empty;

    private long _cursor;
    private int _total;
    private bool _paused;
    private bool _busy;
    private bool _loading = true;
    private bool _confirmClear;
    private string? _notice;

    private ElementReference _consoleRef;
    private IJSObjectReference? _module;
    private bool _followTail = true;
    private bool _scrollAfterRender;
    private Task? _pollTask;

    [SupplyParameterFromQuery(Name = "executionId")]
    public Guid? ExecutionId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (ExecutionId.HasValue)
        {
            _executionFilter = ExecutionId.Value.ToString();
        }

        if (FlowId.HasValue)
        {
            _flowFilter = FlowId.Value.ToString();
        }

        await LoadFilterOptionsAsync();
        await ReloadAsync();

        _pollTask = PollAsync(_cts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Dynamic import keeps this page self-contained: no script tag in index.html.
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/logs-console.js");
            }
            catch (Exception)
            {
                _module = null; // Auto-scroll degrades gracefully to "no auto-scroll".
            }
        }

        if (_scrollAfterRender)
        {
            _scrollAfterRender = false;
            await ScrollToBottomAsync();
        }
    }

    private async Task PollAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (_paused || _busy)
                {
                    continue;
                }

                try
                {
                    await TailAsync();
                }
                catch (Exception)
                {
                    // A single bad tick must never kill live tailing: this task is
                    // fire-and-forget, so an escaping exception would stop the loop
                    // permanently and silently. Skip this tick and try again.
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Navigating away.
        }
    }

    private async Task LoadFilterOptionsAsync()
    {
        var levels = await SafeFetch.GetAsync<string[]>(Http, "api/logs/levels", Dispatcher, "log levels");
        if (levels != null)
        {
            _levels = levels;
        }

        await RefreshSourcesAsync();
        await RefreshIntegrationsAsync();
        await RefreshFlowsAsync();
        await RefreshFacetsAsync();
    }

    private async Task RefreshFacetsAsync()
    {
        var facets = await SafeFetch.GetAsync<LogFacetsDto>(Http, "api/logs/facets", Dispatcher, "log facets");
        if (facets == null) return;
        _services = facets.Services.ToArray();
        _components = facets.Components.ToArray();
        _events = facets.Events.ToArray();
        _outcomes = facets.Outcomes.ToArray();
    }
    private async Task RefreshSourcesAsync()
    {
        var sources = await SafeFetch.GetAsync<string[]>(Http, "api/logs/sources", Dispatcher, "log sources");
        if (sources != null)
        {
            _sources = sources;
        }
    }

    private async Task RefreshIntegrationsAsync()
    {
        var integrations = await SafeFetch.GetAsync<List<IntegrationDto>>(Http, "api/integrations", Dispatcher, "integrations");
        if (integrations != null)
        {
            _integrations = integrations
                .Where(integration => integration.Id != Guid.Empty)
                .OrderBy(integration => integration.Name)
                .Select(integration => new IntegrationOption(integration.Id, string.IsNullOrWhiteSpace(integration.Name) ? ShortId(integration.Id) : integration.Name))
                .ToList();
        }
    }
    private async Task RefreshFlowsAsync()
    {
        var flows = await SafeFetch.GetAsync<IntegrationFlowDto[]>(Http, "api/integrationflow", Dispatcher, "flows");
        if (flows != null)
        {
            _flows = flows
                .Where(flow => flow.Id != Guid.Empty)
                .OrderBy(flow => flow.Name)
                .Select(flow => new FlowOption(flow.Id, string.IsNullOrWhiteSpace(flow.Name) ? ShortId(flow.Id) : flow.Name))
                .ToList();
        }
    }

    // Full refresh: replaces the buffer and re-anchors the tail cursor.
    private async Task ReloadAsync()
    {
        _busy = true;
        _loading = true;

        LogPageDto? page;
        try
        {
            page = await SafeFetch.GetAsync<LogPageDto>(
                Http, $"api/logs?{BuildFilterQuery()}&page=1&pageSize={InitialPageSize}", Dispatcher, "logs");
        }
        finally
        {
            // Must never stick: the poll loop skips every tick while _busy is true,
            // which silently freezes the live tail with no visible error.
            _busy = false;
            _loading = false;
        }

        if (page == null)
        {
            _notice = "Log polling paused because the API could not be reached. Press Resume to try again.";
            _paused = true;
            return;
        }

        _notice = null;
        _entries.Clear();
        _expanded.Clear();

        // The API returns newest-first for paging; the console reads oldest-first.
        _entries.AddRange(page.Items.OrderBy(entry => entry.Id));
        _total = page.Total;
        _cursor = page.Cursor;
        _followTail = true;
        _scrollAfterRender = true;
    }

    private async Task TailAsync()
    {
        _busy = true;

        LogTailDto? tail;
        try
        {
            // Ask the browser whether the user is still parked at the bottom BEFORE appending,
            // so reading scrollback is never interrupted by the tail.
            _followTail = await IsPinnedToBottomAsync();

            tail = await SafeFetch.GetAsync<LogTailDto>(
                Http, $"api/logs/tail?afterId={_cursor}&{BuildFilterQuery()}&limit=500", Dispatcher, "log tail");
        }
        finally
        {
            _busy = false;
        }

        if (tail == null)
        {
            // Stop hammering a dead API — one toast, then wait for the user.
            _paused = true;
            _notice = "Log polling paused because the API could not be reached. Press Resume to try again.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (tail.Reset)
        {
            // Cursor was ahead of the table (logs cleared elsewhere): rebuild the buffer.
            _entries.Clear();
            _expanded.Clear();
        }

        if (tail.Entries.Count == 0 && !tail.Reset)
        {
            _cursor = tail.Cursor;
            return;
        }

        _entries.AddRange(tail.Entries);
        _cursor = tail.Cursor;
        _total = Math.Max(_total, _entries.Count);
        TrimBuffer();

        if (_followTail)
        {
            _scrollAfterRender = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void TrimBuffer()
    {
        if (_entries.Count <= MaxBufferedEntries)
        {
            return;
        }

        var excess = _entries.Count - MaxBufferedEntries;
        for (var i = 0; i < excess; i++)
        {
            _expanded.Remove(_entries[i].Id);
        }

        _entries.RemoveRange(0, excess);
    }

    private string ComponentLabel(AppLogEntryDto entry) => string.IsNullOrWhiteSpace(entry.Service) ? (string.IsNullOrWhiteSpace(entry.Component) ? entry.Source : entry.Component) : $"{entry.Service} / {(string.IsNullOrWhiteSpace(entry.Component) ? entry.Category : entry.Component)}";

    private string BuildFilterQuery()
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(_level))
        {
            parts.Add($"level={Uri.EscapeDataString(_level)}");
        }

        if (!string.IsNullOrWhiteSpace(_service)) parts.Add($"service={Uri.EscapeDataString(_service)}");
        if (!string.IsNullOrWhiteSpace(_component)) parts.Add($"component={Uri.EscapeDataString(_component)}");
        if (!string.IsNullOrWhiteSpace(_eventName)) parts.Add($"eventName={Uri.EscapeDataString(_eventName)}");
        if (!string.IsNullOrWhiteSpace(_outcome)) parts.Add($"outcome={Uri.EscapeDataString(_outcome)}");

        if (!string.IsNullOrWhiteSpace(_source))
        {
            parts.Add($"source={Uri.EscapeDataString(_source)}");
        }

        if (Guid.TryParse(_integrationFilter, out var integrationId))
        {
            parts.Add($"integrationId={integrationId}");
        }

        if (Guid.TryParse(_flowFilter, out var flowId))
        {
            parts.Add($"flowId={flowId}");
        }

        if (!string.IsNullOrWhiteSpace(_search))
        {
            parts.Add($"search={Uri.EscapeDataString(_search)}");
        }

        if (Guid.TryParse(_executionFilter, out var executionId))
        {
            parts.Add($"flowExecutionId={executionId}");
        }

        return string.Join("&", parts);
    }

    private Task OnServiceChanged(ChangeEventArgs args) => ApplyFilterAsync(() => _service = args.Value?.ToString() ?? string.Empty);
    private Task OnComponentChanged(ChangeEventArgs args) => ApplyFilterAsync(() => _component = args.Value?.ToString() ?? string.Empty);
    private Task OnEventChanged(ChangeEventArgs args) => ApplyFilterAsync(() => _eventName = args.Value?.ToString() ?? string.Empty);
    private Task OnOutcomeChanged(ChangeEventArgs args) => ApplyFilterAsync(() => _outcome = args.Value?.ToString() ?? string.Empty);
    private async Task ApplyFilterAsync(Action update)
    {
        update();
        await ReloadAsync();
    }
    private async Task OnLevelChanged(ChangeEventArgs args)
    {
        _level = args.Value?.ToString() ?? string.Empty;
        await ReloadAsync();
    }

    private async Task OnSourceChanged(ChangeEventArgs args)
    {
        _source = args.Value?.ToString() ?? string.Empty;
        await ReloadAsync();
    }

    private async Task OnIntegrationChanged(ChangeEventArgs args)
    {
        _integrationFilter = args.Value?.ToString() ?? string.Empty;
        await ReloadAsync();
    }

    private async Task OnFlowChanged(ChangeEventArgs args)
    {
        _flowFilter = args.Value?.ToString() ?? string.Empty;
        await ReloadAsync();
    }

    private async Task OnSearchChanged(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        await ReloadAsync();
    }

    private LogTimelineDto? _timeline;
    private async Task OpenTimelineAsync(Guid executionId)
    {
        _timeline = await SafeFetch.GetAsync<LogTimelineDto>(Http, $"api/logs/execution/{executionId}/timeline?limit=1500", Dispatcher, "execution timeline");
        await InvokeAsync(StateHasChanged);
    }
    private void CloseTimeline() => _timeline = null;

    private async Task OnExecutionFilterChanged(ChangeEventArgs args)
    {
        _executionFilter = args.Value?.ToString()?.Trim() ?? string.Empty;
        await ReloadAsync();
    }

    private async Task FilterByExecutionAsync(Guid executionId)
    {
        _executionFilter = executionId.ToString();
        await ReloadAsync();
    }

    private async Task FilterByIntegrationAsync(Guid integrationId)
    {
        _integrationFilter = integrationId.ToString();
        await ReloadAsync();
    }

    private async Task FilterByFlowAsync(Guid flowId)
    {
        _flowFilter = flowId.ToString();
        await ReloadAsync();
    }

    private async Task TogglePause()
    {
        _paused = !_paused;
        if (!_paused)
        {
            _notice = null;
            await ReloadAsync();
        }
    }

    private async Task RefreshAsync()
    {
        await RefreshSourcesAsync();
        await RefreshIntegrationsAsync();
        await ReloadAsync();
    }

    private async Task ClearLogsAsync()
    {
        _confirmClear = false;

        var result = await SafeFetch.SendAsync<LogDeleteResultDto>(
            () => Http.DeleteAsync("api/logs"), Dispatcher, "the log clear");

        if (result != null)
        {
            Dispatcher.Dispatch(new ShowToastAction { Message = $"Cleared {result.Deleted} log entr{(result.Deleted == 1 ? "y" : "ies")}." });
        }

        _cursor = 0;
        await ReloadAsync();
    }

    private void ToggleExpanded(AppLogEntryDto entry)
    {
        if (!HasDetail(entry))
        {
            return;
        }

        if (!_expanded.Remove(entry.Id))
        {
            _expanded.Add(entry.Id);
        }
    }

    private async Task<bool> IsPinnedToBottomAsync()
    {
        if (_module == null)
        {
            return true;
        }

        try
        {
            return await _module.InvokeAsync<bool>("isPinnedToBottom", _consoleRef);
        }
        catch (Exception)
        {
            return true;
        }
    }

    private async Task ScrollToBottomAsync()
    {
        if (_module == null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("scrollToBottom", _consoleRef);
        }
        catch (Exception)
        {
            // The page is going away, or JS interop is unavailable.
        }
    }

    private static bool HasDetail(AppLogEntryDto entry) =>
        !string.IsNullOrWhiteSpace(entry.Exception)
        || !string.IsNullOrWhiteSpace(entry.IntegrationName)
        || entry.IntegrationId.HasValue
        || !string.IsNullOrWhiteSpace(entry.FlowName)
        || entry.FlowExecutionId.HasValue
        || entry.FlowId.HasValue
        || entry.TenantId.HasValue
        || entry.Category.Contains('.');

    private string IntegrationLabel(AppLogEntryDto entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.IntegrationName))
        {
            return entry.IntegrationName;
        }

        if (entry.IntegrationId is Guid integrationId)
        {
            return _integrations.FirstOrDefault(integration => integration.Id == integrationId)?.Name ?? ShortId(integrationId);
        }

        return entry.FlowId.HasValue ? "Unassigned" : "System";
    }

    private string FlowLabel(AppLogEntryDto entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.FlowName))
        {
            return entry.FlowName;
        }

        if (entry.FlowId is Guid flowId)
        {
            return _flows.FirstOrDefault(flow => flow.Id == flowId)?.Name ?? ShortId(flowId);
        }

        return "—";
    }
    private static string ShortLevel(string level) => level switch
    {
        "Information" => "INFO",
        "Warning" => "WARN",
        "Critical" => "CRIT",
        "Trace" => "TRCE",
        "Debug" => "DBUG",
        "Error" => "FAIL",
        _ => level.ToUpperInvariant()
    };

    // Loggers are categorised by full type name; the last segment is what reads well.
    private static string ShortCategory(string category)
    {
        if (string.IsNullOrEmpty(category))
        {
            return "-";
        }

        var index = category.LastIndexOf('.');
        return index >= 0 && index < category.Length - 1 ? category[(index + 1)..] : category;
    }

    private static string ShortId(Guid id) => id == Guid.Empty ? "-" : id.ToString()[..8];

    private sealed record IntegrationOption(Guid Id, string Name);

    private sealed record FlowOption(Guid Id, string Name);

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();

        if (_pollTask != null)
        {
            try
            {
                await _pollTask;
            }
            catch (Exception)
            {
                // Cancellation during navigation.
            }
        }

        if (_module != null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (Exception)
            {
                // The circuit/runtime may already be gone.
            }
        }

        _cts.Dispose();
    }
}
