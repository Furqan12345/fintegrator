@page "/"
@using System.Net.Http.Json
@using SimpleIPaaS.Client.Store
@using SimpleIPaaS.Shared.Models
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager
@inject HttpClient Http

<PageTitle>Integrations - SimpleIPaaS</PageTitle>

<div class="page-scroll integrations-page">
    <div class="page-header">
        <div class="header-left">
            <h2>Integrations</h2>
            <p class="subtitle">Organize flows under integrations and keep standalone flows separate when needed.</p>
        </div>
        <div class="header-right">
            <button class="btn btn-outline" @onclick="CreateStandaloneFlow">+ Standalone Flow</button>
        </div>
    </div>

    <div class="wizard-form integrations-create-form">
        <div class="form-group">
            <label>New Integration Name</label>
            <input type="text" class="form-control" @bind="_newIntegrationName" placeholder="e.g. HubSpot Sync" />
        </div>
        <div class="form-group">
            <label>Description</label>
            <input type="text" class="form-control" @bind="_newIntegrationDescription" placeholder="Optional description" />
        </div>
        <button class="btn btn-primary" @onclick="CreateIntegration" disabled="@_isLoading">Create Integration</button>
    </div>

    @if (_loadError != null)
    {
        <div class="loading-state error-state">
            <p class="error-text">@_loadError</p>
            <button class="btn btn-outline btn-sm" @onclick="LoadDataAsync">Retry</button>
        </div>
    }
    else if (_isLoading)
    {
        <div class="loading-state">Loading integrations...</div>
    }
    else
    {
        <div class="integrations-grid">
            @if (!_integrations.Any())
            {
                <div class="empty-state">
                    <span class="empty-icon"><AppIcon Name="integrations" Class="icon icon-lg" /></span>
                    <h3>No integrations yet</h3>
                    <p>Create an integration above, then add flows inside it.</p>
                </div>
            }
            else
            {
                @foreach (var integration in _integrations)
                {
                    <div class="integration-card">
                        <div class="card-header">
                            <h3 class="card-title">@integration.Name</h3>
                        </div>
                        <div class="card-body">
                            <p class="card-desc">@(string.IsNullOrWhiteSpace(integration.Description) ? "No description provided." : integration.Description)</p>
                            <div class="card-meta">
                                <span>Flows: @integration.Flows.Count</span>
                                <span>Updated: @integration.UpdatedAt.ToShortDateString()</span>
                            </div>
                            <div class="flow-list">
                                @foreach (var flow in integration.Flows)
                                {
                                    <div class="card flow-list-item" @onclick="() => EditFlow(flow.Id)">
                                        <div class="flow-list-row">
                                            <div>
                                                <div class="flow-list-name">@flow.Name</div>
                                                <div class="text-muted">Steps: @flow.Nodes.Count</div>
                                            </div>
                                            <div class="inline-actions">
                                                <button class="btn btn-sm btn-outline" @onclick:stopPropagation="true" @onclick="() => RunFlow(flow.Id)" title="Run Flow">Run</button>
                                                <button class="btn btn-sm btn-outline" @onclick:stopPropagation="true" @onclick="() => AskDeleteFlow(flow)" title="Delete Flow">Delete</button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer">
                            <button class="btn btn-outline" @onclick="() => CreateFlow(integration.Id)">+ New Flow</button>
                        </div>
                    </div>
                }
            }
        </div>

        @if (_standaloneFlows.Any())
        {
            <div class="page-header standalone-header">
                <div class="header-left">
                    <h2>Standalone Flows</h2>
                </div>
            </div>

            <div class="integrations-grid">
                @foreach (var flow in _standaloneFlows)
                {
                    <div class="integration-card" @onclick="() => EditFlow(flow.Id)">
                        <div class="card-header">
                            <h3 class="card-title">@flow.Name</h3>
                            <span class="status-badge @(flow.Status.ToLowerInvariant())">@flow.Status</span>
                        </div>
                        <div class="card-body">
                            <p class="card-desc">@(string.IsNullOrWhiteSpace(flow.Description) ? "No description provided." : flow.Description)</p>
                            <div class="card-meta">
                                <span>Trigger: @flow.TriggerType</span>
                                <span>Steps: @flow.Nodes.Count</span>
                            </div>
                        </div>
                        <div class="card-footer">
                            <span class="text-muted">Updated @flow.UpdatedAt.ToShortDateString()</span>
                            <div class="inline-actions">
                                <button class="btn btn-sm btn-outline" @onclick:stopPropagation="true" @onclick="() => RunFlow(flow.Id)" title="Run Flow">Run</button>
                                <button class="btn btn-sm btn-outline" @onclick:stopPropagation="true" @onclick="() => AskDeleteFlow(flow)" title="Delete Flow">Delete</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@if (_deleteTarget != null)
{
    <div class="modal-overlay" @onclick="CancelDeleteFlow">
        <div class="modal-container confirm-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">Delete flow</h2>
                <button class="modal-close-btn" @onclick="CancelDeleteFlow">✕</button>
            </div>
            <div class="modal-body">
                <p>This permanently deletes <strong>@_deleteTarget.Name</strong> and its history. Type the flow name to confirm.</p>
                <div class="form-group">
                    <input type="text" class="form-control" @bind="_deleteConfirmName" @bind:event="oninput" placeholder="@_deleteTarget.Name" />
                </div>
                <div class="modal-actions">
                    <button class="btn btn-outline" @onclick="CancelDeleteFlow">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteFlow" disabled="@(!string.Equals(_deleteConfirmName, _deleteTarget.Name, StringComparison.Ordinal))">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<IntegrationDto> _integrations = new();
    private List<IntegrationFlowDto> _standaloneFlows = new();
    private string _newIntegrationName = string.Empty;
    private string _newIntegrationDescription = string.Empty;
    private bool _isLoading;
    private string? _loadError;
    private IntegrationFlowDto? _deleteTarget;
    private string _deleteConfirmName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            _integrations = await Http.GetFromJsonAsync<List<IntegrationDto>>("api/integrations") ?? new List<IntegrationDto>();
            var allFlows = await Http.GetFromJsonAsync<List<IntegrationFlowDto>>("api/integrationflow") ?? new List<IntegrationFlowDto>();
            _standaloneFlows = allFlows.Where(flow => flow.IntegrationId == null).OrderByDescending(flow => flow.UpdatedAt).ToList();
        }
        catch (HttpRequestException ex)
        {
            // The API is frequently unreachable for a few seconds right after a build/restart.
            // Reset the loading flag and surface a retry instead of pinning the page on
            // "Loading..." until a manual browser refresh (the old behaviour).
            _loadError = $"Could not reach the API: {ex.Message}";
            _ = Task.Delay(TimeSpan.FromSeconds(3)).ContinueWith(_ => InvokeAsync(LoadDataAsync));
        }
        catch (TaskCanceledException ex)
        {
            _loadError = "The API is not responding yet. Retrying…";
            _ = Task.Delay(TimeSpan.FromSeconds(3)).ContinueWith(_ => InvokeAsync(LoadDataAsync));
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load integrations: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateIntegration()
    {
        if (string.IsNullOrWhiteSpace(_newIntegrationName))
        {
            return;
        }

        var response = await Http.PostAsJsonAsync("api/integrations", new IntegrationDto
        {
            Name = _newIntegrationName.Trim(),
            Description = _newIntegrationDescription.Trim()
        });

        if (response.IsSuccessStatusCode)
        {
            _newIntegrationName = string.Empty;
            _newIntegrationDescription = string.Empty;
            await LoadDataAsync();
        }
    }

    private void CreateStandaloneFlow()
    {
        NavigationManager.NavigateTo("/flow");
    }

    private void CreateFlow(Guid integrationId)
    {
        NavigationManager.NavigateTo($"/flow?integrationId={integrationId}");
    }

    private void EditFlow(Guid flowId)
    {
        NavigationManager.NavigateTo($"/flow/{flowId}");
    }

    private void RunFlow(Guid flowId)
    {
        Dispatcher.Dispatch(new RunFlowAction { Id = flowId });
    }

    private void AskDeleteFlow(IntegrationFlowDto flow)
    {
        _deleteTarget = flow;
        _deleteConfirmName = string.Empty;
    }

    private void CancelDeleteFlow()
    {
        _deleteTarget = null;
        _deleteConfirmName = string.Empty;
    }

    private async Task ConfirmDeleteFlow()
    {
        if (_deleteTarget == null || !string.Equals(_deleteConfirmName, _deleteTarget.Name, StringComparison.Ordinal))
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/integrationflow/{_deleteTarget.Id}");
        if (response.IsSuccessStatusCode)
        {
            _deleteTarget = null;
            _deleteConfirmName = string.Empty;
            await LoadDataAsync();
        }
    }
}
