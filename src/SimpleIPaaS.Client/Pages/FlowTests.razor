    private bool ApplyHeaders()
    {
        foreach (var response in _definition.HttpResponses.Values.SelectMany(item => item))
        {
            if (!HeadersText.TryGetValue(response, out var text)) continue;
            if (string.IsNullOrWhiteSpace(text)) { response.Headers = new(); continue; }
            try { response.Headers = JsonSerializer.Deserialize<Dictionary<string, string[]>>(text, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new(); }
            catch { _message = "One HTTP fixture has invalid headers JSON."; return false; }
        }
        return true;
