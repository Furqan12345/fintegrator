        await SaveAsync(); if (_dirty || _selectedId == Guid.Empty) return; _busy = true; _message = "Test queued."; _showResults = true;
        try { var response = await Http.PostAsync($"api/integrationflow/{FlowId}/test-cases/{_selectedId}/run", null); _message = response.IsSuccessStatusCode ? "Test queued. Results will appear below." : await response.Content.ReadAsStringAsync(); await Task.Delay(400); await LoadRunsAsync(); }
        finally { _busy = false; }
    }
    private async Task RunEnabledAsync()
    {
        _busy = true; _showResults = true;
        try
        {
            var enabled = _tests.Where(test => test.Enabled).ToList();
            var completed = 0;
            foreach (var test in enabled)
            {
                var response = await Http.PostAsync($"api/integrationflow/{FlowId}/test-cases/{test.Id}/run", null);
                if (response.IsSuccessStatusCode)
                {
                    using var document = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
                    if (document.RootElement.TryGetProperty("testRunId", out var runId) && Guid.TryParse(runId.GetString(), out var testRunId)) await WaitForRunAsync(test.Id, testRunId);
                }
                completed++;
            }
            _message = $"Completed {completed} enabled scenario(s) sequentially. Individual failures did not stop the suite.";
            await LoadRunsAsync();
        }
        finally { _busy = false; }
    }

    private async Task WaitForRunAsync(Guid testCaseId, Guid testRunId)
    {
        for (var attempt = 0; attempt < 240; attempt++)
        {
            var runs = await Http.GetFromJsonAsync<List<FlowTestRunDto>>($"api/integrationflow/{FlowId}/test-cases/{testCaseId}/runs") ?? new();
            var run = runs.FirstOrDefault(item => item.Id == testRunId);
            if (run?.Status is "Passed" or "Failed" or "Cancelled") return;
            await Task.Delay(500);
        }
    }
    private async Task LoadRunsAsync()
