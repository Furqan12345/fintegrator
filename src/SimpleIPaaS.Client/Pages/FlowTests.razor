        var target = index + offset;
        if (index < 0 || target < 0 || target >= _selectedHttpResponses.Count) return;
        _selectedHttpResponses.RemoveAt(index);
        _selectedHttpResponses.Insert(target, response);
        if (_selectedNode != null) _definition.HttpResponses[_selectedNode.StepConfig.Id.ToString()] = _selectedHttpResponses;
