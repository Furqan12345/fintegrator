    private static string DisplayOperator(string? value) => value?.ToLowerInvariant() switch { "contains" => "must contain", "notcontains" => "must not contain", "startswith" => "must start with", "endswith" => "must end with", "notequals" => "must not equal", _ => "must equal" };
