@inherits LayoutComponentBase
@implements IDisposable
@using SimpleIPaaS.Client.Shared
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject SimpleIPaaS.Client.Services.AiBuildJobTracker BuildTracker
@inject SimpleIPaaS.Client.Services.AuthSession Auth
@inject SimpleIPaaS.Client.Services.PageVisibilityService Visibility

<ToastHost />

<div class="app-layout @SidebarLayoutClass">
 <!-- Sidebar -->
 <aside class="app-sidebar" aria-label="Primary">
        <div class="sidebar-brand">
            <span class="brand-icon"><AppIcon Name="brand" Class="icon icon-sm" /></span>
            <span class="brand-text">fusetor.com</span>
        </div>

        <nav class="sidebar-nav" aria-label="Main navigation">
            <div class="sidebar-section-label">Build</div>
            <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All" title="Dashboard">
                <span class="sidebar-icon"><AppIcon Name="dashboard" /></span>
                <span>Dashboard</span>
            </NavLink>
            <NavLink class="sidebar-link" href="integrations" title="Integrations">
                <span class="sidebar-icon"><AppIcon Name="integrations" /></span>
                <span>Integrations</span>
            </NavLink>
            <NavLink class="sidebar-link" href="ai-builder" title="Build with AI">
                <span class="sidebar-icon"><AppIcon Name="flows" /></span>
                <span>Build with AI</span>
            </NavLink>
            <NavLink class="sidebar-link" href="connections" title="Connections">
                <span class="sidebar-icon"><AppIcon Name="connections" /></span>
                <span>Connections</span>
            </NavLink>
            <AuthorizeView Roles="Admin">
                <NavLink class="sidebar-link" href="ai-providers" title="AI Providers">
                    <span class="sidebar-icon"><AppIcon Name="sparkline" /></span>
                    <span>AI Providers</span>
                </NavLink>
            </AuthorizeView>
            <NavLink class="sidebar-link" href="cross-references" title="Cross-References">
                <span class="sidebar-icon"><AppIcon Name="crossreferences" /></span>
                <span>Cross-References</span>
            </NavLink>

            <div class="sidebar-section-label">Monitor</div>
            <NavLink class="sidebar-link" href="transaction-history" title="Transactions">
                <span class="sidebar-icon"><AppIcon Name="transactions" /></span>
                <span>Transactions</span>
            </NavLink>
            <NavLink class="sidebar-link" href="packet-logs" title="Packet Logs">
                <span class="sidebar-icon"><AppIcon Name="external" /></span>
                <span>Packet Logs</span>
            </NavLink>
            <NavLink class="sidebar-link" href="deadletters" title="Dead Letters">
                <span class="sidebar-icon"><AppIcon Name="deadletters" /></span>
                <span>Dead Letters</span>
            </NavLink>
            <NavLink class="sidebar-link" href="logs" title="Debug Logs">
                <span class="sidebar-icon"><AppIcon Name="logs" /></span>
                <span>Debug Logs</span>
            </NavLink>

            <div class="sidebar-section-label">System</div>
            <AuthorizeView Roles="Admin">
                <NavLink class="sidebar-link" href="settings" title="Failure alerts, storage and retention">
                    <span class="sidebar-icon"><AppIcon Name="settings" /></span>
                    <span>Settings</span>
                </NavLink>
                <NavLink class="sidebar-link" href="admin/users" title="Users and access">
                    <span class="sidebar-icon"><AppIcon Name="users" /></span>
                    <span>Users</span>
                </NavLink>
            </AuthorizeView>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-env-badge">Development</div>
        </div>
    </aside>

    <!-- Main content area -->
    <div class="app-main">
        <!-- Top bar -->
        <header class="app-topbar">
            <div class="topbar-left">
                <button type="button" class="topbar-icon-btn sidebar-toggle" @onclick="ToggleSidebar" title="@SidebarToggleLabel" aria-label="@SidebarToggleLabel">
                    <AppIcon Name="@(_sidebarCollapsed ? "chevron-right" : "chevron-left")" Class="icon icon-sm" />
                </button>
                <h1 class="topbar-title">@PageHeading</h1>
            </div>
            <div class="topbar-right">
                @if (BuildTracker.IsRestoring)
                {
                    <span class="topbar-build-status is-restoring">Checking AI builds…</span>
                }
                else if (BuildTracker.CurrentJob is { Status: "Queued" or "Running" } buildJob)
                {
                    <button type="button" class="topbar-build-status" @onclick="OpenBuildStatus" title="Open AI build status">
                        <span class="status-dot"></span>AI @(buildJob.Status == "Queued" ? "waiting" : "building") · @buildJob.ToolCallsUsed tools
                    </button>
                }
                else if (BuildTracker.CurrentJob is { Status: "Completed" })
                {
                    <button type="button" class="topbar-build-status is-complete" @onclick="OpenBuildStatus" title="Review the completed AI draft">
                        AI draft ready · Review
                    </button>
                }
                <span class="topbar-status @HealthCssClass" title="@HealthDetail" role="status" aria-live="polite">
                    <span class="status-dot"></span><span class="topbar-status-label">@HealthLabel</span>
                </span>
                <button type="button" class="topbar-icon-btn" title="@ThemeToggleLabel" aria-label="@ThemeToggleLabel"
                        aria-pressed="@(_isDarkTheme ? "true" : "false")" @onclick="ToggleThemeAsync">
                    <AppIcon Name="@(_isDarkTheme ? "sun" : "moon")" Class="icon icon-sm" />
                </button>
                @if (Auth.User is { } signedInUser)
                {
                    <span class="topbar-divider" aria-hidden="true"></span>
                    <div class="topbar-user">
                        <span class="topbar-avatar" aria-hidden="true">@AccountInitial(signedInUser.Email)</span>
                        <span class="topbar-user-meta">
                            <span class="topbar-user-email" title="@signedInUser.Email">@signedInUser.Email</span>
                            <span class="topbar-user-role">@signedInUser.Role</span>
                        </span>
                        <button type="button" class="topbar-signout" title="Sign out" aria-label="Sign out" @onclick="SignOutAsync">
                            <AppIcon Name="logout" Class="icon icon-xs" />
                            <span class="topbar-signout-label">Sign out</span>
                        </button>
                    </div>
                }
            </div>
        </header>

        @if (_logVolume is { Level: "Approaching" or "Reached" } volume && _logVolumeDismissedLevel != volume.Level)
        {
            <div class="app-banner @(volume.Level == "Reached" ? "is-danger" : string.Empty)" role="status" aria-live="polite">
                <span class="app-banner-text">
                    <strong>@(volume.Level == "Reached" ? "Stored logs passed the alert limit." : "Stored logs are close to the alert limit.")</strong>
                    @volume.StoredLines.ToString("N0") of @volume.AlertRows.ToString("N0") lines@(volume.StoredBytes is { } bytes ? $" ({FormatBytes(bytes)})" : string.Empty);
                    @volume.LastDayLines.ToString("N0") in the last 24 hours@(volume.TopCategories.FirstOrDefault() is { } top && volume.LastDayLines > 0 ? $", {top.Lines * 100 / volume.LastDayLines}% from {top.Name}" : string.Empty)@(volume.TopFlows.FirstOrDefault() is { } flow ? $"; busiest flow: {flow.Name}" : string.Empty).
                    Nothing is deleted because of it; logs leave by age only.
                </span>
                <span class="app-banner-actions">
                    <a class="btn btn-sm btn-outline" href="logs">Debug Logs</a>
                    <a class="btn btn-sm btn-outline" href="settings">Settings</a>
                    <button type="button" class="btn btn-sm btn-soft" @onclick="() => _logVolumeDismissedLevel = volume.Level">Dismiss</button>
                </span>
            </div>
        }

        <!-- Page content -->
        <main class="app-content">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="app-error-boundary" role="alert">
                        <h3>This page stopped working</h3>
                        <p>@ErrorText.Describe(context)</p>
                        <div class="app-error-actions">
                            <button class="btn btn-primary" @onclick="RecoverPage">Try again</button>
                            <button class="btn btn-outline" onclick="location.reload()">Reload the app</button>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

@code {
    private enum ApiHealth { Unknown, Healthy, Degraded, Offline }

    private ApiHealth _health = ApiHealth.Unknown;
    private bool _isDarkTheme;
    private bool _sidebarCollapsed;
    private System.Threading.Timer? _healthTimer;
    private System.Threading.Timer? _logVolumeTimer;
    private LogVolumeDto? _logVolume;
    private string? _logVolumeDismissedLevel;

    private string SidebarLayoutClass => _sidebarCollapsed ? "sidebar-collapsed" : string.Empty;
    private string SidebarToggleLabel => _sidebarCollapsed ? "Show navigation" : "Hide navigation";

    private string PageHeading => HeadingFor(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

    private string HealthLabel => _health switch
    {
        ApiHealth.Healthy => "API healthy",
        ApiHealth.Degraded => "API degraded",
        ApiHealth.Offline => "API offline",
        _ => "Checking API"
    };

    private string HealthCssClass => _health switch
    {
        ApiHealth.Healthy => "is-healthy",
        ApiHealth.Degraded => "is-degraded",
        ApiHealth.Offline => "is-offline",
        _ => string.Empty
    };

    private string HealthDetail => _health switch
    {
        ApiHealth.Healthy => "The API health endpoint reported Healthy.",
        ApiHealth.Degraded => "The API responded, but reported a degraded or unhealthy state.",
        ApiHealth.Offline => "The API could not be reached.",
        _ => "Contacting the API health endpoint..."
    };

    private string ThemeToggleLabel => _isDarkTheme ? "Switch to light theme" : "Switch to dark theme";

    private static string AccountInitial(string? email)
    {
        var value = (email ?? string.Empty).Trim();
        return value.Length == 0 ? "?" : value[..1].ToUpperInvariant();
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        NavigationManager.LocationChanged += OnLocationChanged;
        BuildTracker.Changed += OnBuildChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
        {
            return;
        }

        await Visibility.StartAsync();
        await BuildTracker.RestoreActiveJobAsync();
        await LoadThemeAsync();
        await LoadSidebarAsync();
        await CheckHealthAsync();
        _healthTimer = new System.Threading.Timer(_ => { if (Visibility.IsVisible) _ = InvokeAsync(CheckHealthAsync); }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));

        // The log volume alert (admins only): the same check the Engine emails about.
        if (Auth.IsAdmin)
        {
            await CheckLogVolumeAsync();
            _logVolumeTimer = new System.Threading.Timer(_ => { if (Visibility.IsVisible) _ = InvokeAsync(CheckLogVolumeAsync); }, null, TimeSpan.FromMinutes(5), TimeSpan.FromMinutes(5));
        }
    }

    private async Task CheckLogVolumeAsync()
    {
        try
        {
            using var response = await Http.GetAsync("api/logs/volume");
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            _logVolume = await response.Content.ReadFromJsonAsync<LogVolumeDto>();
            StateHasChanged();
        }
        catch (Exception)
        {
            // The banner is advisory; the health indicator already reports an unreachable API.
        }
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double value = bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {units[unit]}";
    }

    private async Task LoadThemeAsync()
    {
        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("simpleIPaaSTheme.get");
            _isDarkTheme = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
            StateHasChanged();
        }
        catch (JSException)
        {
        }
    }

    private async Task ToggleThemeAsync()
    {
        var next = _isDarkTheme ? "light" : "dark";
        try
        {
            var applied = await JSRuntime.InvokeAsync<string>("simpleIPaaSTheme.set", next);
            _isDarkTheme = string.Equals(applied, "dark", StringComparison.OrdinalIgnoreCase);
        }
        catch (JSException)
        {
        }
    }

    private async Task LoadSidebarAsync()
    {
        try
        {
            var saved = await JSRuntime.InvokeAsync<string>("simpleIPaaSLayout.getSidebar");
            _sidebarCollapsed = string.Equals(saved, "collapsed", StringComparison.OrdinalIgnoreCase);
            StateHasChanged();
        }
        catch (JSException)
        {
        }
    }

    private async Task ToggleSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        try
        {
            await JSRuntime.InvokeVoidAsync("simpleIPaaSLayout.setSidebar", _sidebarCollapsed ? "collapsed" : "expanded");
        }
        catch (JSException)
        {
        }
    }

    private async Task CheckHealthAsync()
    {
        ApiHealth result;
        try
        {
            using var response = await Http.GetAsync("health");
            var body = (await response.Content.ReadAsStringAsync()).Trim();
            result = response.IsSuccessStatusCode && body.Equals("Healthy", StringComparison.OrdinalIgnoreCase)
                ? ApiHealth.Healthy
                : ApiHealth.Degraded;
        }
        catch (Exception)
        {
            result = ApiHealth.Offline;
        }

        if (result != _health)
        {
            _health = result;
            StateHasChanged();
        }
    }

    private ErrorBoundary? _errorBoundary;

    // An ErrorBoundary stays in its error state until told otherwise, so without this every page reached
    // from the sidebar after a crash would keep showing the same error.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        InvokeAsync(() =>
        {
            _errorBoundary?.Recover();
            StateHasChanged();
        });
    }

    private void RecoverPage() => _errorBoundary?.Recover();

    private void OnBuildChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    private void OpenBuildStatus()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var path = relative.Split('?', '#')[0];
        var designerPath = path.StartsWith("flow/", StringComparison.OrdinalIgnoreCase) || path.StartsWith("flow-designer/", StringComparison.OrdinalIgnoreCase)
            ? "/" + path
            : "/flow-designer";
        NavigationManager.NavigateTo(designerPath + "?aiBuild=open");
    }

    private static string HeadingFor(string relativePath)
    {
        var path = relativePath.Split('?')[0].Split('#')[0].Trim('/');
        var parts = path.Split('/');
        var segment = parts[0].ToLowerInvariant();

        // Admin pages share one first segment, so they are told apart by the second.
        if (segment == "admin")
        {
            return parts.Length > 1 && parts[1].ToLowerInvariant() == "users" ? "Users" : "AI Build Budgets";
        }

        return segment switch
        {
            "" => "Dashboard",
            "integrations" => "Integrations",
            "ai-builder" => "Build with AI",
            "connections" => "Connections",
            "connection-wizard" => "Connection Setup",
            "ai-providers" => "AI Providers",
            "ai-provider-wizard" => "AI Provider Setup",
            "flow" or "flow-designer" or "flow-tests" => "Flow Designer",
            "activity" or "activity-log" => "Transactions",
            "transaction-history" => "Transaction History",
            "packet-logs" => "Packet Logs",
            "execution" or "execution-detail" => "Execution Details",
            "deadletters" => "Dead Letters",
            "cross-references" => "Cross-References",
            "logs" => "Debug Logs",
            "settings" => "Settings",
            "docs" => "Assertion Guide",
            _ => "fusetor.com"
        };
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _healthTimer?.Dispose();
        _healthTimer = null;
        _logVolumeTimer?.Dispose();
        _logVolumeTimer = null;
    }
}
