@inherits LayoutComponentBase
@implements IDisposable
@using SimpleIPaaS.Client.Shared
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<ToastHost />

<div class="app-layout @SidebarLayoutClass">
 <!-- Sidebar -->
 <aside class="app-sidebar">
        <div class="sidebar-brand">
            <span class="brand-icon"><AppIcon Name="brand" Class="icon icon-sm" /></span>
            <span class="brand-text">SimpleIPaaS</span>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Build</div>
            <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All" title="Dashboard">
                <span class="sidebar-icon"><AppIcon Name="dashboard" /></span>
                <span>Dashboard</span>
            </NavLink>
            <NavLink class="sidebar-link" href="connections" title="Connections">
                <span class="sidebar-icon"><AppIcon Name="connections" /></span>
                <span>Connections</span>
            </NavLink>
            <NavLink class="sidebar-link" href="cross-references" title="Cross-References">
                <span class="sidebar-icon"><AppIcon Name="crossreferences" /></span>
                <span>Cross-References</span>
            </NavLink>

            <div class="sidebar-section-label">Monitor</div>
            <NavLink class="sidebar-link" href="activity" title="Activity Log">
                <span class="sidebar-icon"><AppIcon Name="activity" /></span>
                <span>Activity Log</span>
            </NavLink>
            <NavLink class="sidebar-link" href="transaction-history" title="Transactions">
                <span class="sidebar-icon"><AppIcon Name="transactions" /></span>
                <span>Transactions</span>
            </NavLink>
            <NavLink class="sidebar-link" href="deadletters" title="Dead Letters">
                <span class="sidebar-icon"><AppIcon Name="deadletters" /></span>
                <span>Dead Letters</span>
            </NavLink>
            <NavLink class="sidebar-link" href="logs" title="Debug Logs">
                <span class="sidebar-icon"><AppIcon Name="logs" /></span>
                <span>Debug Logs</span>
            </NavLink>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-env-badge">Development</div>
        </div>
    </aside>

    <!-- Main content area -->
    <div class="app-main">
        <!-- Top bar -->
        <header class="app-topbar">
            <div class="topbar-left">
                <button type="button" class="topbar-icon-btn sidebar-toggle" @onclick="ToggleSidebar" title="@SidebarToggleLabel" aria-label="@SidebarToggleLabel">
                    <AppIcon Name="@(_sidebarCollapsed ? "chevron-right" : "chevron-left")" Class="icon icon-sm" />
                </button>
                <h1 class="topbar-title">@PageHeading</h1>
            </div>
            <div class="topbar-right">
                <span class="topbar-status @HealthCssClass" title="@HealthDetail">
                    <span class="status-dot"></span>@HealthLabel
                </span>
                <button type="button" class="topbar-icon-btn" title="@ThemeToggleLabel" aria-label="@ThemeToggleLabel" @onclick="ToggleThemeAsync">
                    <AppIcon Name="@(_isDarkTheme ? "sun" : "moon")" Class="icon icon-sm" />
                </button>
            </div>
        </header>

        <!-- Page content -->
        <div class="app-content">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="app-error-boundary">
                        <h3>Something went wrong</h3>
                        <p>@context.Message</p>
                        <button class="btn" onclick="location.reload()">Reload Page</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </div>
</div>

@code {
    private enum ApiHealth { Unknown, Healthy, Degraded, Offline }

    private ApiHealth _health = ApiHealth.Unknown;
    private bool _isDarkTheme;
    private bool _sidebarCollapsed;
    private System.Threading.Timer? _healthTimer;

    private string SidebarLayoutClass => _sidebarCollapsed ? "sidebar-collapsed" : string.Empty;
    private string SidebarToggleLabel => _sidebarCollapsed ? "Show navigation" : "Hide navigation";

    private string PageHeading => HeadingFor(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

    private string HealthLabel => _health switch
    {
        ApiHealth.Healthy => "API healthy",
        ApiHealth.Degraded => "API degraded",
        ApiHealth.Offline => "API offline",
        _ => "Checking API"
    };

    private string HealthCssClass => _health switch
    {
        ApiHealth.Healthy => "is-healthy",
        ApiHealth.Degraded => "is-degraded",
        ApiHealth.Offline => "is-offline",
        _ => string.Empty
    };

    private string HealthDetail => _health switch
    {
        ApiHealth.Healthy => "The API health endpoint reported Healthy.",
        ApiHealth.Degraded => "The API responded, but reported a degraded or unhealthy state.",
        ApiHealth.Offline => "The API could not be reached.",
        _ => "Contacting the API health endpoint..."
    };

    private string ThemeToggleLabel => _isDarkTheme ? "Switch to light theme" : "Switch to dark theme";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
        {
            return;
        }

        await LoadThemeAsync();
        await LoadSidebarAsync();
        await CheckHealthAsync();
        _healthTimer = new System.Threading.Timer(_ => InvokeAsync(CheckHealthAsync), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadThemeAsync()
    {
        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("simpleIPaaSTheme.get");
            _isDarkTheme = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
            StateHasChanged();
        }
        catch (JSException)
        {
        }
    }

    private async Task ToggleThemeAsync()
    {
        var next = _isDarkTheme ? "light" : "dark";
        try
        {
            var applied = await JSRuntime.InvokeAsync<string>("simpleIPaaSTheme.set", next);
            _isDarkTheme = string.Equals(applied, "dark", StringComparison.OrdinalIgnoreCase);
        }
        catch (JSException)
        {
        }
    }

    private async Task LoadSidebarAsync()
    {
        try
        {
            var saved = await JSRuntime.InvokeAsync<string>("simpleIPaaSLayout.getSidebar");
            _sidebarCollapsed = string.Equals(saved, "collapsed", StringComparison.OrdinalIgnoreCase);
            StateHasChanged();
        }
        catch (JSException)
        {
        }
    }

    private async Task ToggleSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        try
        {
            await JSRuntime.InvokeVoidAsync("simpleIPaaSLayout.setSidebar", _sidebarCollapsed ? "collapsed" : "expanded");
        }
        catch (JSException)
        {
        }
    }

    private async Task CheckHealthAsync()
    {
        ApiHealth result;
        try
        {
            using var response = await Http.GetAsync("health");
            var body = (await response.Content.ReadAsStringAsync()).Trim();
            result = response.IsSuccessStatusCode && body.Equals("Healthy", StringComparison.OrdinalIgnoreCase)
                ? ApiHealth.Healthy
                : ApiHealth.Degraded;
        }
        catch (Exception)
        {
            result = ApiHealth.Offline;
        }

        if (result != _health)
        {
            _health = result;
            StateHasChanged();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        InvokeAsync(StateHasChanged);
    }

    private static string HeadingFor(string relativePath)
    {
        var path = relativePath.Split('?')[0].Split('#')[0].Trim('/');
        var segment = path.Split('/')[0].ToLowerInvariant();

        return segment switch
        {
            "" => "Dashboard",
            "connections" => "Connections",
            "connection-wizard" => "Connection Setup",
            "flow" or "flow-designer" => "Flow Designer",
            "activity" or "activity-log" => "Activity Log",
            "transaction-history" => "Transaction History",
            "execution" or "execution-detail" => "Execution Details",
            "deadletters" => "Dead Letters",
            "cross-references" => "Cross-References",
            "logs" => "Debug Logs",
            _ => "SimpleIPaaS"
        };
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _healthTimer?.Dispose();
        _healthTimer = null;
    }
}
