@using SimpleIPaaS.Shared.Models

<div class="card-header node-header node-header-teal">
    <h3 class="card-title">Persisted State</h3>
</div>
<div class="card-body">
    <p class="node-hint">
        Update the flow-level persisted object. Only this card type can save it back to the database.
    </p>
    <div class="node-field">
        <label class="node-label">Node Name</label>
        <input type="text" class="form-control" @bind="Step.NodeName" placeholder="e.g. SaveCursorState" />
    </div>
    <button class="btn btn-block" @onclick="OpenEditor">
        @(string.IsNullOrWhiteSpace(Step.MappingCode) ? "Open Persisted State Script" : "Edit Persisted State Script")
    </button>
    @if (!string.IsNullOrWhiteSpace(Step.MappingCode))
    {
        <div class="node-code-preview">
            @Step.MappingCode.Split('\n').FirstOrDefault(line => !string.IsNullOrWhiteSpace(line) && !line.TrimStart().StartsWith("//"))
        </div>
    }
</div>

@code {
    [Parameter] public IntegrationStepDto Step { get; set; } = default!;
    [CascadingParameter] public SimpleIPaaS.Client.Pages.FlowDesigner Designer { get; set; } = default!;

    private void OpenEditor()
    {
        Designer?.OpenMapperModal(Step, "MappingCode");
    }
}
