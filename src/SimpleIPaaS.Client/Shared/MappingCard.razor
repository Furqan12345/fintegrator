@using SimpleIPaaS.Shared.Models

<div class="card-header node-header node-header-warning">
    <h3 class="card-title">Mapper</h3>
</div>
<div class="card-body">
    <p class="node-hint">
        Write a C# function to map data in FlowState.
    </p>
    <div class="node-field">
        <label class="node-label">Node Name</label>
        <input type="text" class="form-control" @bind="Step.NodeName" placeholder="e.g. MapUser" />
    </div>
    <button class="btn btn-block" @onclick="OpenEditor">
        @(string.IsNullOrWhiteSpace(Step.MappingCode) ? "Open Code Editor" : "Edit Mapping Code")
    </button>
    @if (!string.IsNullOrWhiteSpace(Step.MappingCode))
    {
        <div class="node-code-preview">
            @Step.MappingCode.Split('\n').FirstOrDefault(l => !string.IsNullOrWhiteSpace(l) && !l.TrimStart().StartsWith("//"))
        </div>
    }
</div>

@code {
    [Parameter] public IntegrationStepDto Step { get; set; } = default!;
    [CascadingParameter] public SimpleIPaaS.Client.Pages.FlowDesigner Designer { get; set; } = default!;

    private void OpenEditor()
    {
        Designer?.OpenMapperModal(Step, "MappingCode");
    }
}
