@using SimpleIPaaS.Shared.Models
@using System.Text.Json
@using System.Text.Json.Nodes
@inject HttpClient Http

@if (IsVisible)
{
    <div class="modal-overlay" @onclick="Close" @onwheel:stopPropagation="true" @onmousedown:stopPropagation="true" @onmouseup:stopPropagation="true" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true">
        <div class="modal-container" @onclick:stopPropagation="true" @onwheel:stopPropagation="true" @onmousedown:stopPropagation="true" @onmouseup:stopPropagation="true" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">@ModalTitle</h2>
                <button class="modal-close-btn" @onclick="Close" aria-label="Close">✕</button>
            </div>

            <div class="modal-body">
                <div class="editor-panel">
                    <div class="panel-header">
                        <span class="panel-label">C# Script</span>
                        <span class="panel-hint">@ScriptHint</span>
                    </div>
                    <textarea class="code-textarea" @bind="Code" @bind:event="oninput" spellcheck="false"></textarea>
                </div>

                <div class="io-panels">
                    <div class="editor-panel">
                        <div class="panel-header">
                            <span class="panel-label">@SampleInputLabel</span>
                        </div>
                        <textarea class="code-textarea io-textarea" @bind="SampleInput" @bind:event="oninput" spellcheck="false"></textarea>
                    </div>

                    <div class="editor-panel">
                        <div class="panel-header">
                            <span class="panel-label">Sample Persisted State JSON</span>
                        </div>
                        <textarea class="code-textarea io-textarea" @bind="PersistedStateInput" @bind:event="oninput" spellcheck="false"></textarea>
                    </div>

                    <div class="editor-panel">
                        <div class="panel-header">
                            <span class="panel-label">Output</span>
                            @if (_isRunning)
                            {
                                <span class="panel-hint panel-hint-running">Running...</span>
                            }
                            else if (_hasError)
                            {
                                <span class="panel-hint panel-hint-error">Error</span>
                            }
                            else if (_hasResult)
                            {
                                <span class="panel-hint panel-hint-success">Success</span>
                            }
                        </div>
                        <textarea class="code-textarea io-textarea output-textarea" readonly value="@Output"></textarea>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="ResetToSample">Reset to Sample</button>
                <div class="modal-footer-spacer"></div>
                <button class="btn" @onclick="TestRun" disabled="@_isRunning">
                    @(_isRunning ? "Running..." : "Test Run")
                </button>
                <button class="btn btn-success" @onclick="SaveAndClose">Save and Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public IntegrationStepDto Step { get; set; } = default!;
    [Parameter] public string TargetProperty { get; set; } = "MappingCode";

    private string Code { get; set; } = string.Empty;
    private string SampleInput { get; set; } = string.Empty;
    private string PersistedStateInput { get; set; } = string.Empty;
    private string Output { get; set; } = string.Empty;

    private string ModalTitle => Step?.StepType == "Branch" ? "Branch Condition Script" : TargetProperty switch
    {
        "UrlCode" => "Dynamic URL Script",
        "PreFlightCode" => "Pre-Request Body Script",
        "PostFlightCode" => "Post-Response Script",
        _ when Step?.StepType == "PersistedState" => "Persisted State Script",
        _ => "Mapping Function Editor"
    };

    private string ScriptHint => Step?.StepType == "Branch" ? "Use FlowStateJson and PersistedStateJson. Return a boolean value." : TargetProperty switch
    {
        "UrlCode" => "Use FlowStateJson and PersistedStateJson. Return a string URL or relative path.",
        "PreFlightCode" => "Use FlowStateJson and PersistedStateJson to build a request body. Return a JSON string.",
        "PostFlightCode" => "Use FlowStateJson, PersistedStateJson, and HttpResponseJson. Return a JSON string.",
        _ when Step?.StepType == "PersistedState" => "Return the full updated persisted state JSON object.",
        _ => "Use FlowStateJson and PersistedStateJson. Return a JSON string."
    };

    private string SampleInputLabel => TargetProperty == "PostFlightCode"
        ? "Sample HTTP Response JSON"
        : "Sample Flow State JSON";

    private bool _isRunning;
    private bool _hasError;
    private bool _hasResult;
    private bool _wasVisible;

    private const string DefaultSampleInput = @"{
  ""GetUsers"": {
    ""id"": ""123"",
    ""name"": ""John Doe"",
    ""status"": ""active""
  }
}";

    private const string DefaultPersistedStateInput = @"{
  ""cursor"": ""page-2"",
  ""tenant"": ""northwind"",
  ""isEnabled"": true
}";

    private const string DefaultResponseInput = @"{
  ""data"": [
    { ""id"": ""1"", ""role"": ""admin"" }
  ]
}";

    protected override void OnParametersSet()
    {
        if (IsVisible && !_wasVisible)
        {
            var existingCode = TargetProperty switch
            {
                "UrlCode" => Step.UrlCode,
                "PreFlightCode" => Step.PreFlightCode,
                "PostFlightCode" => Step.PostFlightCode,
                _ => Step.MappingCode
            };

            Code = string.IsNullOrWhiteSpace(existingCode) ? GetDefaultCode() : existingCode;
            LoadSamples();
            Output = string.Empty;
            _hasError = false;
            _hasResult = false;
        }

        _wasVisible = IsVisible;
    }

    private const string SamplesConfigKey = "mapperSamples";

    private static readonly JsonSerializerOptions StepConfigJsonOptions = new() { WriteIndented = false };

    private string DefaultSampleForTarget => TargetProperty == "PostFlightCode" ? DefaultResponseInput : DefaultSampleInput;

    private void LoadSamples()
    {
        SampleInput = DefaultSampleForTarget;
        PersistedStateInput = DefaultPersistedStateInput;

        var root = ParseStepConfig();
        var samples = root[SamplesConfigKey] as JsonObject;
        if (samples == null)
        {
            return;
        }

        var perTarget = samples[TargetProperty] as JsonObject;
        if (perTarget == null)
        {
            return;
        }

        var flowState = perTarget["flowState"]?.GetValue<string>();
        var persistedState = perTarget["persistedState"]?.GetValue<string>();

        if (!string.IsNullOrWhiteSpace(flowState))
        {
            SampleInput = flowState;
        }

        if (!string.IsNullOrWhiteSpace(persistedState))
        {
            PersistedStateInput = persistedState;
        }
    }

    private void SaveSamples()
    {
        var root = ParseStepConfig();
        var samples = root[SamplesConfigKey] as JsonObject ?? new JsonObject();
        var perTarget = samples[TargetProperty] as JsonObject ?? new JsonObject();
        perTarget["flowState"] = SampleInput;
        perTarget["persistedState"] = PersistedStateInput;
        samples[TargetProperty] = perTarget;
        root[SamplesConfigKey] = samples;
        Step.StepConfig = root.ToJsonString(StepConfigJsonOptions);
    }

    private JsonObject ParseStepConfig()
    {
        if (string.IsNullOrWhiteSpace(Step?.StepConfig))
        {
            return new JsonObject();
        }

        try
        {
            return JsonNode.Parse(Step.StepConfig) as JsonObject ?? new JsonObject();
        }
        catch (JsonException)
        {
            return new JsonObject();
        }
    }

    private string GetDefaultCode()
    {
        if (Step?.StepType == "Branch")
        {
            return @"using Newtonsoft.Json.Linq;

var state = JObject.Parse(FlowStateJson);
var persisted = JObject.Parse(PersistedStateJson);
var status = (string)state[""GetUsers""][""status""];

return status == ""active"" && persisted[""isEnabled""]?.Value<bool>() != false;";
        }

        if (Step?.StepType == "PersistedState")
        {
            return @"using Newtonsoft.Json;
using Newtonsoft.Json.Linq;

var state = JObject.Parse(FlowStateJson);
var persisted = JObject.Parse(PersistedStateJson);

persisted[""cursor""] = state[""GetUsers""]?[""id""] ?? persisted[""cursor""];
persisted[""updatedAtUtc""] = DateTime.UtcNow.ToString(""O"");

return JsonConvert.SerializeObject(persisted);";
        }

        return TargetProperty switch
        {
            "UrlCode" => @"using Newtonsoft.Json.Linq;

var state = JObject.Parse(FlowStateJson);
var persisted = JObject.Parse(PersistedStateJson);
var userId = (string)state[""GetUsers""][""id""];
var tenant = (string?)persisted[""tenant""] ?? ""default"";

return $""/tenants/{tenant}/users/{userId}"";",
            "PreFlightCode" => @"using Newtonsoft.Json;
using Newtonsoft.Json.Linq;

var state = JObject.Parse(FlowStateJson);
var persisted = JObject.Parse(PersistedStateJson);

var requestBody = new {
    name = (string)state[""GetUsers""][""name""],
    cursor = (string?)persisted[""cursor""]
};

return JsonConvert.SerializeObject(requestBody);",
            "PostFlightCode" => @"using Newtonsoft.Json;
using Newtonsoft.Json.Linq;

var response = JObject.Parse(HttpResponseJson);
var persisted = JObject.Parse(PersistedStateJson);

var result = new {
    processedData = response[""data""],
    cursor = persisted[""cursor""]
};

return JsonConvert.SerializeObject(result);",
            _ => @"using Newtonsoft.Json;
using Newtonsoft.Json.Linq;

var state = JObject.Parse(FlowStateJson);
var persisted = JObject.Parse(PersistedStateJson);

var result = new {
    mappedValue = (string)state[""GetUsers""][""name""],
    lastCursor = (string?)persisted[""cursor""]
};

return JsonConvert.SerializeObject(result);"
        };
    }

    private async Task TestRun()
    {
        _isRunning = true;
        _hasError = false;
        _hasResult = false;
        Output = string.Empty;

        try
        {
            var request = new TestMappingRequestDto
            {
                MappingCode = Code,
                FlowStateJson = TargetProperty == "PostFlightCode" ? "{}" : SampleInput,
                PersistedStateJson = PersistedStateInput,
                HttpResponseJson = TargetProperty == "PostFlightCode" ? SampleInput : "{}",
                TargetProperty = TargetProperty,
                StepType = Step?.StepType ?? string.Empty
            };

            var response = await Http.PostAsJsonAsync("api/integrationflow/test-mapping", request);
            var result = await response.Content.ReadFromJsonAsync<TestMappingResponseDto>();

            if (result != null && result.Success)
            {
                Output = result.Result;
                _hasResult = true;
            }
            else
            {
                Output = "ERROR: " + (result?.Error ?? "Unknown error");
                _hasError = true;
            }
        }
        catch (Exception ex)
        {
            Output = "REQUEST FAILED: " + ex.Message;
            _hasError = true;
        }
        finally
        {
            _isRunning = false;
        }
    }

    private void ResetToSample()
    {
        Code = GetDefaultCode();
        SampleInput = TargetProperty == "PostFlightCode" ? DefaultResponseInput : DefaultSampleInput;
        PersistedStateInput = DefaultPersistedStateInput;
        Output = string.Empty;
        _hasError = false;
        _hasResult = false;
    }

    private async Task SaveAndClose()
    {
        switch (TargetProperty)
        {
            case "UrlCode":
                Step.UrlCode = Code;
                break;
            case "PreFlightCode":
                Step.PreFlightCode = Code;
                break;
            case "PostFlightCode":
                Step.PostFlightCode = Code;
                break;
            default:
                Step.MappingCode = Code;
                break;
        }

        SaveSamples();
        await Close();
    }

    private async Task Close()
    {
        await IsVisibleChanged.InvokeAsync(false);
    }
}
