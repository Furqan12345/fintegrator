@using System.Text.Json
@using SimpleIPaaS.Shared.Models
@using System.Text.Json
@using System.Text.Json.Nodes

<div class="card-header" style="background: var(--primary);">
    <h3 class="card-title" style="color: white;">HTTP Action</h3>
</div>
<div class="card-body">
    <div class="form-group" style="margin-bottom: 8px;">
        <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Node Name</label>
        <input type="text" class="form-control" @bind="Step.NodeName" placeholder="e.g. FetchUsers" style="width: 100%; padding: 4px 8px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
    </div>

    <div class="form-group" style="margin-bottom: 8px;">
        <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Method</label>
        <select class="form-control" @bind="Step.HttpMethod" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
            <option value="GET">GET</option>
            <option value="POST">POST</option>
            <option value="PUT">PUT</option>
            <option value="PATCH">PATCH</option>
            <option value="DELETE">DELETE</option>
        </select>
    </div>

    <div class="form-group" style="margin-bottom: 8px;">
        <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">URL Source</label>
        <select class="form-control" value="@Step.UrlMode" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" @onchange="OnUrlModeChanged">
            <option value="Manual">Manual Full URL</option>
            <option value="Connection">Predefined Connection</option>
        </select>
    </div>

    @if (Step.UrlMode == "Connection")
    {
        <div class="form-group" style="margin-bottom: 8px;">
            <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Connection</label>
            <select class="form-control" value="@ConnectionValue" @onchange="OnConnectionChanged" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                <option value="">Select connection</option>
                @foreach (var connection in AvailableConnections)
                {
                    <option value="@connection.Id">@connection.Name</option>
                }
            </select>
        </div>
        <div class="form-group" style="margin-bottom: 8px;">
            <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Base URL</label>
            <input type="text" class="form-control" value="@SelectedConnectionBaseUrl" readonly style="width: 100%; padding: 4px 8px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: var(--bg-app);" />
        </div>
        <div class="form-group" style="margin-bottom: 8px;">
            <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Remaining URL / Path</label>
            <input type="text" class="form-control" @bind="Step.EndpointUrl" placeholder="/users/123 or users?status=active" style="width: 100%; padding: 4px 8px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
        </div>
    }
    else
    {
        <div class="form-group" style="margin-bottom: 8px;">
            <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Full URL</label>
            <input type="text" class="form-control" @bind="Step.EndpointUrl" placeholder="https://api.example.com/users" style="width: 100%; padding: 4px 8px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
        </div>

        <div class="form-group" style="margin-bottom: 8px;">
            <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Auth Type</label>
            <select class="form-control" @bind="Step.AuthType" @bind:after="SyncAuthConfig" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                <option value="None">None</option>
                <option value="Basic">Basic Auth</option>
                <option value="Bearer">Bearer Token</option>
                <option value="ApiKey">API Key</option>
                <option value="OAuth2ClientCredentials">OAuth 2.0 Client Credentials</option>
                <option value="OAuth2RefreshToken">OAuth 2.0 Refresh Token</option>
                <option value="OAuth2AuthCode">OAuth 2.0 Authorization Code</option>
                <option value="Custom">Custom Headers</option>
            </select>
        </div>

        @if (Step.AuthType == "Basic")
        {
            <div class="form-group" style="margin-bottom: 8px; display: flex; gap: 4px;">
                <input type="text" class="form-control" @bind="Step.AuthUsername" placeholder="Username" style="width: 50%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
                <input type="password" class="form-control" @bind="Step.AuthPassword" placeholder="Password" style="width: 50%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
        }
        else if (Step.AuthType == "Bearer")
        {
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="password" class="form-control" @bind="Step.AuthToken" placeholder="Bearer token" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
        }
        else if (Step.AuthType == "ApiKey")
        {
            <div class="form-group" style="margin-bottom: 8px;">
                <select class="form-control" @bind="_apiKeyPlacement" @bind:after="SyncAuthConfig" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
                    <option value="header">Header</option>
                    <option value="query">Query Parameter</option>
                </select>
            </div>
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="text" class="form-control" @bind="Step.AuthUsername" @bind:after="SyncAuthConfig" placeholder="@(_apiKeyPlacement == "query" ? "Parameter name (e.g. api_key)" : "Header name (e.g. X-Api-Key)")" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="password" class="form-control" @bind="Step.AuthToken" @bind:after="SyncAuthConfig" placeholder="API key value" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
        }
        else if (Step.AuthType == "OAuth2ClientCredentials")
        {
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="text" class="form-control" @bind="_tokenUrl" @bind:after="SyncAuthConfig" placeholder="Token URL" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="text" class="form-control" @bind="_clientId" @bind:after="SyncAuthConfig" placeholder="Client ID" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="password" class="form-control" @bind="_clientSecret" @bind:after="SyncAuthConfig" placeholder="Client secret" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="text" class="form-control" @bind="_scope" @bind:after="SyncAuthConfig" placeholder="Scope (optional)" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
        }
        else if (Step.AuthType == "OAuth2RefreshToken")
        {
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="text" class="form-control" @bind="Step.AuthUsername" placeholder="Token URL" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="password" class="form-control" @bind="Step.AuthPassword" placeholder="Refresh token" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="password" class="form-control" @bind="Step.AuthToken" placeholder="Access token (optional)" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
        }
        else if (Step.AuthType == "OAuth2AuthCode")
        {
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="text" class="form-control" @bind="_tokenUrl" @bind:after="SyncAuthConfig" placeholder="Token URL" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="text" class="form-control" @bind="_clientId" @bind:after="SyncAuthConfig" placeholder="Client ID" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="password" class="form-control" @bind="_clientSecret" @bind:after="SyncAuthConfig" placeholder="Client secret" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="password" class="form-control" @bind="_accessToken" @bind:after="SyncAuthConfig" placeholder="Access token" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
            <div class="form-group" style="margin-bottom: 8px;">
                <input type="password" class="form-control" @bind="_refreshToken" @bind:after="SyncAuthConfig" placeholder="Refresh token" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
            </div>
        }
        else if (Step.AuthType == "Custom")
        {
            @foreach (var header in _customHeaders)
            {
                <div class="form-group" style="margin-bottom: 8px; display: flex; gap: 4px;">
                    <input type="text" class="form-control" @bind="header.Name" @bind:after="SyncAuthConfig" placeholder="Header name" style="width: 45%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
                    <input type="text" class="form-control" @bind="header.Value" @bind:after="SyncAuthConfig" placeholder="Value" style="width: 45%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
                    <button class="btn btn-outline" style="font-size: 0.75rem; padding: 4px;" @onclick="() => RemoveCustomHeader(header)">x</button>
                </div>
            }
            <div class="form-group" style="margin-bottom: 8px;">
                <button class="btn btn-outline" style="width: 100%; font-size: 0.75rem; padding: 4px;" @onclick="AddCustomHeader">Add Header</button>
            </div>
        }
    }

    <div class="api-packet-section">
        <div class="api-packet-title">API Packet Details</div>

        <div class="form-group" style="margin-bottom: 8px;">
            <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Headers</label>
            <textarea class="form-control api-packet-textarea" @bind="PacketHeadersJson" @bind:event="oninput" placeholder="{ &quot;Accept&quot;: &quot;application/json&quot; }"></textarea>
        </div>

        <div class="form-group" style="margin-bottom: 8px;">
            <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Query Params</label>
            <textarea class="form-control api-packet-textarea" @bind="PacketQueryParamsJson" @bind:event="oninput" placeholder="{ &quot;limit&quot;: &quot;25&quot; }"></textarea>
        </div>

        <div class="form-group" style="margin-bottom: 8px;">
            <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Content-Type</label>
            <input type="text" class="form-control" @bind="PacketContentType" @bind:event="oninput" placeholder="application/json" style="width: 100%; padding: 4px 8px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
        </div>

        <div class="form-group" style="margin-bottom: 8px;">
            <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Body</label>
            <textarea class="form-control api-packet-body" @bind="PacketRequestBody" @bind:event="oninput" placeholder="{ }"></textarea>
        </div>
    </div>

    <div class="script-buttons" style="display: flex; flex-direction: column; gap: 4px; margin-top: 12px;">
        <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 2px;">Scripts (C#)</label>
        <button class="btn btn-outline" style="width: 100%; font-size: 0.75rem; padding: 4px;" @onclick='() => OpenEditor("UrlCode")'>
            @(string.IsNullOrWhiteSpace(Step.UrlCode) ? "Dynamic URL Script" : "Edit Dynamic URL Script")
        </button>
        <button class="btn btn-outline" style="width: 100%; font-size: 0.75rem; padding: 4px;" @onclick='() => OpenEditor("PreFlightCode")'>
            @(string.IsNullOrWhiteSpace(Step.PreFlightCode) ? "Pre-Request Body Script" : "Edit Pre-Request Body Script")
        </button>
        <button class="btn btn-outline" style="width: 100%; font-size: 0.75rem; padding: 4px;" @onclick='() => OpenEditor("PostFlightCode")'>
            @(string.IsNullOrWhiteSpace(Step.PostFlightCode) ? "Post-Response Script" : "Edit Post-Response Script")
        </button>
    </div>
</div>

@code {
    [Parameter] public IntegrationStepDto Step { get; set; } = default!;
    [CascadingParameter] public SimpleIPaaS.Client.Pages.FlowDesigner Designer { get; set; } = default!;

    private IEnumerable<ConnectionDto> AvailableConnections => Designer?.AvailableConnections ?? Enumerable.Empty<ConnectionDto>();
    private string SelectedConnectionBaseUrl => AvailableConnections.FirstOrDefault(connection => connection.Id == Step.ConnectionId)?.BaseUrl ?? string.Empty;
    private string ConnectionValue => Step.ConnectionId?.ToString() ?? string.Empty;
    private static readonly JsonSerializerOptions StepConfigJsonOptions = new() { WriteIndented = false };

    private string PacketHeadersJson
    {
        get => GetPacketValue("headersJson", "{}");
        set => SetPacketValue("headersJson", value);
    }

    private string PacketQueryParamsJson
    {
        get => GetPacketValue("queryParamsJson", "{}");
        set => SetPacketValue("queryParamsJson", value);
    }

    private string PacketContentType
    {
        get => GetPacketValue("contentType", "application/json");
        set => SetPacketValue("contentType", value);
    }

    private string PacketRequestBody
    {
        get => GetPacketValue("requestBody", string.Empty);
        set => SetPacketValue("requestBody", value);
    }

    private string _apiKeyPlacement = "header";
    private string _tokenUrl = string.Empty;
    private string _clientId = string.Empty;
    private string _clientSecret = string.Empty;
    private string _scope = string.Empty;
    private string _accessToken = string.Empty;
    private string _refreshToken = string.Empty;
    private List<CustomHeaderEntry> _customHeaders = new() { new CustomHeaderEntry() };
    private Guid _hydratedStepId;

    private class CustomHeaderEntry
    {
        public string Name { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    protected override void OnParametersSet()
    {
        Step.UrlMode = string.IsNullOrWhiteSpace(Step.UrlMode)
            ? (Step.ConnectionId.HasValue ? "Connection" : "Manual")
            : Step.UrlMode;

        if (Step.Id != _hydratedStepId)
        {
            _hydratedStepId = Step.Id;
            HydrateAuthConfig();
        }
    }

    private void HydrateAuthConfig()
    {
        _apiKeyPlacement = "header";
        _tokenUrl = string.Empty;
        _clientId = string.Empty;
        _clientSecret = string.Empty;
        _scope = string.Empty;
        _accessToken = string.Empty;
        _refreshToken = string.Empty;
        _customHeaders = new List<CustomHeaderEntry> { new CustomHeaderEntry() };

        if (string.IsNullOrWhiteSpace(Step.AuthConfigJson))
        {
            return;
        }

        try
        {
            using var document = JsonDocument.Parse(Step.AuthConfigJson);
            var root = document.RootElement;
            _apiKeyPlacement = root.TryGetProperty("placement", out var placement) ? placement.GetString() ?? "header" : "header";
            _tokenUrl = root.TryGetProperty("tokenUrl", out var tokenUrl) ? tokenUrl.GetString() ?? string.Empty : string.Empty;
            _clientId = root.TryGetProperty("clientId", out var clientId) ? clientId.GetString() ?? string.Empty : string.Empty;
            _clientSecret = root.TryGetProperty("clientSecret", out var clientSecret) ? clientSecret.GetString() ?? string.Empty : string.Empty;
            _scope = root.TryGetProperty("scope", out var scope) ? scope.GetString() ?? string.Empty : string.Empty;
            _accessToken = root.TryGetProperty("accessToken", out var accessToken) ? accessToken.GetString() ?? string.Empty : string.Empty;
            _refreshToken = root.TryGetProperty("refreshToken", out var refreshToken) ? refreshToken.GetString() ?? string.Empty : string.Empty;

            if (root.TryGetProperty("headers", out var headers) && headers.ValueKind == JsonValueKind.Array)
            {
                _customHeaders = headers.EnumerateArray()
                    .Select(header => new CustomHeaderEntry
                    {
                        Name = header.TryGetProperty("name", out var name) ? name.GetString() ?? string.Empty : string.Empty,
                        Value = header.TryGetProperty("value", out var value) ? value.GetString() ?? string.Empty : string.Empty
                    })
                    .ToList();

                if (_customHeaders.Count == 0)
                {
                    _customHeaders.Add(new CustomHeaderEntry());
                }
            }
        }
        catch (JsonException)
        {
        }
    }

    private void SyncAuthConfig()
    {
        object? payload = Step.AuthType switch
        {
            "ApiKey" => new { headerName = Step.AuthUsername, apiKey = Step.AuthToken, placement = _apiKeyPlacement },
            "OAuth2ClientCredentials" => new { tokenUrl = _tokenUrl, clientId = _clientId, clientSecret = _clientSecret, scope = _scope },
            "OAuth2AuthCode" => new { tokenUrl = _tokenUrl, clientId = _clientId, clientSecret = _clientSecret, accessToken = _accessToken, refreshToken = _refreshToken },
            "Custom" => new { headers = _customHeaders.Where(header => !string.IsNullOrWhiteSpace(header.Name)).Select(header => new { name = header.Name, value = header.Value }).ToList() },
            _ => null
        };

        Step.AuthConfigJson = payload == null ? string.Empty : JsonSerializer.Serialize(payload);
    }

    private void AddCustomHeader()
    {
        _customHeaders.Add(new CustomHeaderEntry());
        SyncAuthConfig();
    }

    private void RemoveCustomHeader(CustomHeaderEntry header)
    {
        _customHeaders.Remove(header);
        SyncAuthConfig();
    }

    private void OpenEditor(string target)
    {
        Designer?.OpenMapperModal(Step, target);
    }

    private void OnUrlModeChanged(ChangeEventArgs _)
    {
        Step.UrlMode = _.Value?.ToString() ?? "Manual";
        if (Step.UrlMode == "Manual")
        {
            Step.ConnectionId = null;
        }
    }

    private void OnConnectionChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var connectionId))
        {
            Step.ConnectionId = connectionId;
        }
        else
        {
            Step.ConnectionId = null;
        }
    }

    private string GetPacketValue(string key, string fallback)
    {
        var packet = GetPacketObject();
        return packet[key]?.GetValue<string>() ?? fallback;
    }

    private void SetPacketValue(string key, string value)
    {
        var root = ParseStepConfig();
        var packet = root["apiPacket"] as JsonObject ?? new JsonObject();
        packet[key] = value ?? string.Empty;
        root["apiPacket"] = packet;
        Step.StepConfig = root.ToJsonString(StepConfigJsonOptions);
    }

    private JsonObject GetPacketObject()
    {
        return ParseStepConfig()["apiPacket"] as JsonObject ?? new JsonObject();
    }

    private JsonObject ParseStepConfig()
    {
        if (string.IsNullOrWhiteSpace(Step.StepConfig))
        {
            return new JsonObject();
        }

        try
        {
            return JsonNode.Parse(Step.StepConfig) as JsonObject ?? new JsonObject();
        }
        catch (JsonException)
        {
            return new JsonObject();
        }
    }
}
