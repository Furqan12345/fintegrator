<svg class="@Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "brand":
            <path d="M13 2 4.5 13.5H11l-.5 8.5L19.5 10H13z" fill="currentColor" stroke="none" />
            break;
        case "integrations":
            <circle cx="6" cy="12" r="2.6" />
            <circle cx="18" cy="6" r="2.6" />
            <circle cx="18" cy="18" r="2.6" />
            <path d="M8.4 10.8 15.6 7.2M8.4 13.2l7.2 3.6" />
            break;
        case "connections":
            <path d="M9 2v6M15 2v6M6 8h12v3a6 6 0 0 1-12 0zM12 17v5" />
            break;
        case "activity":
            <path d="M3 12h4l3-8 4 16 3-8h4" />
            break;
        case "transactions":
            <path d="M17 2l4 4-4 4M21 6H7M7 22l-4-4 4-4M3 18h14" />
            break;
        case "deadletters":
            <path d="M22 12h-6l-2 3h-4l-2-3H2" />
            <path d="M5.5 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.7 1.1z" />
            break;
        case "crossreferences":
            <ellipse cx="12" cy="5.5" rx="8" ry="3" />
            <path d="M20 12c0 1.66-3.58 3-8 3s-8-1.34-8-3" />
            <path d="M4 5.5v13c0 1.66 3.58 3 8 3s8-1.34 8-3v-13" />
            break;
        case "logs":
            <path d="M4 4.5h16M4 9.5h16M4 14.5h10M4 19.5h7" />
            <circle cx="18" cy="17.5" r="3.2" />
            <path d="m20.4 19.9 1.6 1.6" />
            break;
        case "dashboard":
            <rect x="3" y="3" width="7.5" height="8.5" rx="1.6" />
            <rect x="13.5" y="3" width="7.5" height="5.5" rx="1.6" />
            <rect x="3" y="14.5" width="7.5" height="6.5" rx="1.6" />
            <rect x="13.5" y="11.5" width="7.5" height="9.5" rx="1.6" />
            break;
        case "flows":
            <rect x="2.5" y="3.5" width="7" height="5" rx="1.6" />
            <rect x="14.5" y="3.5" width="7" height="5" rx="1.6" />
            <rect x="8.5" y="15.5" width="7" height="5" rx="1.6" />
            <path d="M6 8.5v3.5a1.5 1.5 0 0 0 1.5 1.5h9A1.5 1.5 0 0 0 18 12V8.5M12 13.5v2" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "refresh":
            <path d="M20.5 12a8.5 8.5 0 1 1-2.6-6.1" />
            <polyline points="20.5 4 20.5 9.2 15.3 9.2" />
            break;
        case "play":
            <path d="M7 4.8 19 12 7 19.2z" fill="currentColor" stroke="none" />
            break;
        case "alert":
            <path d="M10.3 3.6 1.9 18a2 2 0 0 0 1.7 3h16.8a2 2 0 0 0 1.7-3l-8.4-14.4a2 2 0 0 0-3.4 0z" />
            <path d="M12 9.5v4M12 17.4h.01" />
            break;
        case "check-circle":
            <circle cx="12" cy="12" r="9" />
            <polyline points="8.2 12.2 10.9 14.9 15.9 9.4" />
            break;
        case "x-circle":
            <circle cx="12" cy="12" r="9" />
            <path d="m9.2 9.2 5.6 5.6M14.8 9.2l-5.6 5.6" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <polyline points="12 6.8 12 12.3 15.8 14.4" />
            break;
        case "trend":
            <polyline points="3 16.5 9 10.5 13 14.5 21 6.5" />
            <polyline points="15.5 6.5 21 6.5 21 12" />
            break;
        case "arrow-right":
            <path d="M4 12h15" />
            <polyline points="13.5 6.5 19.5 12 13.5 17.5" />
            break;
        case "external":
            <path d="M13.5 3.5H20.5V10.5" />
            <path d="m11.5 12.5 9-9" />
            <path d="M19 14.5v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-12a2 2 0 0 1 2-2h5" />
            break;
        case "trash":
            <path d="M3.5 6.5h17M9 6.5V4.8a1.3 1.3 0 0 1 1.3-1.3h3.4A1.3 1.3 0 0 1 15 4.8v1.7" />
            <path d="M5.8 6.5 6.7 19a2 2 0 0 0 2 1.9h6.6a2 2 0 0 0 2-1.9l.9-12.5" />
            <path d="M10.4 10.5v6M13.6 10.5v6" />
            break;
        case "filter":
            <path d="M3.5 5.5h17l-6.6 7.6v5.6l-3.8 2v-7.6z" />
            break;
        case "sparkline":
            <path d="M3 17.5 7.5 11l3.5 3.5L15 7.5l2.4 4.2L21 8" />
            break;
        case "settings":
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1v.2a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-2.8-1.1l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.6 1.6 0 0 0 3.5 15a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.1-2.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 2.7-1.1V4a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 2.7 1.1l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0 1.1 2.7h.2a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1z" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.6-3.6" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 7.75h.01" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M2 12h2M20 12h2M4.9 19.1l1.5-1.5M17.6 6.4l1.5-1.5" />
            break;
        case "moon":
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            break;
        case "menu":
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
            break;
        case "chevron-left":
            <polyline points="15.5 18 9.5 12 15.5 6" />
            break;
        case "chevron-right":
            <polyline points="8.5 6 14.5 12 8.5 18" />
            break;
        case "chevron-up":
            <polyline points="18 15 12 9 6 15" />
            break;
        case "chevron-down":
            <polyline points="6 9 12 15 18 9" />
            break;
        case "maximize":
            <polyline points="15 3 21 3 21 9" />
            <polyline points="9 21 3 21 3 15" />
            <polyline points="3 9 3 3 9 3" />
            <polyline points="21 15 21 21 15 21" />
            break;
        case "minimize":
            <rect x="5" y="5" width="14" height="14" rx="1.5" />
            <rect x="8" y="8" width="8" height="8" rx="1.5" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Class { get; set; } = "icon";
}
