@if (IsVisible)
{
    <div class="modal-overlay" @onclick="Close" @onwheel:stopPropagation="true" @onmousedown:stopPropagation="true" @onmouseup:stopPropagation="true" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true">
        <div class="modal-container debug-json-modal" @onclick:stopPropagation="true" @onwheel:stopPropagation="true" @onmousedown:stopPropagation="true" @onmouseup:stopPropagation="true" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">JSON Viewer</h2>
                <button class="modal-close-btn" @onclick="Close">✕</button>
            </div>

            <div class="debug-json-modal-body" @onwheel:stopPropagation="true">
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="debug-json-error">@ErrorMessage</div>
                }
                else if (!string.IsNullOrWhiteSpace(JsonContent))
                {
                    <pre class="debug-json-viewer" @onwheel:stopPropagation="true"><code>@JsonContent</code></pre>
                }
                else
                {
                    <div class="debug-json-empty">Run the flow before viewing state.</div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public string JsonContent { get; set; } = string.Empty;
    [Parameter] public string ErrorMessage { get; set; } = string.Empty;

    private async Task Close()
    {
        await IsVisibleChanged.InvokeAsync(false);
    }
}
