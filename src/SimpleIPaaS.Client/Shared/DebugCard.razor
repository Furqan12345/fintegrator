@using SimpleIPaaS.Shared.Models

<div class="card-header" style="background: var(--info);">
    <h3 class="card-title" style="color: white;">🔍 Debug Output</h3>
</div>
<div class="card-body">
    <div class="form-group" style="margin-bottom: 8px;">
        <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Node Name</label>
        <input type="text" class="form-control" @bind="Step.NodeName" placeholder="e.g. DebugResponse" style="width: 100%; padding: 4px 8px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);" />
    </div>

    <div class="form-group" style="margin-bottom: 8px;">
        <label style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">Source Node</label>
        <select class="form-control" @bind="Step.EndpointUrl" style="width: 100%; padding: 4px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
            <option value="">-- Select previous node --</option>
            <option value="*">All Previous Nodes</option>
        </select>
    </div>

    <div style="font-size: 0.7rem; color: var(--text-secondary); margin-top: 8px; padding: 8px; background: var(--bg-secondary); border-radius: var(--radius-sm);">
        ℹ️ This node displays the output from the previous node in the flow. Useful for debugging and inspecting data transformations.
    </div>
</div>

@code {
    [Parameter] public IntegrationStepDto Step { get; set; } = default!;
    [CascadingParameter] public SimpleIPaaS.Client.Pages.FlowDesigner Designer { get; set; } = default!;
}
