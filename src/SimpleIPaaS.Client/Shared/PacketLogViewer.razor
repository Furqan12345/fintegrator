@inject HttpClient Http
@inject IDispatcher Dispatcher
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="packet-log-viewer">
    @if (Step.ReceivedInputSize > 0)
    {
        <details class="packet-section" @ontoggle="LoadPayloadAsync">
            <summary>
                <span class="packet-summary-text">Received input (@FormatSize(Step.ReceivedInputSize))</span>
                <button type="button" class="btn btn-sm btn-outline packet-copy-btn"
                        title="Copy JSON to clipboard"
                        aria-label="Copy received input to clipboard"
                        @onclick:stopPropagation="true"
                        @onclick:preventDefault="true"
                        disabled="@(string.IsNullOrEmpty(_payload?.ReceivedInput))"
                        @onclick="() => CopyAsync(nameof(ReceivedInputKey), _payload?.ReceivedInput ?? string.Empty)">
                    @(IsCopied(nameof(ReceivedInputKey)) ? "Copied!" : "Copy")
                </button>
            </summary>
            @if (_payloadLoading)
            {
                <div class="text-muted">Loading…</div>
            }
            else
            {
                <pre class="packet-json-viewer"><code>@FormatJson(_payload?.ReceivedInput)</code></pre>
            }
        </details>
    }

    @if (Step.ResponsePayloadSize > 0)
    {
        <details class="packet-section" @ontoggle="LoadPayloadAsync">
            <summary>
                <span class="packet-summary-text">Returned data (@FormatSize(Step.ResponsePayloadSize))</span>
                <button type="button" class="btn btn-sm btn-outline packet-copy-btn"
                        title="Copy JSON to clipboard"
                        aria-label="Copy returned data to clipboard"
                        @onclick:stopPropagation="true"
                        @onclick:preventDefault="true"
                        disabled="@(string.IsNullOrEmpty(_payload?.ResponsePayload))"
                        @onclick="() => CopyAsync(nameof(ResponsePayloadKey), _payload?.ResponsePayload ?? string.Empty)">
                    @(IsCopied(nameof(ResponsePayloadKey)) ? "Copied!" : "Copy")
                </button>
            </summary>
            @if (_payloadLoading)
            {
                <div class="text-muted">Loading…</div>
            }
            else
            {
                <pre class="packet-json-viewer"><code>@FormatJson(_payload?.ResponsePayload)</code></pre>
            }
        </details>
    }

    @if (Step.Packets.Count > 0)
    {
        <details class="packet-section">
            <summary>Packet log (@Step.Packets.Count)</summary>
            @foreach (var packet in Step.Packets.OrderBy(packet => packet.Sequence))
            {
                <div class="packet-entry">
                    <div class="packet-entry-header">
                        <strong>@packet.Kind @(packet.PageNumber.HasValue ? $"Page {packet.PageNumber}" : string.Empty)</strong>
                        <span class="status-badge @StatusClass(packet.StatusCode)">@(packet.StatusCode?.ToString() ?? "No response")</span>
                        @if (packet.Attempt.HasValue)
                        {
                            <span class="packet-entry-meta">Attempt @packet.Attempt</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(packet.HttpMethod) || !string.IsNullOrWhiteSpace(packet.RequestUrl))
                    {
                        <div class="packet-entry-meta">@packet.HttpMethod @packet.RequestUrl</div>
                    }
                    <div class="packet-entry-meta">
                        @packet.StartedAt.ToLocalTime().ToString("MMM d, h:mm:ss.fff tt")
                        @(packet.DurationMs.HasValue ? $" · {packet.DurationMs} ms" : string.Empty)
                    </div>
                    @if (HasPacketBody(packet))
                    {
                        <details class="packet-section" @ontoggle="@(() => LoadPacketAsync(packet.Id))">
                            <summary>Headers and bodies (@FormatSize(PacketTotalSize(packet)))</summary>
                            @if (_loadingPackets.Contains(packet.Id))
                            {
                                <div class="text-muted">Loading…</div>
                            }
                            else
                            {
                                var body = PacketBody(packet.Id);
                                <div class="packet-io-grid">
                                    @if (packet.RequestHeadersSize > 0)
                                    {
                                        <div>
                                            <div class="packet-section-title">
                                                <span>Request headers (@FormatSize(packet.RequestHeadersSize))</span>
                                                <button type="button" class="btn btn-sm btn-outline packet-copy-btn"
                                                        title="Copy JSON to clipboard"
                                                        aria-label="Copy request headers to clipboard"
                                                        disabled="@(string.IsNullOrEmpty(body?.RequestHeadersJson))"
                                                        @onclick="() => CopyAsync(PacketKey(packet.Id, nameof(StepPacketBodyDto.RequestHeadersJson)), body?.RequestHeadersJson ?? string.Empty)">
                                                    @(IsCopied(PacketKey(packet.Id, nameof(StepPacketBodyDto.RequestHeadersJson))) ? "Copied!" : "Copy")
                                                </button>
                                            </div>
                                            <pre class="packet-json-viewer"><code>@FormatJson(body?.RequestHeadersJson)</code></pre>
                                        </div>
                                    }
                                    @if (packet.RequestBodySize > 0)
                                    {
                                        <div>
                                            <div class="packet-section-title">
                                                <span>Request body (@FormatSize(packet.RequestBodySize))</span>
                                                <button type="button" class="btn btn-sm btn-outline packet-copy-btn"
                                                        title="Copy JSON to clipboard"
                                                        aria-label="Copy request body to clipboard"
                                                        disabled="@(string.IsNullOrEmpty(body?.RequestBody))"
                                                        @onclick="() => CopyAsync(PacketKey(packet.Id, nameof(StepPacketBodyDto.RequestBody)), body?.RequestBody ?? string.Empty)">
                                                    @(IsCopied(PacketKey(packet.Id, nameof(StepPacketBodyDto.RequestBody))) ? "Copied!" : "Copy")
                                                </button>
                                            </div>
                                            <pre class="packet-json-viewer"><code>@FormatJson(body?.RequestBody)</code></pre>
                                        </div>
                                    }
                                    @if (packet.ResponseHeadersSize > 0)
                                    {
                                        <div>
                                            <div class="packet-section-title">
                                                <span>Response headers (@FormatSize(packet.ResponseHeadersSize))</span>
                                                <button type="button" class="btn btn-sm btn-outline packet-copy-btn"
                                                        title="Copy JSON to clipboard"
                                                        aria-label="Copy response headers to clipboard"
                                                        disabled="@(string.IsNullOrEmpty(body?.ResponseHeadersJson))"
                                                        @onclick="() => CopyAsync(PacketKey(packet.Id, nameof(StepPacketBodyDto.ResponseHeadersJson)), body?.ResponseHeadersJson ?? string.Empty)">
                                                    @(IsCopied(PacketKey(packet.Id, nameof(StepPacketBodyDto.ResponseHeadersJson))) ? "Copied!" : "Copy")
                                                </button>
                                            </div>
                                            <pre class="packet-json-viewer"><code>@FormatJson(body?.ResponseHeadersJson)</code></pre>
                                        </div>
                                    }
                                    @if (packet.ResponseBodySize > 0)
                                    {
                                        <div>
                                            <div class="packet-section-title">
                                                <span>Response body (@FormatSize(packet.ResponseBodySize))</span>
                                                <button type="button" class="btn btn-sm btn-outline packet-copy-btn"
                                                        title="Copy JSON to clipboard"
                                                        aria-label="Copy response body to clipboard"
                                                        disabled="@(string.IsNullOrEmpty(body?.ResponseBody))"
                                                        @onclick="() => CopyAsync(PacketKey(packet.Id, nameof(StepPacketBodyDto.ResponseBody)), body?.ResponseBody ?? string.Empty)">
                                                    @(IsCopied(PacketKey(packet.Id, nameof(StepPacketBodyDto.ResponseBody))) ? "Copied!" : "Copy")
                                                </button>
                                            </div>
                                            <pre class="packet-json-viewer"><code>@FormatJson(body?.ResponseBody)</code></pre>
                                        </div>
                                    }
                                </div>
                            }
                        </details>
                    }
                    @if (!string.IsNullOrWhiteSpace(packet.Error))
                    {
                        <div class="step-error">@packet.Error</div>
                    }
                </div>
            }
        </details>
    }
</div>

@code {
    [Parameter] public StepExecutionDto Step { get; set; } = default!;

    private StepPayloadDto? _payload;
    private bool _payloadLoading;
    private Guid _loadedPayloadStepId;
    private readonly Dictionary<Guid, StepPacketBodyDto> _packetBodies = new();
    private readonly HashSet<Guid> _loadingPackets = new();

    protected override void OnParametersSet()
    {
        if (_loadedPayloadStepId != Step.Id)
        {
            _payload = null;
            _payloadLoading = false;
            _loadedPayloadStepId = Guid.Empty;
            _packetBodies.Clear();
            _loadingPackets.Clear();
        }
    }

    private async Task LoadPayloadAsync()
    {
        if (_payload != null || _payloadLoading) return;

        _payloadLoading = true;
        var payload = await SafeFetch.GetAsync<StepPayloadDto>(
            Http,
            $"api/executions/{Step.FlowExecutionId}/steps/{Step.Id}/payload",
            Dispatcher,
            "step payload");
        _payloadLoading = false;

        if (payload == null) return;

        _payload = payload;
        _loadedPayloadStepId = Step.Id;
    }

    private async Task LoadPacketAsync(Guid packetId)
    {
        if (_packetBodies.ContainsKey(packetId) || !_loadingPackets.Add(packetId)) return;

        var body = await SafeFetch.GetAsync<StepPacketBodyDto>(
            Http,
            $"api/executions/{Step.FlowExecutionId}/packets/{packetId}",
            Dispatcher,
            "packet body");
        _loadingPackets.Remove(packetId);

        if (body == null) return;

        _packetBodies[packetId] = body;
    }

    private StepPacketBodyDto? PacketBody(Guid packetId) =>
        _packetBodies.TryGetValue(packetId, out var body) ? body : null;

    private static bool HasPacketBody(StepPacketLogDto packet) =>
        packet.RequestHeadersSize > 0 || packet.RequestBodySize > 0 ||
        packet.ResponseHeadersSize > 0 || packet.ResponseBodySize > 0;

    private static int PacketTotalSize(StepPacketLogDto packet) =>
        packet.RequestHeadersSize + packet.RequestBodySize + packet.ResponseHeadersSize + packet.ResponseBodySize;

    private static string FormatSize(int bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }

    private static string StatusClass(int? statusCode) => statusCode switch
    {
        >= 200 and < 300 => "success",
        >= 400 => "failed",
        _ => "pending"
    };

    private static string FormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "No data captured.";
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(document.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }

    // Stable keys for the per-step payload sections (Received input / Returned data)
    private const string ReceivedInputKey = "received-input";
    private const string ResponsePayloadKey = "response-payload";

    private readonly HashSet<string> _copiedKeys = new(StringComparer.Ordinal);
    private CancellationTokenSource? _copyResetCts;

    private bool IsCopied(string key) => _copiedKeys.Contains(key);

    private static string PacketKey(Guid packetId, string field) => $"packet:{packetId:N}:{field}";

    private async Task CopyAsync(string key, string text)
    {
        if (string.IsNullOrEmpty(text)) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copiedKeys.Add(key);
            _copyResetCts?.Cancel();
            _copyResetCts = new CancellationTokenSource();
            var token = _copyResetCts.Token;
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(TimeSpan.FromMilliseconds(1500), token);
                    if (!token.IsCancellationRequested)
                    {
                        _copiedKeys.Remove(key);
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (TaskCanceledException) { }
            });
            StateHasChanged();
        }
        catch (JSException)
        {
            // Clipboard API unavailable (e.g. insecure context). Silent no-op;
            // user can still select-and-copy the text in the pre block.
        }
    }

    public void Dispose()
    {
        _copyResetCts?.Cancel();
        _copyResetCts?.Dispose();
    }
}
